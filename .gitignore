## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# IDE state directories
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ReSharper
_ReSharper.*/
*.rproj/

# NuGet Packages
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# Visual Studio to auto-update the schema of a JSON settings file
*.vs-settings.json

# RIA/Silverlight tools
Generated_Code/

# Backup & report files
_UpgradeReport_Files/
Backup*/
ErrorReports/

# Files that have been excluded on a global level should not be mistaken for project-level excludes
!*.gitignore

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# Node.js (if used)
node_modules/

# Python (if used)
__pycache__/
*.pyc
.venv/

# OS files
.DS_Store
Thumbs.db

# Prompt and local config
prompt.md
run.bat
*appsettings.Development.json

