<!DOCTYPE html>
<html lang="en" class="dark" data-theme="sockless">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Sockless LLM Router</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />

    <!-- Applied before first paint so a saved theme/light-mode preference doesn't flash the default first -->
    <script>
        (function () {
            var html = document.documentElement;
            var savedTheme = localStorage.getItem('themeName');
            if (savedTheme === 'neon' || savedTheme === 'sockless') {
                html.setAttribute('data-theme', savedTheme);
            }
            if (html.getAttribute('data-theme') === 'sockless') {
                // Sockless is dark-only, like the site it's modeled on.
                html.classList.add('dark');
            } else if (localStorage.getItem('theme') === 'light') {
                html.classList.remove('dark');
            }
        })();
    </script>

    <!-- Self-hosted Tailwind build + theme (see Styles/site.css, built via `npm run build:css`) -->
    <link rel="stylesheet" href="~/css/site.css" />

    <!-- Self-hosted htmx — boosts same-page <a>/<form> navigation into AJAX swaps of <body>,
         so switching pages no longer does a full browser reload (see hx-boost below). -->
    <script src="~/lib/htmx/htmx.min.js"></script>

    <!-- Chart.js and SignalR live here rather than in the individual pages that use them:
         under hx-boost, a page's own <script src> tags get re-inserted (and re-fetched)
         on every boosted navigation to it, and browsers load dynamically-inserted <script
         src> tags asynchronously — so a page's inline script can start running, and hit
         "Chart/signalR is not defined", before its own library tag finishes loading. Both
         are tiny enough to load once up front. -->
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
</head>
<body hx-boost="true" style="background-color: var(--bg-main); color: var(--text-primary)" class="h-screen overflow-hidden transition-colors duration-300">

    <a href="#main-content" class="skip-link">Skip to main content</a>

    <div class="flex h-screen overflow-hidden">
        <!-- Sidebar (fixed to viewport height — scrolls internally if the nav ever overflows, but never scrolls with page content) -->
        <aside style="background-color: var(--bg-surface); border-right: 1px solid color-mix(in srgb, var(--neon-cyan) 10%, transparent)" class="w-64 flex flex-col h-full shrink-0">
            <!-- Logo (h-16 matches the header's height below so the dividers line up across the page) -->
            <div class="h-16 px-5 flex items-center gap-3 shrink-0" style="border-bottom: 1px solid color-mix(in srgb, var(--neon-cyan) 10%, transparent)">
                <div class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0 border shadow-neon-cyan" style="background-color: var(--bg-card); border-color: color-mix(in srgb, var(--neon-cyan) 30%, transparent)">
                    <span aria-hidden="true" class="text-neon-cyan text-base">⚡</span>
                </div>
                <div class="leading-tight">
                    <h1 class="text-base font-bold text-neon-cyan tracking-wide">Sockless</h1>
                    <p class="text-[11px] uppercase tracking-wider" style="color: var(--text-secondary)">LLM Router</p>
                </div>
            </div>

@{
    var path = Context.Request.Path.ToString();
    bool isDashboard = path == "/" || path == "";
    bool isServers = path.StartsWith("/Features/Servers");
    bool isModels = path.StartsWith("/Features/Models");
    bool isPresets = path.StartsWith("/Features/Presets");
    bool isDevices = path.StartsWith("/Features/Devices");
    bool isRequestLog = path.StartsWith("/Features/RequestLog");
    bool isStats = path.StartsWith("/Features/Stats");
    bool isApiKeys = path.StartsWith("/Features/ApiKeys");
    bool isSettings = path.StartsWith("/Features/Settings");
    string activeStyle = @"color: var(--neon-cyan); background-color: color-mix(in srgb, var(--neon-cyan) 10%, transparent); border-left-color: var(--neon-cyan)";
    string inactiveStyle = @"color: var(--text-secondary)";
    string activeClasses = "border-l-2 font-semibold ";
    string inactiveClasses = "hover:text-neon-cyan ";
}
            <!-- Navigation -->
            <nav class="flex-1 overflow-y-auto p-3 space-y-1" aria-label="Main navigation">
                <a href="/" aria-current="@(isDashboard ? "page" : null)" class="@(isDashboard ? activeClasses : inactiveClasses) flex items-center gap-3 px-3 py-2 rounded-lg transition-all" style="@(isDashboard ? activeStyle : inactiveStyle)">
                    <svg class="w-5 h-5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1" /></svg>
                    <span class="text-sm font-medium">Dashboard</span>
                </a>

                <a href="/Features/Servers/Index" aria-current="@(isServers ? "page" : null)" class="@(isServers ? activeClasses : inactiveClasses) flex items-center gap-3 px-3 py-2 rounded-lg transition-all" style="@(isServers ? activeStyle : inactiveStyle)">
                    <svg class="w-5 h-5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2" /></svg>
                    <span class="text-sm font-medium">Servers</span>
                </a>

                <a href="/Features/Models/Index" aria-current="@(isModels ? "page" : null)" class="@(isModels ? activeClasses : inactiveClasses) flex items-center gap-3 px-3 py-2 rounded-lg transition-all" style="@(isModels ? activeStyle : inactiveStyle)">
                    <svg class="w-5 h-5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 3.75c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" /></svg>
                    <span class="text-sm font-medium">Models</span>
                </a>

                <a href="/Features/Presets/Index" aria-current="@(isPresets ? "page" : null)" class="@(isPresets ? activeClasses : inactiveClasses) flex items-center gap-3 px-3 py-2 rounded-lg transition-all" style="@(isPresets ? activeStyle : inactiveStyle)">
                    <svg class="w-5 h-5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
                    <span class="text-sm font-medium">Presets</span>
                </a>

                <a href="/Features/Devices/Index" aria-current="@(isDevices ? "page" : null)" class="@(isDevices ? activeClasses : inactiveClasses) flex items-center gap-3 px-3 py-2 rounded-lg transition-all" style="@(isDevices ? activeStyle : inactiveStyle)">
                    <svg class="w-5 h-5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3.75H6.912a2.25 2.25 0 00-2.15 1.588L2.35 13.177a2.25 2.25 0 00-.1.661V18a2.25 2.25 0 002.25 2.25h15a2.25 2.25 0 002.25-2.25v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 00-2.15-1.588H15M2.25 13.5h3.86a2.25 2.25 0 012.012 1.244l.256.512a2.25 2.25 0 002.013 1.244h3.218a2.25 2.25 0 002.013-1.244l.256-.512a2.25 2.25 0 012.013-1.244h3.859M12 3v8.25m0 0l-3-3m3 3l3-3" /></svg>
                    <span class="text-sm font-medium">Devices</span>
                </a>

                <a href="/Features/RequestLog/Index" aria-current="@(isRequestLog ? "page" : null)" class="@(isRequestLog ? activeClasses : inactiveClasses) flex items-center gap-3 px-3 py-2 rounded-lg transition-all" style="@(isRequestLog ? activeStyle : inactiveStyle)">
                    <svg class="w-5 h-5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" /></svg>
                    <span class="text-sm font-medium">Request Log</span>
                </a>

                <a href="/Features/Stats/Dashboard" aria-current="@(isStats ? "page" : null)" class="@(isStats ? activeClasses : inactiveClasses) flex items-center gap-3 px-3 py-2 rounded-lg transition-all" style="@(isStats ? activeStyle : inactiveStyle)">
                    <svg class="w-5 h-5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
                    <span class="text-sm font-medium">Statistics</span>
                </a>

                <div class="pt-2 mt-2 border-t" style="border-color: color-mix(in srgb, var(--neon-cyan) 10%, transparent)">
                    <a href="/Features/ApiKeys/Index" aria-current="@(isApiKeys ? "page" : null)" class="@(isApiKeys ? activeClasses : inactiveClasses) flex items-center gap-3 px-3 py-2 rounded-lg transition-all" style="@(isApiKeys ? activeStyle : inactiveStyle)">
                        <svg class="w-5 h-5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z" /></svg>
                        <span class="text-sm font-medium">API Keys</span>
                    </a>

                    <a href="/Features/Settings/Index" aria-current="@(isSettings ? "page" : null)" class="@(isSettings ? activeClasses : inactiveClasses) flex items-center gap-3 px-3 py-2 rounded-lg transition-all" style="@(isSettings ? activeStyle : inactiveStyle)">
                        <svg class="w-5 h-5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                        <span class="text-sm font-medium">Settings</span>
                    </a>
                </div>
            </nav>

            <!-- Theme controls -->
            <div class="p-3 shrink-0 space-y-2" style="border-top: 1px solid color-mix(in srgb, var(--neon-cyan) 10%, transparent)">
                <label for="themeSelect" class="sr-only">Theme</label>
                <select id="themeSelect" class="w-full text-sm rounded-lg px-3 py-2 border transition-all"
                        style="background-color: var(--bg-card); color: var(--text-primary); border-color: color-mix(in srgb, var(--neon-cyan) 20%, transparent)"
                        onchange="setThemeName(this.value)">
                    <option value="sockless" selected>Sockless</option>
                    <option value="neon">Neon</option>
                </select>

                <button id="themeToggle" type="button" class="w-full flex items-center gap-3 px-3 py-2 rounded-lg hover:text-neon-magenta transition-all disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:text-inherit"
                        style="color: var(--text-secondary)"
                        aria-pressed="true"
                        onclick="toggleTheme()">
                    <svg id="themeIcon" class="w-5 h-5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707" /></svg>
                    <span id="themeLabel" class="text-sm font-medium">Light Mode</span>
                </button>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 flex flex-col overflow-hidden">
            <!-- Top Bar (h-16 matches the sidebar logo's height above so the dividers line up across the page) -->
            <header style="background-color: var(--bg-surface); border-bottom: 1px solid color-mix(in srgb, var(--neon-cyan) 10%, transparent)" class="h-16 px-6 flex items-center justify-between shrink-0">
                <h2 style="color: var(--text-primary)" class="text-xl font-semibold">@ViewData["Title"]</h2>
                <div class="flex items-center gap-4">
                    <!-- Status indicator -->
                    <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium border" style="background-color: color-mix(in srgb, var(--neon-green) 10%, transparent); color: var(--neon-green); border-color: color-mix(in srgb, var(--neon-green) 20%, transparent)">
                        <span class="w-2 h-2 rounded-full animate-pulse" style="background-color: var(--neon-green)" aria-hidden="true"></span>
                        System Online
                    </span>
                </div>
            </header>

            <!-- Page Content (the only region that scrolls) -->
            <div id="main-content" class="flex-1 overflow-y-auto p-6" tabindex="-1">
                @RenderBody()
            </div>
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // Sockless has no light variant (matches the site it's modeled on), so the
        // light/dark toggle only makes sense while the neon theme is active.
        function isDarkOnlyTheme(themeName) {
            return themeName === 'sockless';
        }

        function toggleTheme() {
            const html = document.documentElement;
            if (isDarkOnlyTheme(html.getAttribute('data-theme'))) return;

            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                localStorage.setItem('theme', 'light');
            } else {
                html.classList.add('dark');
                localStorage.setItem('theme', 'dark');
            }
            syncThemeControls();
        }

        function setThemeName(themeName) {
            const html = document.documentElement;
            html.setAttribute('data-theme', themeName);
            localStorage.setItem('themeName', themeName);
            if (isDarkOnlyTheme(themeName)) {
                // Applied visually only — the stored light/dark preference is left
                // untouched so it resurfaces if the user switches back to a theme
                // that supports both modes.
                html.classList.add('dark');
            } else {
                html.classList.toggle('dark', localStorage.getItem('theme') !== 'light');
            }
            syncThemeControls();
        }

        // Keeps the theme <select>, the light/dark toggle button, and the <html> state
        // in sync — called on load (matching the inline pre-paint script above) and
        // whenever either control changes.
        function syncThemeControls() {
            const html = document.documentElement;
            const themeName = html.getAttribute('data-theme') || 'sockless';
            const isDark = html.classList.contains('dark');
            const darkOnly = isDarkOnlyTheme(themeName);

            const select = document.getElementById('themeSelect');
            select.value = themeName;

            const toggleBtn = document.getElementById('themeToggle');
            const label = document.getElementById('themeLabel');
            toggleBtn.disabled = darkOnly;
            toggleBtn.setAttribute('aria-pressed', String(isDark));
            label.textContent = darkOnly ? 'Dark Mode (fixed)' : (isDark ? 'Light Mode' : 'Dark Mode');
        }

        syncThemeControls();
    </script>
</body>
</html>