<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Sockless LLM Router</title>

    <!-- Tailwind CSS via CDN (for dev only — for production, install as PostCSS plugin or use the Tailwind CLI: https://tailwindcss.com/docs/installation ) -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Chart.js for statistics dashboard -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        neon: {
                            cyan: '#00f5ff',
                            magenta: '#ff00ff',
                            green: '#00ff88',
                            red: '#ff2e63',
                        },
                        cyber: {
                            card: 'var(--bg-card)',
                            surface: 'var(--bg-surface)',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* ── Custom theme variables (for responsive dark/light) ── */
        :root {
            --bg-main: #f0f0f5;
            --bg-surface: #ffffff;
            --bg-card: #fafafe;
            --text-primary: #1a1a2e;
            --text-secondary: #6b7280;
        }

        html.dark {
            --bg-main: #0a0a0f;
            --bg-surface: #12121c;
            --bg-card: #1a1a2e;
            --text-primary: #f0f0f5;
            --text-secondary: #9ca3af;
        }

        /* Cyberpunk scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: var(--bg-card); }
        ::-webkit-scrollbar-thumb { background: rgba(0, 245, 255, 0.267); border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(0, 245, 255, 0.533); }

        /* ── Neon text utilities ── */
        .text-neon-cyan { color: #00f5ff; text-shadow: 0 0 10px rgba(0,245,255,0.3); }
        .text-neon-magenta { color: #ff00ff; text-shadow: 0 0 10px rgba(255,0,255,0.3); }
        .text-neon-green { color: #00ff88; text-shadow: 0 0 10px rgba(0,255,136,0.3); }
        .text-neon-red { color: #ff2e63; }

        /* ── Theme-aware text colors (auto dark/light) ── */
        .text-text-primary { color: var(--text-primary); }
        .text-text-secondary { color: var(--text-secondary); }

        /* ── Cyberpunk background utilities (CSS variable-based, auto dark/light) ── */
        .bg-cyber-card { background-color: var(--bg-card); }
        .bg-cyber-surface { background-color: var(--bg-surface); }
        .bg-cyber-bg-dark { background-color: var(--bg-main); }

        /* ── Neon box shadows ── */
        .shadow-neon-cyan { box-shadow: 0 0 8px rgba(0,245,255,0.4), 0 0 20px rgba(0,245,255,0.1); }
        .shadow-neon-magenta { box-shadow: 0 0 8px rgba(255,0,255,0.4), 0 0 20px rgba(255,0,255,0.1); }
        .shadow-neon-green { box-shadow: 0 0 8px rgba(0,255,136,0.4), 0 0 20px rgba(0,255,136,0.1); }

        /* Glow animation */
        @@keyframes glow {
            0% { box-shadow: 0 0 5px rgba(0,245,255,0.2); }
            100% { box-shadow: 0 0 20px rgba(0,245,255,0.6), 0 0 40px rgba(0,245,255,0.2); }
        }
        .animate-glow { animation: glow 2s ease-in-out infinite alternate; }
    </style>
</head>
<body style="background-color: var(--bg-main)" class="min-h-screen transition-colors duration-300">

    <div class="flex min-h-screen">
        <!-- Sidebar -->
        <aside style="background-color: var(--bg-surface); border-right: 1px solid rgba(0,245,255,0.1)" class="w-64 flex flex-col">
            <!-- Logo -->
            <div class="p-5" style="border-bottom: 1px solid rgba(0,245,255,0.1)">
                <h1 class="text-lg font-bold text-neon-cyan tracking-wider">⚡ Sockless</h1>
                <p class="text-xs mt-1" style="color: var(--text-secondary)">LLM Router</p>
            </div>

@{
    var path = Context.Request.Path.ToString();
    bool isDashboard = path == "/" || path == "";
    bool isServers = path.StartsWith("/Features/Servers");
    bool isPresets = path.StartsWith("/Features/Presets");
    bool isRequestLog = path.StartsWith("/Features/RequestLog");
    bool isStats = path.StartsWith("/Features/Stats");
    bool isSettings = path.StartsWith("/Features/Settings");
    string activeStyle = @"color: #00f5ff; background-color: rgba(0,245,255,0.1); border-left-color: #00f5ff";
    string inactiveStyle = @"color: var(--text-secondary)";
}
            <!-- Navigation -->
            <nav class="flex-1 p-3 space-y-1">
                <a href="/" class="@(isDashboard ? "border-l-2 " : "hover:text-neon-cyan ") flex items-center gap-3 px-3 py-2 rounded-lg transition-all" style="@(isDashboard ? activeStyle : inactiveStyle)">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1" /></svg>
                    <span class="text-sm font-medium">Dashboard</span>
                </a>

                <a href="/Features/Servers/Index" class="@(isServers ? "border-l-2 " : "hover:text-neon-cyan ") flex items-center gap-3 px-3 py-2 rounded-lg transition-all" style="@(isServers ? activeStyle : inactiveStyle)">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2" /></svg>
                    <span class="text-sm font-medium">Servers</span>
                </a>

                <a href="/Features/Presets/Index" class="@(isPresets ? "border-l-2 " : "hover:text-neon-cyan ") flex items-center gap-3 px-3 py-2 rounded-lg transition-all" style="@(isPresets ? activeStyle : inactiveStyle)">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
                    <span class="text-sm font-medium">Presets</span>
                </a>

                <a href="/Features/RequestLog/Index" class="@(isRequestLog ? "border-l-2 " : "hover:text-neon-cyan ") flex items-center gap-3 px-3 py-2 rounded-lg transition-all" style="@(isRequestLog ? activeStyle : inactiveStyle)">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" /></svg>
                    <span class="text-sm font-medium">Request Log</span>
                </a>

                <a href="/Features/Stats/Dashboard" class="@(isStats ? "border-l-2 " : "hover:text-neon-cyan ") flex items-center gap-3 px-3 py-2 rounded-lg transition-all" style="@(isStats ? activeStyle : inactiveStyle)">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
                    <span class="text-sm font-medium">Statistics</span>
                </a>

                <div class="pt-2 mt-2 border-t" style="border-color: rgba(0,245,255,0.1)">
                    <a href="/Features/Settings/Index" class="@(isSettings ? "border-l-2 " : "hover:text-neon-cyan ") flex items-center gap-3 px-3 py-2 rounded-lg transition-all" style="@(isSettings ? activeStyle : inactiveStyle)">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                        <span class="text-sm font-medium">Settings</span>
                    </a>
                </div>
            </nav>

            <!-- Theme Toggle -->
            <div class="p-3" style="border-top: 1px solid rgba(0,245,255,0.1)">
                <button id="themeToggle" class="w-full flex items-center gap-3 px-3 py-2 rounded-lg hover:text-neon-magenta transition-all"
                        style="color: var(--text-secondary)"
                        onclick="toggleTheme()">
                    <svg id="themeIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707" /></svg>
                    <span id="themeLabel" class="text-sm font-medium">Light Mode</span>
                </button>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 overflow-auto">
            <!-- Top Bar -->
            <header style="background-color: var(--bg-surface); border-bottom: 1px solid rgba(0,245,255,0.1)" class="px-6 py-4 flex items-center justify-between">
                <h2 style="color: var(--text-primary)" class="text-xl font-semibold">@ViewData["Title"]</h2>
                <div class="flex items-center gap-4">
                    <!-- Status indicator -->
                    <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium border" style="background-color: rgba(0,255,136,0.1); color: #00ff88; border-color: rgba(0,255,136,0.2)">
                        <span class="w-2 h-2 rounded-full animate-pulse" style="background-color: #00ff88"></span>
                        System Online
                    </span>
                </div>
            </header>

            <!-- Page Content -->
            <div class="p-6">
                @RenderBody()
            </div>
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        function toggleTheme() {
            const html = document.documentElement;
            const icon = document.getElementById('themeIcon');
            const label = document.getElementById('themeLabel');

            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                localStorage.setItem('theme', 'light');
                label.textContent = 'Dark Mode';
            } else {
                html.classList.add('dark');
                localStorage.setItem('theme', 'dark');
                label.textContent = 'Light Mode';
            }
        }

        // Restore theme preference on load
        (function () {
            const saved = localStorage.getItem('theme');
            if (saved === 'light') {
                document.documentElement.classList.remove('dark');
                document.getElementById('themeLabel').textContent = 'Dark Mode';
            } else {
                document.documentElement.classList.add('dark');
                document.getElementById('themeLabel').textContent = 'Light Mode';
            }
        })();
    </script>
</body>
</html>