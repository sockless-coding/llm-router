@page
@using LR.Application.Pages.Features.Servers
@model EditModel
@{
    ViewData["Title"] = "Edit Server";
}

@if (!string.IsNullOrEmpty(TempData["SuccessMessage"] as string))
{
    <div class="max-w-lg mx-auto mb-4">
        <div class="bg-emerald-500/10 border border-emerald-500/30 rounded-xl p-4 flex items-center gap-3" role="status">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-400 flex-shrink-0" aria-hidden="true" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            <p class="text-sm text-emerald-300">@TempData["SuccessMessage"]</p>
        </div>
    </div>
}

@if (Model.Server is not null)
{
    <form method="post" hx-boost="false" class="max-w-lg mx-auto">
        @Html.AntiForgeryToken()

        <!-- Info section -->
        <div class="bg-cyber-card rounded-xl p-6 border border-neon-cyan/10 space-y-5 mb-4">
            <div class="flex items-center justify-between">
                <h2 class="text-lg font-semibold text-text-primary">Server Details</h2>
                <a href="/Features/Servers/Detail?id=@Model.Server.Id" class="text-sm text-neon-cyan hover:underline">Runtime &amp; logs →</a>
            </div>

            <!-- Name -->
            <div>
                <p class="text-sm font-medium text-text-secondary mb-1">Name</p>
                <p class="text-lg text-text-primary font-medium">@Model.Server.Name</p>
            </div>

            <!-- Engine -->
            <div>
                <p class="text-sm font-medium text-text-secondary mb-1">Server Engine</p>
                <span class="px-2 py-0.5 rounded text-xs font-medium bg-neon-cyan/10 text-neon-cyan">
                    @Model.Server.Engine.ToString().Replace("LlamaCpp", "llama.cpp")
                </span>
            </div>

            <!-- Status -->
            <div>
                <p class="text-sm font-medium text-text-secondary mb-1">Status</p>
                <p class="text-text-primary">@Model.Server.Status - @if (Model.Server.IsHealthy) { <text>Healthy</text> } else { <text>Unhealthy</text> }</p>
            </div>

            <!-- Port -->
            <div>
                <p class="text-sm font-medium text-text-secondary mb-1">Port</p>
                <p class="text-text-primary">@Model.Server.Port</p>
            </div>

            <!-- URL -->
            @if (!string.IsNullOrEmpty(Model.Server.Url))
            {
                <div>
                    <p class="text-sm font-medium text-text-secondary mb-1">URL</p>
                    <p class="text-neon-cyan">@Model.Server.Url</p>
                </div>
            }

            <!-- Start Command -->
            <div>
                <p class="text-sm font-medium text-text-secondary mb-1">Start Command</p>
                @if (!string.IsNullOrEmpty(Model.ViewModel.StartCommand))
                {
                    <p class="text-xs text-text-secondary mb-2">The command that will be executed to start this server.</p>
                    <div class="relative">
                        <pre id="start-command" class="bg-cyber-bg-dark rounded-lg p-3 border border-gray-600/30 text-xs font-mono text-text-primary overflow-x-auto whitespace-pre-wrap break-all max-h-48 overflow-y-auto"><code>@Model.ViewModel.StartCommand</code></pre>
                        <button type="button" onclick="copyToClipboard('start-command')"
                                class="absolute top-2 right-2 px-2 py-1 rounded-md bg-gray-700/50 text-text-secondary hover:text-neon-cyan hover:bg-gray-600/50 transition-all text-xs flex items-center gap-1">
                            <svg class="w-3 h-3" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>
                            Copy
                        </button>
                    </div>
                }
                else
                {
                    <p class="text-xs text-text-secondary mb-2">The command that will be executed to start this server.</p>
                    <div class="bg-yellow-500/10 border border-yellow-500/30 rounded-lg p-3">
                        <p class="text-sm text-yellow-400">No active preset configured for this server.</p>
                        <p class="text-xs text-text-secondary mt-1">Create a preset with a model path and set it as the active preset before starting.</p>
                    </div>
                }

        </div>

    <script>
    function copyToClipboard(elementId) {
        const el = document.getElementById(elementId);
        if (!el) return;
        navigator.clipboard.writeText(el.textContent || '').then(() => {
            const btn = el.parentElement.querySelector('button');
            if (btn) {
                const orig = btn.innerHTML;
                btn.innerHTML = '<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Copied!';
                setTimeout(() => { btn.innerHTML = orig; }, 1500);
            }
        });
    }

    // The manual folder path only applies when no managed build is selected.
    function toggleFolderField() {
        const buildSelect = document.getElementById('ViewModel_EngineBuildId');
        const folderField = document.getElementById('installFolderField');
        if (buildSelect && folderField) {
            folderField.classList.toggle('hidden', !!buildSelect.value);
        }
    }
    </script>

        <!-- Config section -->
        @if (Model.Engine is { } engine)
        {
            <div class="bg-cyber-card rounded-xl p-6 border border-neon-cyan/10 space-y-5">
                <h2 class="text-lg font-semibold text-text-primary">@engine.DisplayName Configuration</h2>

                @if (engine.SupportsManagedBuilds)
                {
                <!-- Managed build -->
                <div>
                    <label asp-for="ViewModel.EngineBuildId" class="block text-sm font-medium text-text-secondary mb-1">
                        Engine Build
                    </label>
                    <p class="text-xs text-gray-500 mb-2">Bind this server to a build from <a href="/Features/Engines/Index?engine=@engine.Engine" class="text-neon-cyan/70 hover:text-neon-cyan">Engines</a>. Its install folder is used automatically and the path below is ignored. Choose <em>custom folder</em> to manage the build yourself.</p>
                    <select asp-for="ViewModel.EngineBuildId" onchange="toggleFolderField()"
                            class="w-full px-4 py-2.5 rounded-lg bg-cyber-bg-dark border border-gray-600/30 text-text-primary focus:border-neon-cyan focus:ring-1 focus:ring-neon-cyan/30 outline-none transition-all text-sm">
                        <option value="">— custom folder (use folder path below) —</option>
                        @foreach (var build in Model.AvailableBuilds)
                        {
                            <option value="@build.Id" selected="@(Model.ViewModel.EngineBuildId == build.Id)">@build.Name — @build.BackendType (@(build.VersionTag ?? "?"))</option>
                        }
                    </select>
                </div>
                }

                <!-- Install Folder Path -->
                <div id="installFolderField" class="@(engine.SupportsManagedBuilds && Model.ViewModel.EngineBuildId.HasValue ? "hidden" : "")">
                    <label asp-for="ViewModel.InstallFolderPath" class="block text-sm font-medium text-text-secondary mb-1">
                        @engine.InstallFolderLabel
                    </label>
                    <p class="text-xs text-gray-500 mb-2">@engine.InstallFolderHelp</p>
                    <input asp-for="ViewModel.InstallFolderPath" placeholder="@engine.InstallFolderPlaceholder"
                           class="w-full px-4 py-2.5 rounded-lg bg-cyber-bg-dark border border-gray-600/30 text-text-primary focus:border-neon-cyan focus:ring-1 focus:ring-neon-cyan/30 outline-none transition-all placeholder-gray-500 font-mono text-sm" />
                    <span asp-validation-for="ViewModel.InstallFolderPath" class="text-xs text-neon-red mt-1"></span>
                </div>

                <!-- Companion App Path -->
                <div>
                    <label asp-for="ViewModel.CompanionAppPath" class="block text-sm font-medium text-text-secondary mb-1">
                        Companion App Path <span class="text-gray-500">(optional)</span>
                    </label>
                    <p class="text-xs text-gray-500 mb-2">Path to a companion application that should run alongside the server. For example, the SYCL VRAM keeper on Windows when no display is connected.</p>
                    <input asp-for="ViewModel.CompanionAppPath" placeholder="C:\\tools\\sycl-vram-keeper.exe"
                           class="w-full px-4 py-2.5 rounded-lg bg-cyber-bg-dark border border-gray-600/30 text-text-primary focus:border-neon-cyan focus:ring-1 focus:ring-neon-cyan/30 outline-none transition-all placeholder-gray-500 font-mono text-sm" />
                    <span asp-validation-for="ViewModel.CompanionAppPath" class="text-xs text-neon-red mt-1"></span>
                </div>

                <!-- Environment Setup Command -->
                <div>
                    <label asp-for="ViewModel.EnvironmentSetupCommand" class="block text-sm font-medium text-text-secondary mb-1">
                        Environment Setup Command <span class="text-gray-500">(optional)</span>
                    </label>
                    <p class="text-xs text-gray-500 mb-2">Shell command to initialize environment variables before starting the server. For example, for SYCL backends on Windows: <code class="text-neon-cyan/70">"C:\Program Files (x86)\Intel\oneAPI\setvars.bat" intel64</code></p>
                    <input asp-for="ViewModel.EnvironmentSetupCommand" placeholder='"C:\Program Files (x86)\Intel\oneAPI\setvars.bat" intel64'
                           class="w-full px-4 py-2.5 rounded-lg bg-cyber-bg-dark border border-gray-600/30 text-text-primary focus:border-neon-cyan focus:ring-1 focus:ring-neon-cyan/30 outline-none transition-all placeholder-gray-500 font-mono text-sm" />
                    <span asp-validation-for="ViewModel.EnvironmentSetupCommand" class="text-xs text-neon-red mt-1"></span>
                </div>

                <!-- Memory group & idle unload -->
                <div class="pt-2 border-t border-gray-600/20 space-y-5">
                    <h3 class="text-sm font-semibold text-text-primary pt-3">Memory &amp; unloading</h3>

                    <div>
                        <label asp-for="ViewModel.MemoryGroup" class="block text-sm font-medium text-text-secondary mb-1">
                            Memory group <span class="text-gray-500">(optional)</span>
                        </label>
                        <p class="text-xs text-gray-500 mb-2">Give servers that share a GPU the same group name. Before one of them loads a model, the least-recently-used idle servers in the group are stopped until it fits the group's budget.</p>
                        <input asp-for="ViewModel.MemoryGroup" list="memory-groups" placeholder="e.g. gpu0" class="w-full px-4 py-2.5 rounded-lg bg-cyber-bg-dark border border-gray-600/30 text-text-primary focus:border-neon-cyan focus:ring-1 focus:ring-neon-cyan/30 outline-none transition-all placeholder-gray-500 text-sm font-mono" />
                        <datalist id="memory-groups">
                            @foreach (var g in Model.ExistingGroups)
                            {
                                <option value="@g.Name">@(g.BudgetMb > 0 ? $"{g.BudgetMb / 1024.0:0.#} GB" : "no budget")</option>
                            }
                        </datalist>
                        <span asp-validation-for="ViewModel.MemoryGroup" class="text-xs text-neon-red mt-1"></span>
                    </div>

                    <div>
                        <label asp-for="ViewModel.GroupBudgetGb" class="block text-sm font-medium text-text-secondary mb-1">Group memory budget (GB)</label>
                        <p class="text-xs text-gray-500 mb-2">Usable device memory for the whole group. It's shared, so changing it here changes it for every server in the group. Leave a little headroom below the card's total. Empty means no limit.</p>
                        <input asp-for="ViewModel.GroupBudgetGb" type="number" step="0.5" min="0" placeholder="e.g. 22" class="w-full px-4 py-2.5 rounded-lg bg-cyber-bg-dark border border-gray-600/30 text-text-primary focus:border-neon-cyan focus:ring-1 focus:ring-neon-cyan/30 outline-none transition-all placeholder-gray-500 text-sm" />
                        <span asp-validation-for="ViewModel.GroupBudgetGb" class="text-xs text-neon-red mt-1"></span>
                    </div>

                    @if (Model.PresetEstimates.Count > 0)
                    {
                        <div>
                            <p class="text-sm font-medium text-text-secondary mb-1">Estimated footprint per preset</p>
                            <p class="text-xs text-gray-500 mb-2">This comes from file sizes and the KV cache. If it's off, set <em>Memory estimate</em> on the preset.</p>
                            <ul class="text-xs font-mono text-text-primary space-y-0.5">
                                @foreach (var (name, mb, overridden) in Model.PresetEstimates)
                                {
                                    <li>@name — @(mb >= 1024 ? $"{mb / 1024.0:0.0} GB" : $"{mb} MB")@(overridden ? " (override)" : "")</li>
                                }
                            </ul>
                        </div>
                    }

                    <div>
                        <label asp-for="ViewModel.IdleUnloadMinutes" class="block text-sm font-medium text-text-secondary mb-1">Unload after idle (minutes)</label>
                        <p class="text-xs text-gray-500 mb-2">Stop this server after this many minutes without requests. The next request starts it again. Empty or 0 means never. Presets marked <em>Keep loaded</em> are exempt.</p>
                        <input asp-for="ViewModel.IdleUnloadMinutes" type="number" min="0" placeholder="e.g. 30" class="w-full px-4 py-2.5 rounded-lg bg-cyber-bg-dark border border-gray-600/30 text-text-primary focus:border-neon-cyan focus:ring-1 focus:ring-neon-cyan/30 outline-none transition-all placeholder-gray-500 text-sm" />
                        <span asp-validation-for="ViewModel.IdleUnloadMinutes" class="text-xs text-neon-red mt-1"></span>
                    </div>
                </div>

                <!-- Actions -->
                <div class="flex items-center gap-3 pt-2">
                    <button type="submit"
                            class="px-6 py-2.5 rounded-lg bg-neon-cyan/10 text-neon-cyan border border-neon-cyan/30 hover:bg-neon-cyan/20 transition-all font-medium text-sm shadow-neon-cyan">
                        Save Changes
                    </button>
                    <a href="/Features/Servers/Index"
                       class="px-6 py-2.5 rounded-lg bg-gray-700/30 text-text-secondary border border-gray-600/20 hover:bg-gray-700/50 transition-all font-medium text-sm">
                        Back
                    </a>
                </div>
            </div>
        }
    </form>

    <script>
        // Runs inline (not on DOMContentLoaded) so it also fires on htmx-boosted revisits.
        toggleFolderField();
    </script>
}
