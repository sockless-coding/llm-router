@page
@using LR.Application.Pages.Features.Servers
@model ServerCreateModel
@{
    ViewData["Title"] = "Create Server";
}

@if (!ViewData.ModelState.IsValid && !string.IsNullOrEmpty(TempData["ErrorMessage"] as string))
{
    <div class="max-w-lg mx-auto mb-4">
        <div class="bg-red-500/10 border border-red-500/30 rounded-xl p-4 flex items-center gap-3" role="alert">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-400 flex-shrink-0" aria-hidden="true" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
            <p class="text-sm text-red-300">@TempData["ErrorMessage"]</p>
        </div>
    </div>
}

<div class="max-w-lg mx-auto">
    <form method="post" hx-boost="false" class="bg-cyber-card rounded-xl p-6 border border-neon-cyan/10 space-y-5">
        @Html.AntiForgeryToken()

        <!-- Name -->
        <div>
            <label for="ViewModel_Name" class="block text-sm font-medium text-text-secondary mb-2">Server Name</label>
            <input asp-for="ViewModel.Name" required placeholder="e.g. cuda-main"
                   class="w-full px-4 py-2.5 rounded-lg bg-cyber-bg-dark border border-gray-600/30 text-text-primary focus:border-neon-cyan focus:ring-1 focus:ring-neon-cyan/30 outline-none transition-all placeholder-gray-500" />
            <span asp-validation-for="ViewModel.Name" class="text-xs text-neon-red mt-1"></span>
        </div>

        <!-- Server Engine -->
        <div>
            <label for="ViewModel_Engine" class="block text-sm font-medium text-text-secondary mb-2">Server Engine</label>
            <select asp-for="ViewModel.Engine"
                    onchange="toggleEngineFields()"
                    class="w-full px-4 py-2.5 rounded-lg bg-cyber-bg-dark border border-gray-600/30 text-text-primary focus:border-neon-cyan focus:ring-1 focus:ring-neon-cyan/30 outline-none transition-all">
                @foreach (var engine in Model.Engines)
                {
                    <option value="@engine.Engine"
                            data-display-name="@engine.DisplayName"
                            data-managed-builds="@(engine.SupportsManagedBuilds ? "true" : "false")"
                            data-folder-label="@engine.InstallFolderLabel"
                            data-folder-help="@engine.InstallFolderHelp"
                            data-folder-placeholder="@engine.InstallFolderPlaceholder">@engine.DisplayName</option>
                }
            </select>
        </div>

        <!-- Port -->
        <div>
            <label for="ViewModel_Port" class="block text-sm font-medium text-text-secondary mb-2">Port <span class="text-gray-500">(optional)</span></label>
            <input asp-for="ViewModel.Port" type="number" min="1024" max="65535" placeholder="Auto-assigned"
                   class="w-full px-4 py-2.5 rounded-lg bg-cyber-bg-dark border border-gray-600/30 text-text-primary focus:border-neon-cyan focus:ring-1 focus:ring-neon-cyan/30 outline-none transition-all placeholder-gray-500" />
        </div>

        <!-- Engine configuration (labels/help switch with the selected engine) -->
        <div id="engineFields" class="space-y-4">
            <h3 class="text-sm font-semibold text-gray-200 border-b border-gray-700/50 pb-2"><span id="engineConfigTitle">llama.cpp</span> Configuration</h3>

            <!-- Managed build (engines that support managed builds only) -->
            <div id="managedBuildField">
                <label asp-for="ViewModel.EngineBuildId" class="block text-sm font-medium text-text-secondary mb-1">
                    Engine Build
                </label>
                <p class="text-xs text-gray-500 mb-2">Bind this server to a build from <a id="enginesLink" href="/Features/Engines/Index" class="text-neon-cyan/70 hover:text-neon-cyan">Engines</a>. Its install folder and GPU backend are used automatically. Choose <em>custom folder</em> to point at a build you manage yourself.</p>
                @if (Model.AvailableBuilds.Count == 0)
                {
                    <p class="text-xs text-yellow-400/80 mb-2">No ready builds yet — <a href="/Features/Engines/Index" class="underline hover:text-yellow-300">download or compile one</a>, or enter a folder path below.</p>
                }
                <select asp-for="ViewModel.EngineBuildId" onchange="toggleEngineFields()"
                        class="w-full px-4 py-2.5 rounded-lg bg-cyber-bg-dark border border-gray-600/30 text-text-primary focus:border-neon-cyan focus:ring-1 focus:ring-neon-cyan/30 outline-none transition-all text-sm">
                    <option value="">— custom folder (enter path below) —</option>
                    @foreach (var build in Model.AvailableBuilds)
                    {
                        <option value="@build.Id" data-engine="@build.Engine">@build.Name — @build.BackendType (@(build.VersionTag ?? "?"))</option>
                    }
                </select>
                <span asp-validation-for="ViewModel.EngineBuildId" class="text-xs text-neon-red mt-1"></span>
            </div>

            <!-- Install Folder Path -->
            <div id="installFolderField">
                <label id="installFolderLabel" for="ViewModel_InstallFolderPath" class="block text-sm font-medium text-text-secondary mb-1">
                    Server Folder Path
                </label>
                <p class="text-xs text-gray-500 mb-2"><span id="installFolderHelp"></span><span id="installFolderBuildNote"> Ignored when an engine build is selected above.</span></p>
                <input asp-for="ViewModel.InstallFolderPath"
                       class="w-full px-4 py-2.5 rounded-lg bg-cyber-bg-dark border border-gray-600/30 text-text-primary focus:border-neon-cyan focus:ring-1 focus:ring-neon-cyan/30 outline-none transition-all placeholder-gray-500 font-mono text-sm" />
                <span asp-validation-for="ViewModel.InstallFolderPath" class="text-xs text-neon-red mt-1"></span>
            </div>

            <!-- Companion App Path -->
            <div>
                <label for="ViewModel_CompanionAppPath" class="block text-sm font-medium text-text-secondary mb-1">
                    Companion App Path <span class="text-gray-500">(optional)</span>
                </label>
                <p class="text-xs text-gray-500 mb-2">Path to a companion application that should run alongside the server. For example, the SYCL VRAM keeper on Windows when no display is connected, or similar Vulkan helper processes.</p>
                <input asp-for="ViewModel.CompanionAppPath" placeholder="C:\tools\sycl-vram-keeper.exe"
                       class="w-full px-4 py-2.5 rounded-lg bg-cyber-bg-dark border border-gray-600/30 text-text-primary focus:border-neon-cyan focus:ring-1 focus:ring-neon-cyan/30 outline-none transition-all placeholder-gray-500 font-mono text-sm" />
                <span asp-validation-for="ViewModel.CompanionAppPath" class="text-xs text-neon-red mt-1"></span>
            </div>

            <!-- Environment Setup Command -->
            <div>
                <label for="ViewModel_EnvironmentSetupCommand" class="block text-sm font-medium text-text-secondary mb-1">
                    Environment Setup Command <span class="text-gray-500">(optional)</span>
                </label>
                <p class="text-xs text-gray-500 mb-2">Shell command to initialize environment variables before starting the server. For example, for SYCL backends on Windows: <code class="text-neon-cyan/70">"C:\Program Files (x86)\Intel\oneAPI\setvars.bat" intel64</code></p>
                <input asp-for="ViewModel.EnvironmentSetupCommand" placeholder='"C:\Program Files (x86)\Intel\oneAPI\setvars.bat" intel64'
                       class="w-full px-4 py-2.5 rounded-lg bg-cyber-bg-dark border border-gray-600/30 text-text-primary focus:border-neon-cyan focus:ring-1 focus:ring-neon-cyan/30 outline-none transition-all placeholder-gray-500 font-mono text-sm" />
                <span asp-validation-for="ViewModel.EnvironmentSetupCommand" class="text-xs text-neon-red mt-1"></span>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-3 pt-2">
            <button type="submit"
                    class="px-6 py-2.5 rounded-lg bg-neon-cyan/10 text-neon-cyan border border-neon-cyan/30 hover:bg-neon-cyan/20 transition-all font-medium text-sm shadow-neon-cyan">
                Create Server
            </button>
            <a href="/Features/Servers/Index"
               class="px-6 py-2.5 rounded-lg bg-gray-700/30 text-text-secondary border border-gray-600/20 hover:bg-gray-700/50 transition-all font-medium text-sm">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
<script>
function toggleEngineFields() {
    const engineSelect = document.getElementById('ViewModel_Engine');
    const option = engineSelect.options[engineSelect.selectedIndex];
    if (!option) return;

    const supportsBuilds = option.dataset.managedBuilds === 'true';
    document.getElementById('engineConfigTitle').textContent = option.dataset.displayName;
    document.getElementById('installFolderLabel').textContent = option.dataset.folderLabel;
    document.getElementById('installFolderHelp').textContent = option.dataset.folderHelp;
    document.getElementById('ViewModel_InstallFolderPath').placeholder = option.dataset.folderPlaceholder;
    document.getElementById('installFolderBuildNote').classList.toggle('hidden', !supportsBuilds);

    // Managed installs are per-engine: only offer the selected engine's, and clear a stale pick.
    const buildSelect = document.getElementById('ViewModel_EngineBuildId');
    document.getElementById('managedBuildField').classList.toggle('hidden', !supportsBuilds);
    document.getElementById('enginesLink').href = '/Features/Engines/Index?engine=' + engineSelect.value;
    if (buildSelect) {
        for (const opt of buildSelect.options) {
            if (opt.dataset.engine) opt.hidden = opt.dataset.engine !== engineSelect.value;
        }
        if (!supportsBuilds || buildSelect.selectedOptions[0]?.hidden) buildSelect.value = '';
    }

    // The manual folder path only applies when no managed build is selected.
    document.getElementById('installFolderField').classList.toggle('hidden', supportsBuilds && !!buildSelect?.value);
}

// Runs immediately rather than on DOMContentLoaded: the <select> above is already in the
// document by the time this script executes, both on a normal page load and on an
// htmx-boosted navigation (DOMContentLoaded fires once per real browser navigation, so
// gating on it would mean this never runs on a boosted revisit to this page).
toggleEngineFields();
</script>
}

