@page
@using LR.Application.Pages.Features.Servers
@model ServersListModel
@{
    ViewData["Title"] = "Servers";
}

<form id="csrf-form" hidden>@Html.AntiForgeryToken()</form>
<div class="flex items-center justify-between mb-6">
    <p class="text-gray-400">Manage your inference server instances.</p>
    <a href="/Features/Servers/Create" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-neon-cyan/10 text-neon-cyan border border-neon-cyan/30 hover:bg-neon-cyan/20 transition-all text-sm font-medium">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" /></svg>
        New Server
    </a>
</div>

<div class="bg-cyber-card rounded-xl border border-neon-cyan/10 overflow-hidden">
    <table class="w-full text-sm">
        <thead>
            <tr class="border-b border-gray-700/50">
                <th class="text-left px-6 py-3 text-xs font-semibold uppercase tracking-wider text-gray-400">Name</th>
                <th class="text-left px-6 py-3 text-xs font-semibold uppercase tracking-wider text-gray-400">Engine</th>
                <th class="text-left px-6 py-3 text-xs font-semibold uppercase tracking-wider text-gray-400">Status</th>
                <th class="text-left px-6 py-3 text-xs font-semibold uppercase tracking-wider text-gray-400">Port</th>
                <th class="text-right px-6 py-3 text-xs font-semibold uppercase tracking-wider text-gray-400">Actions</th>
            </tr>
        </thead>
        <tbody id="server-list">
            @if (!Model.Servers.Any())
            {
                <tr><td colspan="5" class="px-6 py-12 text-center text-gray-500">No servers yet. Create one to get started.</td></tr>
            }
            else
            {
                @foreach (var server in Model.Servers)
                {
                    <tr class="border-b border-gray-700/30 hover:bg-white/[0.02] transition-colors @if (server.Status == ServerStatus.Error) { <text>border-l-2 border-l-neon-red</text> }" id="server-row-@server.Id">
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-2">
                                <span class="text-gray-100 font-medium">@server.Name</span>
                                @if (server.LastErrorMessage != null)
                                {
                                    <span class="cursor-help text-neon-red" title="Last error: @(server.LastErrorMessage)\n@(server.LastErrorTime?.ToString("yyyy-MM-dd HH:mm:ss"))">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                                    </span>
                                }
                            </div>
                        </td>
                        <td class="px-6 py-4">
                            <span class="px-2 py-0.5 rounded text-xs font-medium bg-neon-cyan/10 text-neon-cyan">
                                @server.Engine.ToString().Replace("LlamaCpp", "llama.cpp")
                            </span>
                        </td>
                        <td class="px-6 py-4">
                            <div>
                                <span class="flex items-center gap-2" id="status-@server.Id">
                                    <span class="w-2 h-2 rounded-full
                                        @if (server.Status == ServerStatus.Running) { <text>bg-neon-green</text> }
                                        else if (server.Status == ServerStatus.Starting || server.Status == ServerStatus.Stopping) { <text>bg-yellow-500 animate-pulse</text> }
                                        else if (server.Status == ServerStatus.Error) { <text>bg-neon-red</text> }
                                        else { <text>bg-gray-400</text> }"></span>
                                    @server.Status
                                </span>
                                @if (server.RestartCount > 0)
                                {
                                    <div class="text-xs text-yellow-500 mt-1">Restarted @server.RestartCount/@server.MaxRestarts times</div>
                                }
                            </div>
                        </td>
                        <td class="px-6 py-4 text-gray-300">@server.Port</td>
                        <td class="px-6 py-4 text-right">
                            @if (server.Status == ServerStatus.Running)
                            {
                                <button onclick="stopServer('@server.Id')" class="text-neon-red hover:text-neon-red/80 transition-colors mr-3 inline-flex items-center gap-1" title="Stop server">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"/></svg>
                                    Stop
                                </button>
                            }
                            <a href="/Features/Servers/Edit?Id=@server.Id" class="text-neon-cyan hover:text-neon-cyan/80 transition-colors mr-3">Edit</a>
                            <a href="/Features/Servers/Detail?id=@server.Id" class="text-gray-400 hover:text-neon-cyan transition-colors mr-3 inline-flex items-center gap-1" title="View logs">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                                Logs
                            </a>
                            <button type="button" onclick="toggleCommand('@server.Id')"
                                    class="text-gray-500 hover:text-neon-cyan transition-colors inline-flex items-center gap-1" title="Show start command">
                                <svg id="cmd-icon-@server.Id" class="w-4 h-4 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<script>
async function stopServer(instanceId) {
    try {
        const response = await fetch('/Features/Servers/Actions', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ InstanceId: instanceId, Command: 'Stop' })
        });
        const result = await response.json();
        if (result.success) {
            location.reload();
        } else {
            alert('Failed to stop server: ' + result.message);
        }
    } catch (err) {
        alert('Error stopping server: ' + err.message);
    }
}

let expandedCommands = {};

async function toggleCommand(instanceId) {
    const rowId = 'server-row-' + instanceId;
    const cmdRowId = 'cmd-row-' + instanceId;
    const iconEl = document.getElementById('cmd-icon-' + instanceId);
    let cmdRow = document.getElementById(cmdRowId);

    if (expandedCommands[instanceId]) {
        // Collapse
        expandedCommands[instanceId] = false;
        if (cmdRow) cmdRow.remove();
        iconEl.classList.remove('rotate-90');
        return;
    }

    // Expand: remove existing detail row if any, then insert new one
    let oldCmdRow = document.getElementById(cmdRowId);
    if (oldCmdRow) oldCmdRow.remove();

    cmdRow = document.createElement('tr');
    cmdRow.id = cmdRowId;
    cmdRow.className = 'bg-cyber-bg-dark/50';
    cmdRow.innerHTML = '<td colspan="5" class="px-6 py-4"><div id="cmd-content-' + instanceId + '"><p class="text-gray-500 text-sm">Loading...</p></div></td>';

    const serverRow = document.getElementById(rowId);
    if (serverRow && serverRow.nextSibling) {
        serverRow.parentNode.insertBefore(cmdRow, serverRow.nextSibling);
    } else if (serverRow) {
        serverRow.parentNode.appendChild(cmdRow);
    }

    iconEl.classList.add('rotate-90');
    expandedCommands[instanceId] = true;

    // Fetch command via AJAX
    try {
        const token = document.querySelector('#csrf-form input[name="__RequestVerificationToken"]')?.value || '';
        const response = await fetch('/Features/Servers/Index?handler=GetStartCommand&instanceId=' + instanceId, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token }
        });
        const result = await response.json();
        const contentEl = document.getElementById('cmd-content-' + instanceId);
        if (contentEl && result.command) {
            contentEl.innerHTML = '<p class="text-xs text-gray-500 mb-2">Start command:</p><div class="relative"><pre id="start-cmd-' + instanceId + '" class="bg-cyber-bg-dark rounded-lg p-3 border border-gray-600/30 text-xs font-mono text-gray-300 overflow-x-auto whitespace-pre-wrap break-all max-h-48 overflow-y-auto"><code>' + escapeHtml(result.command) + '</code></pre><button type="button" onclick="copyCommand(\'' + instanceId + '\')" class="absolute top-2 right-2 px-2 py-1 rounded-md bg-gray-700/50 text-gray-400 hover:text-neon-cyan hover:bg-gray-600/50 transition-all text-xs flex items-center gap-1"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>Copy</button></div>';
        } else if (contentEl) {
            contentEl.innerHTML = '<p class="text-gray-500 text-sm">No active preset configured for this server.</p>';
        }
    } catch (e) {
        const contentEl = document.getElementById('cmd-content-' + instanceId);
        if (contentEl) contentEl.innerHTML = '<p class="text-neon-red text-sm">Failed to load command: ' + escapeHtml(e.message) + '</p>';
    }
}

function copyCommand(instanceId) {
    const el = document.getElementById('start-cmd-' + instanceId);
    if (!el) return;
    navigator.clipboard.writeText(el.textContent || '').then(() => {
        const btn = el.parentElement.querySelector('button');
        if (btn) {
            const orig = btn.innerHTML;
            btn.innerHTML = '<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Copied!';
            setTimeout(() => { btn.innerHTML = orig; }, 1500);
        }
    });
}

function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
}
</script>

