@page
@using LR.Application.Pages.Features.Servers
@model ServersListModel
@{
    ViewData["Title"] = "Servers";
}

<form id="csrf-form" hidden>@Html.AntiForgeryToken()</form>
<div class="flex items-center justify-between mb-6">
    <p class="text-text-secondary">Manage your inference server instances.</p>
    <a href="/Features/Servers/Create" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-neon-cyan/10 text-neon-cyan border border-neon-cyan/30 hover:bg-neon-cyan/20 transition-all text-sm font-medium">
        <svg class="w-4 h-4" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" /></svg>
        New Server
    </a>
</div>

<div class="bg-cyber-card rounded-xl border border-neon-cyan/10 overflow-hidden">
    <table class="w-full text-sm">
        <thead>
            <tr class="border-b border-gray-700/50">
                <th scope="col" class="text-left px-6 py-3 text-xs font-semibold uppercase tracking-wider text-text-secondary">Name</th>
                <th scope="col" class="text-left px-6 py-3 text-xs font-semibold uppercase tracking-wider text-text-secondary">Engine</th>
                <th scope="col" class="text-left px-6 py-3 text-xs font-semibold uppercase tracking-wider text-text-secondary">Status</th>
                <th scope="col" class="text-left px-6 py-3 text-xs font-semibold uppercase tracking-wider text-text-secondary">Port</th>
                <th scope="col" class="text-right px-6 py-3 text-xs font-semibold uppercase tracking-wider text-text-secondary">Actions</th>
            </tr>
        </thead>
        <tbody id="server-list">
            @if (!Model.Servers.Any())
            {
                <tr><td colspan="5" class="px-6 py-12 text-center text-text-secondary">No servers yet. Create one to get started.</td></tr>
            }
            else
            {
                @foreach (var server in Model.Servers)
                {
                    <tr class="border-b border-gray-700/30 hover:bg-white/[0.02] transition-colors @if (server.Status == ServerStatus.Error) { <text>border-l-2 border-l-neon-red</text> }" id="server-row-@server.Id">
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-2">
                                <span class="text-text-primary font-medium">@server.Name</span>
                                @if (server.LastErrorMessage != null)
                                {
                                    <span class="cursor-help text-neon-red" tabindex="0" role="img" aria-label="Last error: @(server.LastErrorMessage) at @(server.LastErrorTime?.ToString("yyyy-MM-dd HH:mm:ss"))" title="Last error: @(server.LastErrorMessage)&#10;@(server.LastErrorTime?.ToString("yyyy-MM-dd HH:mm:ss"))">
                                        <svg class="w-4 h-4" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                                    </span>
                                }
                            </div>
                        </td>
                        <td class="px-6 py-4">
                            <span class="px-2 py-0.5 rounded text-xs font-medium bg-neon-cyan/10 text-neon-cyan">
                                @server.Engine.ToString().Replace("LlamaCpp", "llama.cpp")
                            </span>
                        </td>
                        <td class="px-6 py-4">
                            <div>
                                <span class="flex items-center gap-2" id="status-@server.Id">
                                    <span class="w-2 h-2 rounded-full
                                        @if (server.Status == ServerStatus.Running) { <text>bg-neon-green</text> }
                                        else if (server.Status == ServerStatus.Starting || server.Status == ServerStatus.Stopping) { <text>bg-yellow-500 animate-pulse</text> }
                                        else if (server.Status == ServerStatus.Reconnecting) { <text>bg-blue-400 animate-pulse</text> }
                                        else if (server.Status == ServerStatus.Error) { <text>bg-neon-red</text> }
                                        else { <text>bg-gray-400</text> }"></span>
                                    @server.Status
                                </span>
                                @if (server.RestartCount > 0)
                                {
                                    <div class="text-xs text-yellow-500 mt-1">Restarted @server.RestartCount/@server.MaxRestarts times</div>
                                }
                            </div>
                        </td>
                        <td class="px-6 py-4 text-text-primary">@server.Port</td>
                        <td class="px-6 py-4 text-right">
                            @if (server.Status == ServerStatus.Running)
                            {
                                <button type="button" onclick="stopServer('@server.Id')" class="text-neon-red hover:text-neon-red/80 transition-colors mr-3 inline-flex items-center gap-1" title="Stop server">
                                    <svg class="w-4 h-4" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"/></svg>
                                    Stop
                                </button>
                            }
                            else if (server.Status != ServerStatus.Starting && server.Status != ServerStatus.Reconnecting)
                            {
                                <button type="button" onclick="startServer('@server.Id')" id="btn-start-@server.Id"
                                        class="text-neon-green hover:text-neon-green/80 transition-colors mr-3 inline-flex items-center gap-1" title="Start server">
                                    <svg class="w-4 h-4" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                    Start
                                </button>
                            }
                            else if (server.Status == ServerStatus.Starting)
                            {
                                <span class="text-yellow-500 mr-3 inline-flex items-center gap-1">
                                    <svg class="w-4 h-4 animate-spin" aria-hidden="true" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                                    Starting
                                </span>
                            }
                            else if (server.Status == ServerStatus.Reconnecting)
                            {
                                <span class="text-blue-400 mr-3 inline-flex items-center gap-1">
                                    <svg class="w-4 h-4 animate-spin" aria-hidden="true" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                                    Reconnecting
                                </span>
                            }
                            <a href="/Features/Servers/Edit?Id=@server.Id" class="text-neon-cyan hover:text-neon-cyan/80 transition-colors mr-3">Edit</a>
                            <a href="/Features/Servers/Detail?id=@server.Id" class="text-text-secondary hover:text-neon-cyan transition-colors mr-3 inline-flex items-center gap-1" title="View logs">
                                <svg class="w-4 h-4" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                                Logs
                            </a>
                            <button type="button" onclick="toggleCommand('@server.Id')" aria-expanded="false" aria-controls="cmd-row-@server.Id"
                                    class="text-text-secondary hover:text-neon-cyan transition-colors inline-flex items-center gap-1" title="Show start command" aria-label="Show start command for @server.Name">
                                <svg id="cmd-icon-@server.Id" class="w-4 h-4 transform transition-transform" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<script src="~/lib/signalr/signalr.min.js"></script>
<script>
(function() {
    // SignalR connection (shared across page)
    let signalRConnection = null;

    function connectSignalR() {
        if (signalRConnection && signalRConnection.state === signalR.HubConnectionState.Connected) return;

        const connection = new signalR.HubConnectionBuilder()
            .withUrl('/serverHub', { transport: signalR.HttpTransportType.WebSockets })
            .withAutomaticReconnect()
            .build();

        connection.on('ReceiveStartupProgress', (instanceId, eventType, message, elapsedSeconds) => {
            handleStartupProgress(instanceId, eventType, message, elapsedSeconds);
        });

        connection.start().then(() => {
            console.log('[SignalR] Connected to serverHub');
        }).catch(err => {
            console.warn('[SignalR] Connection failed:', err.message);
        });

        signalRConnection = connection;
    }

    // Map event type enum values: 0=Starting, 1=ProcessStarted, 2=HealthChecking, 3=Healthy, 4=Error
    function handleStartupProgress(instanceId, eventType, message, elapsedSeconds) {
        const statusEl = document.getElementById('status-' + instanceId);

        switch (eventType) {
            case 0: // Starting
                if (statusEl) {
                    statusEl.innerHTML = '<span class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-yellow-500 animate-pulse"></span>Starting</span><div class="text-xs text-yellow-400 mt-1">' + escapeHtml(message) + '</div>';
                }
                break;
            case 1: // Process Started
                if (statusEl) {
                    statusEl.innerHTML = '<span class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-yellow-500 animate-pulse"></span>Process started</span><div class="text-xs text-yellow-400 mt-1">' + escapeHtml(message) + '</div>';
                }
                break;
            case 2: // Health Checking
                if (statusEl) {
                    statusEl.innerHTML = '<span class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-yellow-500 animate-pulse"></span>Health checking...</span><div class="text-xs text-yellow-400 mt-1">' + escapeHtml(message) + '</div>';
                }
                break;
            case 3: // Healthy / Ready
                if (statusEl) {
                    statusEl.innerHTML = '<span class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-neon-green"></span>Running</span>';
                }
                // Swap Start button for Stop button in the actions column
                const startBtn = document.getElementById('btn-start-' + instanceId);
                if (startBtn) {
                    const parentTd = startBtn.closest('td');
                    if (parentTd) {
                        const stopSvg = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"/></svg>';
                        const stopBtn = document.createElement('button');
                        stopBtn.onclick = () => window.stopServer(instanceId);
                        stopBtn.className = 'text-neon-red hover:text-neon-red/80 transition-colors mr-3 inline-flex items-center gap-1';
                        stopBtn.title = 'Stop server';
                        stopBtn.innerHTML = stopSvg + ' Stop';
                        parentTd.insertBefore(stopBtn, startBtn);
                        startBtn.remove();
                    }
                }
                break;
            case 4: // Error
                if (statusEl) {
                    statusEl.innerHTML = '<span class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-neon-red"></span>Error</span><div class="text-xs text-neon-red mt-1">' + escapeHtml(message) + '</div>';
                }
                break;
        }
    }

    window.startServer = async function(instanceId) {
        const btn = document.getElementById('btn-start-' + instanceId);
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg> Starting';
        }

        try {
            const response = await fetch('/Features/Servers/Actions', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ InstanceId: instanceId, Command: 'Start' })
            });
            const result = await response.json();
            if (!result.success) {
                alert('Failed to start server: ' + result.message);
                location.reload();
            }
            // Success — the backend returns immediately.
            // SignalR will update the status and swap Start→Stop when healthy.
        } catch (err) {
            alert('Error starting server: ' + err.message);
            location.reload();
        }
    };

    window.stopServer = async function(instanceId) {
        try {
            const response = await fetch('/Features/Servers/Actions', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ InstanceId: instanceId, Command: 'Stop' })
            });
            const result = await response.json();
            if (result.success) {
                location.reload();
            } else {
                alert('Failed to stop server: ' + result.message);
            }
        } catch (err) {
            alert('Error stopping server: ' + err.message);
        }
    };

    // Connect SignalR on page load
    connectSignalR();
})();

let expandedCommands = {};

async function toggleCommand(instanceId) {
    const rowId = 'server-row-' + instanceId;
    const cmdRowId = 'cmd-row-' + instanceId;
    const iconEl = document.getElementById('cmd-icon-' + instanceId);
    const buttonEl = iconEl.closest('button');
    let cmdRow = document.getElementById(cmdRowId);

    if (expandedCommands[instanceId]) {
        // Collapse
        expandedCommands[instanceId] = false;
        if (cmdRow) cmdRow.remove();
        iconEl.classList.remove('rotate-90');
        buttonEl.setAttribute('aria-expanded', 'false');
        return;
    }

    // Expand: remove existing detail row if any, then insert new one
    let oldCmdRow = document.getElementById(cmdRowId);
    if (oldCmdRow) oldCmdRow.remove();

    cmdRow = document.createElement('tr');
    cmdRow.id = cmdRowId;
    cmdRow.className = 'bg-cyber-bg-dark/50';
    cmdRow.innerHTML = '<td colspan="5" class="px-6 py-4"><div id="cmd-content-' + instanceId + '"><p class="text-text-secondary text-sm">Loading...</p></div></td>';

    const serverRow = document.getElementById(rowId);
    if (serverRow && serverRow.nextSibling) {
        serverRow.parentNode.insertBefore(cmdRow, serverRow.nextSibling);
    } else if (serverRow) {
        serverRow.parentNode.appendChild(cmdRow);
    }

    iconEl.classList.add('rotate-90');
    buttonEl.setAttribute('aria-expanded', 'true');
    expandedCommands[instanceId] = true;

    // Fetch command via AJAX
    try {
        const token = document.querySelector('#csrf-form input[name="__RequestVerificationToken"]')?.value || '';
        const response = await fetch('/Features/Servers/Index?handler=GetStartCommand&instanceId=' + instanceId, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token }
        });
        const result = await response.json();
        const contentEl = document.getElementById('cmd-content-' + instanceId);
        if (contentEl && result.command) {
            contentEl.innerHTML = '<p class="text-xs text-text-secondary mb-2">Start command:</p><div class="relative"><pre id="start-cmd-' + instanceId + '" class="bg-cyber-bg-dark rounded-lg p-3 border border-gray-600/30 text-xs font-mono text-text-primary overflow-x-auto whitespace-pre-wrap break-all max-h-48 overflow-y-auto"><code>' + escapeHtml(result.command) + '</code></pre><button type="button" onclick="copyCommand(\'' + instanceId + '\')" class="absolute top-2 right-2 px-2 py-1 rounded-md bg-gray-700/50 text-text-secondary hover:text-neon-cyan hover:bg-gray-600/50 transition-all text-xs flex items-center gap-1"><svg class="w-3 h-3" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>Copy</button></div>';
        } else if (contentEl) {
            contentEl.innerHTML = '<p class="text-text-secondary text-sm">No active preset configured for this server.</p>';
        }
    } catch (e) {
        const contentEl = document.getElementById('cmd-content-' + instanceId);
        if (contentEl) contentEl.innerHTML = '<p class="text-neon-red text-sm">Failed to load command: ' + escapeHtml(e.message) + '</p>';
    }
}

function copyCommand(instanceId) {
    const el = document.getElementById('start-cmd-' + instanceId);
    if (!el) return;
    navigator.clipboard.writeText(el.textContent || '').then(() => {
        const btn = el.parentElement.querySelector('button');
        if (btn) {
            const orig = btn.innerHTML;
            btn.innerHTML = '<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Copied!';
            setTimeout(() => { btn.innerHTML = orig; }, 1500);
        }
    });
}

function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
}
</script>

