@page
@using LR.Application.Pages.Features.Servers
@model ServerDetailModel
@{
    ViewData["Title"] = Model.Server?.Name ?? "Server Details";
}

<form id="csrf-form" hidden>@Html.AntiForgeryToken()</form>
@if (Model.Server == null)
{
    <div class="bg-cyber-card rounded-xl border border-neon-cyan/10 p-8 text-center">
        <p class="text-text-secondary">Server not found.</p>
        <a href="/Features/Servers" class="text-neon-cyan hover:underline mt-2 inline-block">← Back to servers</a>
    </div>
}
else
{
    @* Server Info Card *@
    <div class="bg-cyber-card rounded-xl border border-neon-cyan/10 p-6 mb-6">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-semibold text-text-primary">@Model.Server.Name</h2>
            <a href="/Features/Servers" class="text-neon-cyan hover:underline text-sm">← Back to servers</a>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div>
                <span class="text-xs text-text-secondary uppercase tracking-wider">Engine</span>
                <p class="text-sm text-text-primary mt-1">@Model.Server.Engine.ToString().Replace("LlamaCpp", "llama.cpp")</p>
            </div>
            <div>
                <span class="text-xs text-text-secondary uppercase tracking-wider">Status</span>
                <p class="flex items-center gap-2 mt-1">
                    <span aria-hidden="true" class="w-2 h-2 rounded-full
                        @if (Model.Server.Status == ServerStatus.Running) { <text>bg-neon-green</text> }
                        else if (Model.Server.Status == ServerStatus.Starting || Model.Server.Status == ServerStatus.Stopping) { <text>bg-yellow-500 animate-pulse</text> }
                        else if (Model.Server.Status == ServerStatus.Reconnecting) { <text>bg-blue-400 animate-pulse</text> }
                        else if (Model.Server.Status == ServerStatus.Error) { <text>bg-neon-red</text> }
                        else { <text>bg-gray-400</text> }"></span>
                    <span class="text-sm text-text-primary">@Model.Server.Status</span>
                </p>
            </div>
            <div>
                <span class="text-xs text-text-secondary uppercase tracking-wider">Port</span>
                <p class="text-sm text-text-primary mt-1">@Model.Server.Port</p>
            </div>
            <div>
                <span class="text-xs text-text-secondary uppercase tracking-wider">Restarts</span>
                <p class="text-sm text-text-primary mt-1">@Model.Server.RestartCount / @Model.Server.MaxRestarts</p>
            </div>
            <div>
                <span class="text-xs text-text-secondary uppercase tracking-wider">Process IDs</span>
                <p class="text-sm text-text-primary mt-1" title="Wrapper process / managed server process">
                    @(Model.WrapperPid?.ToString() ?? "—") / @(Model.ServerPid?.ToString() ?? "—")
                </p>
            </div>
        </div>

        @if (Model.Server.LastErrorMessage != null)
        {
            <div class="mt-4 p-3 rounded-lg bg-neon-red/5 border border-neon-red/20">
                <span class="text-xs text-neon-red uppercase tracking-wider">Last Error</span>
                <p class="text-sm text-text-primary mt-1">@Model.Server.LastErrorMessage</p>
                @if (Model.Server.LastErrorTime.HasValue)
                {
                    <p class="text-xs text-text-secondary mt-1">@Model.Server.LastErrorTime.Value.ToString("yyyy-MM-dd HH:mm:ss") UTC</p>
                }
            </div>
        }
    </div>

    @* Runtime Card — live slot usage + facts read from the running server's /props *@
    <div id="runtime-card" class="bg-cyber-card rounded-xl border border-neon-cyan/10 p-6 mb-6 @(Model.Server.Status == ServerStatus.Running ? "" : "hidden")" data-server-id="@Model.Server.Id">
        <h3 class="text-sm font-semibold text-text-secondary uppercase tracking-wider mb-4">Runtime</h3>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div>
                <span class="text-xs text-text-secondary uppercase tracking-wider">Slots in use</span>
                <p class="mt-1 flex items-baseline gap-1.5">
                    <span id="rt-slots" class="text-sm text-text-primary font-medium">@(Model.MaxSlots > 0 ? $"{Model.InFlight} / {Model.MaxSlots}" : "—")</span>
                </p>
                <div class="mt-1.5 h-1.5 rounded-full bg-gray-700/40 overflow-hidden">
                    <div id="rt-slots-bar" class="h-full bg-neon-cyan transition-all duration-300" style="width: @(Model.MaxSlots > 0 ? (int)Math.Round(100.0 * Math.Min(Model.InFlight, Model.MaxSlots) / Model.MaxSlots) : 0)%"></div>
                </div>
            </div>
            @{
                var ctxPct = Model.RuntimeUsage?.BusiestSlotUsageRatio is double r
                    ? Math.Clamp((int)Math.Round(r * 100.0), 0, 100)
                    : -1;
                var ctxDetail = Model.RuntimeUsage is { UsedTokens: int ut, ContextLimit: int cl } && cl > 0
                    ? $"{ut:N0} / {cl:N0} tokens across {Model.RuntimeUsage.TotalSlots ?? 0} slot(s)"
                    : null;
            }
            <div>
                <span class="text-xs text-text-secondary uppercase tracking-wider">Context used</span>
                <p class="mt-1 flex items-baseline gap-1.5">
                    <span id="rt-ctx" class="text-sm text-text-primary font-medium" title="@ctxDetail">@(ctxPct >= 0 ? $"{ctxPct}% (busiest slot)" : "—")</span>
                </p>
                <div class="mt-1.5 h-1.5 rounded-full bg-gray-700/40 overflow-hidden">
                    <div id="rt-ctx-bar" class="h-full @(ctxPct >= 90 ? "bg-neon-red" : "bg-neon-cyan") transition-all duration-300" style="width: @(ctxPct >= 0 ? ctxPct : 0)%"></div>
                </div>
            </div>
            <div>
                <span class="text-xs text-text-secondary uppercase tracking-wider">Context / slot</span>
                <p class="text-sm text-text-primary mt-1">@(Model.ServerProps?.ContextSizePerSlot?.ToString("N0") ?? "—")</p>
            </div>
            <div>
                <span class="text-xs text-text-secondary uppercase tracking-wider">Modalities</span>
                <p class="text-sm text-text-primary mt-1">
                    @{
                        var mods = new List<string> { "text" };
                        if (Model.ServerProps?.Vision == true) { mods.Add("vision"); }
                        if (Model.ServerProps?.Audio == true) { mods.Add("audio"); }
                    }
                    @string.Join(", ", mods)
                </p>
            </div>
            <div>
                <span class="text-xs text-text-secondary uppercase tracking-wider">Build</span>
                <p class="text-sm text-text-primary mt-1 truncate" title="@Model.ServerProps?.BuildInfo">@(Model.ServerProps?.BuildInfo ?? "—")</p>
            </div>
            @if (!string.IsNullOrEmpty(Model.ServerProps?.ModelPath))
            {
                <div class="col-span-2 md:col-span-4">
                    <span class="text-xs text-text-secondary uppercase tracking-wider">Loaded model</span>
                    <p class="text-sm text-text-primary mt-1 break-all">@Model.ServerProps!.ModelPath</p>
                </div>
            }
        </div>
    </div>

    @* Logs Section *@
    <div class="bg-cyber-card rounded-xl border border-neon-cyan/10 overflow-hidden">
        <div class="flex items-center justify-between px-6 py-3 border-b border-gray-700/50">
            <h3 class="text-sm font-semibold text-text-secondary uppercase tracking-wider">Logs (@Model.Logs.Count entries)</h3>
            <button type="button" onclick="clearLogs()" id="clear-btn"
                    class="text-xs px-3 py-1 rounded-lg bg-neon-red/10 text-neon-red border border-neon-red/30 hover:bg-neon-red/20 transition-all">
                Clear Logs
            </button>
        </div>

        @if (!Model.Logs.Any())
        {
            <div class="p-8 text-center text-text-secondary">No log entries yet.</div>
        }
        else
        {
            <div class="divide-y divide-gray-700/30">
                @foreach (var log in Model.Logs)
                {
                    var levelClass = log.Level switch
                    {
                        "1" => "text-neon-green",  // Info
                        "2" => "text-yellow-500",   // Warning
                        "3" => "text-neon-red",     // Error
                        _ => "text-text-secondary"
                    };

                    var levelBg = log.Level switch
                    {
                        "1" => "bg-neon-green/10 text-neon-green",
                        "2" => "bg-yellow-500/10 text-yellow-500",
                        "3" => "bg-neon-red/10 text-neon-red",
                        _ => "bg-gray-400/10 text-text-secondary"
                    };

                    var levelLabel = log.Level switch
                    {
                        "1" => "INFO",
                        "2" => "WARN",
                        "3" => "ERROR",
                        _ => log.Level
                    };

                    <div class="px-6 py-3 hover:bg-white/[0.02] transition-colors">
                        <div class="flex items-start gap-3">
                            <span class="shrink-0 px-1.5 py-0.5 rounded text-[10px] font-semibold @levelBg">@levelLabel</span>
                            <div class="min-w-0 flex-1">
                                <p class="text-sm text-text-primary break-all">@log.Message.Replace("\n", "<br/>")</p>
                                <p class="text-xs text-text-secondary mt-1">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss") UTC</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

<script>
(function () {
    const card = document.getElementById('runtime-card');
    if (!card || typeof signalR === 'undefined') return;
    const serverId = card.dataset.serverId;

    const slotsEl = document.getElementById('rt-slots');
    const barEl = document.getElementById('rt-slots-bar');
    const ctxEl = document.getElementById('rt-ctx');
    const ctxBarEl = document.getElementById('rt-ctx-bar');

    function apply(rows) {
        const row = Array.isArray(rows) ? rows.find(r => r.id === serverId) : null;
        if (!row) return;

        card.classList.toggle('hidden', row.status !== 'Running');

        if (row.maxSlots > 0) {
            slotsEl.textContent = row.inFlight + ' / ' + row.maxSlots;
            const pct = Math.round(100 * Math.min(row.inFlight, row.maxSlots) / row.maxSlots);
            barEl.style.width = pct + '%';
            barEl.classList.toggle('bg-neon-red', row.inFlight >= row.maxSlots);
            barEl.classList.toggle('bg-neon-cyan', row.inFlight < row.maxSlots);
        } else {
            slotsEl.textContent = '—';
            barEl.style.width = '0%';
        }

        // Live context (KV-cache) usage — kvUsagePct is -1 when unknown.
        if (ctxEl && ctxBarEl) {
            if (row.kvUsagePct >= 0) {
                ctxEl.textContent = row.kvUsagePct + '% (busiest slot)';
                ctxBarEl.style.width = row.kvUsagePct + '%';
                ctxBarEl.classList.toggle('bg-neon-red', row.kvUsagePct >= 90);
                ctxBarEl.classList.toggle('bg-neon-cyan', row.kvUsagePct < 90);
            } else {
                ctxEl.textContent = '—';
                ctxBarEl.style.width = '0%';
            }
        }
    }

    // Reuse the shared serverHub connection if the app already opened one, else make our own.
    let connection = window.__serverHubConnection;
    if (!connection) {
        connection = new signalR.HubConnectionBuilder()
            .withUrl('/serverHub', { transport: signalR.HttpTransportType.WebSockets })
            .withAutomaticReconnect()
            .build();
        window.__serverHubConnection = connection;
        connection.start().catch(err => console.warn('[SignalR] serverHub connect failed:', err.message));
    }

    // Detach a stale handler from a previous detail visit (htmx-boosted nav keeps the socket).
    if (window.__detailServerLoadHandler) {
        connection.off('ReceiveServerLoad', window.__detailServerLoadHandler);
    }
    window.__detailServerLoadHandler = apply;
    connection.on('ReceiveServerLoad', apply);
})();

async function clearLogs() {
    if (!confirm('Clear all log entries for this server?')) return;
    try {
        const response = await fetch(window.location.href, {
            method: 'POST',
            headers: { 'RequestVerificationToken': document.querySelector('#csrf-form input[name=\"__RequestVerificationToken\"]')?.value },
            body: new URLSearchParams({ '__page': 'Detail' })
        });
        const data = await response.json();
        if (data.success) {
            location.reload();
        }
    } catch (e) {
        alert('Failed to clear logs: ' + e.message);
    }
}
</script>
