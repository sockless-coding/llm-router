@page
@using LR.Application.Pages.Features.Presets
@model PresetsListModel
@{
    ViewData["Title"] = "Presets";
}

@functions {
    string Truncate(string? s, int max)
        => (s?.Length ?? 0) > max ? s[..(max - 3)] + "..." : (s ?? "");
}

<form id="csrf-form" hidden>@Html.AntiForgeryToken()</form>
<div class="flex items-center justify-between mb-6">
    <p class="text-gray-400">Manage model presets for your server instances.</p>
    <a href="/Features/Presets/Create" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-neon-magenta/10 text-neon-magenta border border-neon-magenta/30 hover:bg-neon-magenta/20 transition-all text-sm font-medium">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" /></svg>
        New Preset
    </a>
</div>

@if (!Model.Presets.Any())
{
    <div class="text-center py-16 bg-cyber-card rounded-xl border border-neon-cyan/10">
        <svg class="w-12 h-12 mx-auto text-gray-500 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
        <p class="text-gray-400">No presets configured</p>
        <p class="text-gray-500 text-sm mt-1">Create a preset to define model configurations for your servers.</p>
    </div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        @foreach (var preset in Model.Presets)
        {
            var server = Model.Servers.FirstOrDefault(s => s.Id == preset.ServerInstanceId);
            bool isRunning = server?.Status == ServerStatus.Running;
            bool isActivePreset = server != null && server.ActivePresetId == preset.Id;

            <div class="bg-cyber-card rounded-xl p-5 border border-neon-magenta/10 hover:border-neon-magenta/30 transition-all">
                <div class="flex items-center justify-between mb-2">
                    <h3 class="text-base font-semibold text-gray-100">@preset.Name</h3>
                    @if (server != null)
                    {
                        <span class="flex items-center gap-1.5 text-xs" title="@server.Name — @(server.Status)">
                            <span class="w-2 h-2 rounded-full
                                @if (server.Status == ServerStatus.Running) { <text>bg-neon-green</text> }
                                else if (server.Status == ServerStatus.Starting || server.Status == ServerStatus.Stopping) { <text>bg-yellow-500 animate-pulse</text> }
                                else if (server.Status == ServerStatus.Error) { <text>bg-neon-red</text> }
                                else { <text>bg-gray-400</text> }"></span>
                            @server.Name
                        </span>
                    }
                </div>

                @if (isActivePreset && isRunning)
                {
                    <span class="inline-block mb-3 text-xs px-2 py-0.5 rounded bg-neon-green/10 text-neon-green border border-neon-green/20">Active &amp; Running</span>
                }

                <div class="space-y-1 text-sm">
                    <p><span class="text-gray-400">Model:</span> @Truncate(preset.ModelPath, 80)</p>
                    <p><span class="text-gray-400">Context Size:</span> @(preset.ContextSize?.ToString() ?? "auto")</p>
                    <p><span class="text-gray-400">GPU Layers:</span> @(preset.GpuLayers?.ToString() ?? "auto")</p>
                </div>

                <div class="flex items-center gap-2 pt-3 mt-3 border-t border-gray-700/50">
                    @if (isRunning && isActivePreset)
                    {
                        <span class="text-xs px-3 py-1.5 rounded-md bg-neon-green/10 text-neon-green font-medium cursor-default">Running</span>
                    }
                    else if (!isRunning || !isActivePreset)
                    {
                        var isStartingStopping = server?.Status == ServerStatus.Starting || server?.Status == ServerStatus.Stopping;
                        <button type="button"
                                onclick="@if (!isStartingStopping) { <text>startPreset('@preset.Id', '@preset.Name')</text> }"
                                class="text-xs px-3 py-1.5 rounded-md bg-neon-green/10 text-neon-green hover:bg-neon-green/20 transition-all font-medium"
                                disabled="@isStartingStopping">
                            @(isRunning && !isActivePreset ? "Restart with this preset" : isStartingStopping ? "Processing..." : "Start")
                        </button>
                    }

                    <a href="/Features/Presets/Edit?Id=@preset.Id"
                       class="text-xs px-3 py-1.5 rounded-md bg-neon-magenta/10 text-neon-magenta hover:bg-neon-magenta/20 transition-all font-medium">
                        Edit
                    </a>
                    <button type="button" onclick="deletePreset('@preset.Id', '@preset.Name')"
                            class="text-xs px-3 py-1.5 rounded-md bg-red-500/10 text-red-400 hover:bg-red-500/20 transition-all font-medium">
                        Delete
                    </button>
                </div>
            </div>
        }
    </div>
}

<script>
async function startPreset(presetId, name) {
    const token = document.querySelector('#csrf-form input[name="__RequestVerificationToken"]')?.value || '';
    try {
        const formData = new FormData();
        formData.append('PresetId', presetId);
        formData.append('Command', 'Start');
        formData.append('__RequestVerificationToken', token);

        const resp = await fetch('/Features/Presets/Actions', { method: 'POST', body: formData });
        const result = await resp.json();
        if (resp.ok) {
            location.reload();
        } else {
            alert(result.message || 'Failed to start preset.');
        }
    } catch (e) {
        alert('Start failed: ' + e.message);
    }
}

async function deletePreset(id, name) {
    if (!confirm(`Delete preset "${name}"? This cannot be undone.`)) return;
    const token = document.querySelector('#csrf-form input[name="__RequestVerificationToken"]')?.value || '';
    try {
        const resp = await fetch(`/Features/Presets/Index?handler=Delete&id=${id}`, { method: 'POST', headers: { 'RequestVerificationToken': token } });
        if (resp.ok) location.reload();
    } catch (e) {
        alert('Delete failed.');
    }
}
</script>

