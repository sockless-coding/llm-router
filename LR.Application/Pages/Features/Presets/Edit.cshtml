@page
@using LR.Application.Pages.Features.Presets
@model PresetEditModel
@{
    ViewData["Title"] = "Edit Preset";
}

<div class="max-w-4xl mx-auto">
    <form method="post" hx-boost="false" class="space-y-6">
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="bg-red-500/10 border border-red-500/30 rounded-xl p-4 space-y-2" role="alert">
                <h3 class="text-sm font-semibold text-red-400">Please fix the following errors:</h3>
                <ul class="list-disc list-inside text-sm text-red-300 space-y-1">
                    @foreach (var entry in ViewData.ModelState.Values.Where(e => e?.Errors != null && e.Errors.Any()))
                    {
                        @foreach (var error in entry.Errors)
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    }
                </ul>
            </div>
        }

        <partial name="_PresetForm" model="Model" />

        <!-- ==================== ACTIONS ==================== -->
        <div class="flex items-center gap-3">
            <button type="submit"
                    class="px-6 py-2.5 rounded-lg bg-neon-magenta/10 text-neon-magenta border border-neon-magenta/30 hover:bg-neon-magenta/20 transition-all font-medium text-sm shadow-neon-magenta">
                Save Changes
            </button>
            <a href="/Features/Presets/Index"
               class="px-6 py-2.5 rounded-lg bg-gray-700/30 text-text-secondary border border-gray-600/20 hover:bg-gray-700/50 transition-all font-medium text-sm">
                Cancel
            </a>
        </div>
    </form>
</div>
