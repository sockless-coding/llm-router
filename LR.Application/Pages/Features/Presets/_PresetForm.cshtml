<script>
(function () {
    const select = document.getElementById('model-select');
    const info = document.getElementById('model-gguf-info');
    const ctxInput = document.getElementById('context-size-input');
    if (!select || !info) return;

    function badge(label, value) {
        return `<span class="text-xs px-2 py-0.5 rounded bg-neon-cyan/10 text-neon-cyan border border-neon-cyan/20">${label}: ${value}</span>`;
    }

    function render() {
        const opt = select.options[select.selectedIndex];
        const arch = opt?.dataset.arch;
        const params = opt?.dataset.params;
        const quant = opt?.dataset.quant;
        const context = opt?.dataset.context;

        if (!opt || !opt.value || (!arch && !params && !quant && !context)) {
            info.classList.add('hidden');
            info.innerHTML = '';
            if (ctxInput) ctxInput.placeholder = 'from model';
            return;
        }

        let html = '';
        if (arch) html += badge('Arch', arch);
        if (params) html += badge('Params', params);
        if (quant) html += badge('Quant', quant);
        if (context) html += badge('Context', context);
        info.innerHTML = html;
        info.classList.remove('hidden');

        if (ctxInput) ctxInput.placeholder = context ? `from model (${context})` : 'from model';
    }

    select.addEventListener('change', render);
    render();
})();
</script>

