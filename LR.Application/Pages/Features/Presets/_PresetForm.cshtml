        <!-- ==================== ADVANCED: Generation ==================== -->
        <details id="section-generation" class="bg-cyber-card rounded-xl border border-gray-600/20 group scroll-mt-24">
            <summary class="cursor-pointer px-6 py-4 text-lg font-semibold text-text-primary hover:text-neon-magenta transition-colors [&::-webkit-details-marker]:hidden flex items-center gap-2">
                <svg class="w-5 h-5 group-open:rotate-90 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                Advanced: Generation
            </summary>
            <div class="px-6 pb-6 space-y-4">
                <div class="grid grid-cols-3 gap-4">
                    <div>
                        <label asp-for="ViewModel.Threads" class="block text-sm font-medium text-text-secondary mb-1"></label>
                        <input asp-for="ViewModel.Threads" type="number" placeholder="auto" class="@inpCls" />
                    </div>
                    <div>
                        <label asp-for="ViewModel.ThreadsBatch" class="block text-sm font-medium text-text-secondary mb-1"></label>
                        <input asp-for="ViewModel.ThreadsBatch" type="number" placeholder="auto" class="@inpCls" />
