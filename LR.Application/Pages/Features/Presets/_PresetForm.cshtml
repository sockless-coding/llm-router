@model LR.Application.Pages.Features.Presets.IPresetFormPageModel
@inject LR.Core.Interfaces.IEngineCatalog EngineCatalog
@using LR.Core.Services.EngineBuilds
@{
    // The settings section of each server's engine: an engine with its own section (Strata,
    // stable-diffusion.cpp) shows only Identity and that section; llama.cpp ("") shows the typed sections.
    var sectionByServerJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Servers.ToDictionary(s => s.Id.ToString(), s => EngineCatalog.Get(s.Engine)?.PresetFormSection ?? ""));
    var engineSectionsJson = System.Text.Json.JsonSerializer.Serialize(
        EngineCatalog.All.Select(e => e.PresetFormSection).OfType<string>().Distinct());
    string Strata(string key) => Model.ViewModel.EngineSettings.GetValueOrDefault(key) ?? "";
    string Sd(string key) => Model.ViewModel.EngineSettings.GetValueOrDefault(key) ?? "";
    bool SdFlag(string key) => bool.TryParse(Sd(key), out var on) && on;
    string Vllm(string key) => Model.ViewModel.EngineSettings.GetValueOrDefault(key) ?? "";
    bool VllmFlag(string key) => bool.TryParse(Vllm(key), out var on) && on;
    string Tf(string key) => Model.ViewModel.EngineSettings.GetValueOrDefault(key) ?? "";
    // What the model path means differs per engine (a GGUF for llama.cpp, a run config for Strata);
    // the help under the manual path follows the selected server.
    var modelPathHelpJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Servers.ToDictionary(s => s.Id.ToString(), s => EngineCatalog.Get(s.Engine)?.ModelPathHelp ?? "")
    ).Replace("</", "<\\/");
    var agentByServerJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Servers.ToDictionary(s => s.Id.ToString(), s => s.AgentId?.ToString() ?? ""));
    // The library picker offers only models the selected server's engine can run (ModelEngineSupport).
    var engineByServerJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Servers.ToDictionary(s => s.Id.ToString(), s => s.Engine.ToString()));
    var inpCls = "w-full px-3 py-2 rounded-lg bg-cyber-bg-dark border border-gray-600/30 text-text-primary focus:border-neon-magenta focus:ring-1 focus:ring-neon-magenta/30 outline-none transition-all placeholder-gray-500";
    var selCls = "w-full px-3 py-2 rounded-lg bg-cyber-bg-dark border border-gray-600/30 text-text-primary focus:border-neon-magenta focus:ring-1 focus:ring-neon-magenta/30 outline-none transition-all";
    var detectedVarsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.DetectedTemplateVariables.Select(v => new { name = v.Name, literalValues = v.LiteralValues })
    ).Replace("</", "<\\/");
    // For each library model that is a known diffusion family's main model: the VAE/encoders from the
    // library it pairs with, the family's generation defaults, and what's still missing. Picking the
    // model fills them into the Diffusion section.
    var sdSuggestionsJson = System.Text.Json.JsonSerializer.Serialize(new
    {
        labels = StableDiffusionPresetSettings.ComponentFiles.ToDictionary(c => c.Key, c => c.Label),
        models = Model.Models
            .Select(m => (m.Id, Suggestion: DiffusionModelGuide.ForPreset(m, Model.Models)))
            .Where(x => x.Suggestion is not null)
            .ToDictionary(x => x.Id.ToString(), x => new
            {
                family = x.Suggestion!.Family.Name,
                modelRole = x.Suggestion.Family.ModelRole,
                files = x.Suggestion.Files,
                defaults = x.Suggestion.Family.Defaults,
                note = x.Suggestion.Family.Note,
                missing = x.Suggestion.Missing.Select(p => new
                {
                    key = p.SettingKey,
                    label = p.Label,
                    sourceRepo = p.SourceRepo,
                    sourceUrl = LR.Application.Pages.Features.Models.ModelsHuggingFaceModel.BrowseRepoUrl(p.SourceRepo, p.SourceFormat),
                    hint = p.Hint,
                }),
            }),
    }).Replace("</", "<\\/");
}

        <!-- ==================== IDENTITY ==================== -->
        <div id="section-identity" class="bg-cyber-card rounded-xl p-6 border border-neon-magenta/10 space-y-4 scroll-mt-24">
            <h2 class="text-lg font-semibold text-text-primary">Identity</h2>

            <!-- Server Instance -->
            <div>
                <label asp-for="ViewModel.ServerInstanceId" class="block text-sm font-medium text-text-secondary mb-1"></label>
                <select asp-for="ViewModel.ServerInstanceId" asp-items="@(new SelectList(Model.Servers, "Id", "Name"))"
                        class="@selCls @Html.Raw(ViewData.ModelState["ViewModel.ServerInstanceId"]?.Errors?.Any() == true ? "border-red-500/60" : "")">
                    <option value="">— Select a server —</option>
                </select>
                <span asp-validation-for="ViewModel.ServerInstanceId" class="text-xs text-red-400"></span>
            </div>

            <!-- Name -->
            <div>
                <label asp-for="ViewModel.Name" class="block text-sm font-medium text-text-secondary mb-1"></label>
                <input asp-for="ViewModel.Name" required placeholder="e.g. llama-3-cuda"
                       class="@inpCls @Html.Raw(ViewData.ModelState["ViewModel.Name"]?.Errors?.Any() == true ? "border-red-500/60" : "")" />
                <span asp-validation-for="ViewModel.Name" class="text-xs text-red-400"></span>
            </div>

            <!-- Aliases -->
            <div>
                <label asp-for="ViewModel.Aliases" class="block text-sm font-medium text-text-secondary mb-1">Aliases</label>
                <textarea asp-for="ViewModel.Aliases" rows="2" placeholder="e.g. gpt-4o, claude-*"
                          class="@inpCls font-mono text-sm @Html.Raw(ViewData.ModelState["ViewModel.Aliases"]?.Errors?.Any() == true ? "border-red-500/60" : "")"></textarea>
                <p class="text-xs text-text-secondary mt-1">
                    Other model names that route to this preset, comma-separated or one per line — for clients with a hardcoded model id.
                    <code>*</code> matches anything (<code>claude-*</code>). Case-insensitive; a preset's own name always takes precedence.
                </p>
                <span asp-validation-for="ViewModel.Aliases" class="text-xs text-red-400"></span>
            </div>

            <!-- Fallback -->
            <div>
                <label asp-for="ViewModel.FallbackPresetId" class="block text-sm font-medium text-text-secondary mb-1">Fallback preset</label>
                <select asp-for="ViewModel.FallbackPresetId" class="@selCls">
                    <option value="">— None —</option>
                    @foreach (var p in Model.FallbackCandidates.OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase))
                    {
                        var server = Model.Servers.FirstOrDefault(s => s.Id == p.ServerInstanceId)?.Name ?? "unknown server";
                        <option value="@p.Id" selected="@(Model.ViewModel.FallbackPresetId == p.Id)">@p.Name (@server)</option>
                    }
                </select>
                <p class="text-xs text-text-secondary mt-1">
                    Serves this preset's requests when its server is errored, or overflows to it when this one is at capacity and the fallback is already loaded.
                    Must be on a different server to take effect. Fallbacks chain.
                </p>
            </div>

            <!-- Keep loaded -->
            <div>
                <label class="flex items-center gap-2 text-sm font-medium text-text-secondary">
                    <input asp-for="ViewModel.KeepLoaded" type="checkbox" class="rounded border-gray-600/30 bg-cyber-bg-dark text-neon-magenta focus:ring-neon-magenta/30" />
                    Keep loaded
                </label>
                <p class="text-xs text-text-secondary mt-1">
                    While this preset is loaded, its server is never stopped automatically: not by the server's idle unload, and not to make room in its memory group.
                    A request for a different preset on the same server still swaps it out.
                </p>
            </div>

            <!-- Memory estimate override -->
            <div>
                <label asp-for="ViewModel.MemoryEstimateMb" class="block text-sm font-medium text-text-secondary mb-1">Memory estimate (MB)</label>
                <input asp-for="ViewModel.MemoryEstimateMb" type="number" min="0" placeholder="Estimated automatically" class="@inpCls" />
                <p class="text-xs text-text-secondary mt-1">
                    Device memory this preset uses once loaded, for the server's memory-group budget. Leave empty to estimate it from the model files and KV cache.
                    The server's edit page shows the current estimate.
                </p>
                <span asp-validation-for="ViewModel.MemoryEstimateMb" class="text-xs text-red-400"></span>
            </div>

            <!-- Model -->
            <div id="model-library-field">
                <label asp-for="ViewModel.ModelId" class="block text-sm font-medium text-text-secondary mb-1">Model</label>
                <select asp-for="ViewModel.ModelId" id="model-select" class="@selCls">
                    <option value="">— Select a model from the library —</option>
                    @foreach (var m in Model.Models)
                    {
                        <option value="@m.Id"
                                data-agent="@(m.AgentId?.ToString() ?? "")"
                                data-engines="@string.Join(',', LR.Core.Services.ModelEngineSupport.For(m))"
                                data-arch="@m.Architecture"
                                data-params="@m.ParameterSize"
                                data-quant="@m.QuantizationLevel"
                                data-context="@m.ContextLength"
                                data-filesize="@m.FileSizeBytes"
                                data-blocks="@m.BlockCount"
                                data-heads="@m.HeadCount"
                                data-kvheads="@m.KvHeadCount"
                                data-embed="@m.EmbeddingLength"
                                selected="@(Model.ViewModel.ModelId == m.Id)">@m.Name</option>
                    }
                </select>
                <div id="model-gguf-info" class="hidden mt-2 flex flex-wrap gap-1.5"></div>
                <p class="text-xs text-text-secondary mt-1">
                    Don't see your model? <a href="/Features/Models/Create" class="text-neon-cyan hover:underline">Import it into the library</a>,
                    or enter a path manually below.
                </p>
                <span asp-validation-for="ViewModel.ModelPath" class="text-xs text-red-400"></span>
            </div>

            <details id="model-path-details" class="group" open="@(!Model.ViewModel.ModelId.HasValue)">
                <summary id="model-path-summary" class="cursor-pointer text-sm text-text-secondary hover:text-neon-magenta transition-colors [&::-webkit-details-marker]:hidden flex items-center gap-2">
                    <svg class="w-4 h-4 group-open:rotate-90 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                    Advanced: override path manually
                </summary>
                <div class="pt-3">
                    <input asp-for="ViewModel.ModelPath" placeholder="/path/to/model.gguf (overrides the model selected above)"
                           class="@inpCls @Html.Raw(ViewData.ModelState["ViewModel.ModelPath"]?.Errors?.Any() == true ? "border-red-500/60" : "")" />
                    <p id="model-path-help" class="text-xs text-text-secondary mt-1"></p>
                </div>
            </details>
            <script>
                (() => {
                    const helpByServer = @Html.Raw(modelPathHelpJson);
                    // A server on a remote agent can only use that agent's models (and a local one only local models).
                    const agentByServer = @Html.Raw(agentByServerJson);
                    const engineByServer = @Html.Raw(engineByServerJson);
                    const filterModelsForServer = () => {
                        const agent = agentByServer[serverSelect.value] || '';
                        const engine = engineByServer[serverSelect.value] || '';
                        document.querySelectorAll('#model-select option[data-agent], #spec-draft-model-select option[data-agent], #mmproj-select option[data-agent], #sd-model-files option[data-agent], #tf-drafter-library option[data-agent]').forEach(opt => {
                            // The main model must also be one the server's engine runs (a checkpoint for TensorFold, a GGUF for llama.cpp).
                            // The preset's saved model always stays pickable, so opening it never drops the link.
                            const wrongEngine = engine && opt.dataset.engines !== undefined && !opt.defaultSelected && !opt.dataset.engines.split(',').includes(engine);
                            const foreign = (opt.dataset.agent || '') !== agent || wrongEngine;
                            opt.hidden = foreign;
                            opt.disabled = foreign;
                        });
                        for (const id of ['model-select', 'spec-draft-model-select', 'mmproj-select']) {
                            const sel = document.getElementById(id);
                            if (sel && sel.selectedOptions[0]?.disabled) sel.value = '';
                        }
                    };
                    const serverSelect = document.getElementById('ViewModel_ServerInstanceId');
                    const help = document.getElementById('model-path-help');
                    const sectionByServer = @Html.Raw(sectionByServerJson);
                    const engineSections = new Set(@Html.Raw(engineSectionsJson));
                    // Sections that don't apply to the selected server's engine are hidden (their
                    // values are kept and still saved, so switching back loses nothing). An engine
                    // with its own section shows just that one; llama.cpp shows every other section.
                    const update = () => {
                        help.textContent = helpByServer[serverSelect.value] || '';
                        filterModelsForServer();
                        const own = sectionByServer[serverSelect.value] || '';
                        const visible = id => id === 'section-identity' || (own ? id === own : !engineSections.has(id));
                        document.querySelectorAll('[id^="section-"]').forEach(el => el.classList.toggle('hidden', !visible(el.id)));
                        document.querySelectorAll('.preset-nav-link').forEach(a => a.classList.toggle('hidden', !visible(a.dataset.section)));

                        // A vLLM model is a Hugging Face id (filled in by a recipe), so its library picker gives way
                        // to the plain model field. TensorFold takes either: a checkpoint from the library, or a repo id.
                        const isVllm = own === 'section-vllm';
                        const isTensorFold = own === 'section-tensorfold';
                        const byModelId = isVllm || isTensorFold;
                        const modelSelect = document.getElementById('model-select');
                        const pathInput = document.getElementById('ViewModel_ModelPath');
                        document.getElementById('model-library-field').classList.toggle('hidden', isVllm);
                        document.getElementById('model-path-summary').classList.toggle('hidden', isVllm);
                        pathInput.placeholder = isVllm ? 'Qwen/Qwen3-8B, or a model folder (filled in by applying a recipe)'
                            : isTensorFold ? 'TensorFold/Qwen3.8-27B-MLX-4bit, owner/name@revision, or a checkpoint folder'
                            : '/path/to/model.gguf (overrides the model selected above)';
                        if (isVllm && modelSelect.value) { modelSelect.value = ''; modelSelect.dispatchEvent(new Event('change', { bubbles: true })); }
                        if (byModelId && !modelSelect.value) document.getElementById('model-path-details').open = true;
                        if (isVllm) window.__vllmRecipesActivate?.();
                    };
                    serverSelect.addEventListener('change', update);
                    // Called again once the rest of the form and the section nav exist (end of _PresetFormNav).
                    window.__presetEngineUpdate = update;
                    update();
                })();
            </script>
        </div>

        <!-- ==================== STRATA (Strata servers only) ==================== -->
        <div id="section-strata" class="hidden bg-cyber-card rounded-xl p-6 border border-neon-cyan/10 space-y-4 scroll-mt-24">
            <h2 class="text-lg font-semibold text-text-primary">Strata</h2>
            <p class="text-xs text-text-secondary">
                The first start of this preset prepares its model for Strata with Strata's own setup — the model's pack, the shared ~5 GB
                MTP draft layer, and a run config tuned to this PC — which can take several minutes; later starts are quick. It runs again when
                the model, these settings or the Strata install change. Leave a setting blank to take Strata's recommendation for this PC.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="strata-context" class="block text-sm font-medium text-text-secondary mb-1">Context length</label>
                    <input id="strata-context" name="ViewModel.EngineSettings[@StrataPresetSettings.Context]" value="@Strata(StrataPresetSettings.Context)"
                           list="strata-contexts" inputmode="numeric" placeholder="recommended for this GPU" class="@inpCls" />
                    <datalist id="strata-contexts">
                        @foreach (var c in StrataPresetSettings.SuggestedContexts)
                        {
                            <option value="@c">@(c / 1024)K@(c > 262144 ? " (rope scaling, experimental)" : "")</option>
                        }
                    </datalist>
                    <p class="text-xs text-text-secondary mt-1">Tokens. Longer needs more VRAM, leaving fewer experts on the GPU.</p>
                </div>
                <div>
                    <label for="strata-gpu" class="block text-sm font-medium text-text-secondary mb-1">GPU</label>
                    <input id="strata-gpu" name="ViewModel.EngineSettings[@StrataPresetSettings.Gpu]" value="@Strata(StrataPresetSettings.Gpu)"
                           type="number" min="0" placeholder="setup picks" class="@inpCls" />
                    <p class="text-xs text-text-secondary mt-1">One GPU, numbered as <span class="font-mono">nvidia-smi</span> numbers them.</p>
                </div>
                <div>
                    <label for="strata-vision" class="block text-sm font-medium text-text-secondary mb-1">Images</label>
                    <select id="strata-vision" name="ViewModel.EngineSettings[@StrataPresetSettings.Vision]" class="@selCls">
                        <option value="">Recommended (no images)</option>
                        <option value="gpu" selected="@(Strata(StrataPresetSettings.Vision) == "gpu")">Image encoder on the GPU</option>
                        <option value="cpu" selected="@(Strata(StrataPresetSettings.Vision) == "cpu")">Image encoder on the CPU</option>
                        <option value="none" selected="@(Strata(StrataPresetSettings.Vision) == "none")">No images</option>
                    </select>
                    <p class="text-xs text-text-secondary mt-1">The encoder is downloaded if it isn't next to the model.</p>
                </div>
                <div>
                    <label for="strata-kv" class="block text-sm font-medium text-text-secondary mb-1">KV cache</label>
                    <select id="strata-kv" name="ViewModel.EngineSettings[@StrataPresetSettings.Kv]" class="@selCls">
                        <option value="">Recommended</option>
                        <option value="int8" selected="@(Strata(StrataPresetSettings.Kv) == "int8")">int8</option>
                        <option value="k8v4" selected="@(Strata(StrataPresetSettings.Kv) == "k8v4")">k8v4 (8-bit K, 4-bit V)</option>
                        <option value="q4_0" selected="@(Strata(StrataPresetSettings.Kv) == "q4_0")">q4_0</option>
                    </select>
                </div>
                <div>
                    <label for="strata-lowram" class="block text-sm font-medium text-text-secondary mb-1">Low-RAM mode</label>
                    <select id="strata-lowram" name="ViewModel.EngineSettings[@StrataPresetSettings.LowRam]" class="@selCls">
                        <option value="">Automatic (when the model doesn't fit in RAM)</option>
                        <option value="on" selected="@(Strata(StrataPresetSettings.LowRam) == "on")">On</option>
                        <option value="off" selected="@(Strata(StrataPresetSettings.LowRam) == "off")">Off</option>
                        <option value="resident" selected="@(Strata(StrataPresetSettings.LowRam) == "resident")">Resident (experts kept in RAM)</option>
                        <option value="mmap" selected="@(Strata(StrataPresetSettings.LowRam) == "mmap")">Mapped (experts read through the file cache)</option>
                    </select>
                    <p class="text-xs text-text-secondary mt-1">Writes the experts into one file the first time (35–77 GB).</p>
                </div>
                <div>
                    <label for="strata-parallel" class="block text-sm font-medium text-text-secondary mb-1">Parallel requests</label>
                    <input id="strata-parallel" name="ViewModel.EngineSettings[@StrataPresetSettings.Parallel]" value="@Strata(StrataPresetSettings.Parallel)"
                           type="number" min="1" placeholder="1" class="@inpCls" />
                    <p class="text-xs text-text-secondary mt-1">Each extra slot leaves fewer experts in VRAM.</p>
                </div>
            </div>
        </div>

        <!-- ==================== vLLM (vLLM servers only) ==================== -->
        <div id="section-vllm" class="hidden bg-cyber-card rounded-xl p-6 border border-neon-cyan/10 space-y-6 scroll-mt-24">
            <div class="space-y-1">
                <h2 class="text-lg font-semibold text-text-primary">vLLM</h2>
                <p class="text-xs text-text-secondary">
                    How <span class="font-mono">vllm serve</span> runs this preset's model. Leave a setting blank for vLLM's default.
                    The first start downloads the model from Hugging Face into the cache of the machine the server runs on, which can take a long time.
                </p>
            </div>

            <!-- Recipe pickers: fill in the fields below from a saved recipe or from recipes.vllm.ai; nothing is stored until the preset is saved. -->
            <div class="rounded-lg border border-neon-cyan/20 bg-cyber-bg-dark/40 p-4 space-y-3">
                <div>
                    <div class="flex items-center justify-between gap-2 mb-1">
                        <label for="vllm-saved-recipe" class="block text-sm font-medium text-text-secondary">Start from a saved recipe</label>
                        <a href="/Features/Models/Vllm" class="text-xs text-neon-cyan hover:underline" target="_blank" rel="noopener">Manage vLLM models and recipes</a>
                    </div>
                    <select id="vllm-saved-recipe" class="@selCls text-sm">
                        <option value="">Loading saved recipes…</option>
                    </select>
                    <p class="text-xs text-text-secondary mt-1">Recipes saved in the model library, per model and hardware. Picking one replaces the settings below and the model.</p>
                </div>

                <div class="pt-2 border-t border-gray-700/30">
                    <label for="vllm-recipe-search" class="block text-sm font-medium text-text-secondary mb-1">Or load one from recipes.vllm.ai</label>
                    <div class="flex gap-2">
                        <input id="vllm-recipe-search" list="vllm-recipe-list" autocomplete="off" placeholder="Search recipes.vllm.ai, e.g. Qwen/Qwen3-8B" class="@inpCls font-mono text-sm" />
                        <datalist id="vllm-recipe-list"></datalist>
                        <button type="button" id="vllm-recipe-load" class="px-3 py-2 rounded-lg bg-neon-cyan/10 text-neon-cyan border border-neon-cyan/30 hover:bg-neon-cyan/20 transition-all text-sm font-medium shrink-0">Load</button>
                    </div>
                    <p id="vllm-recipe-status" class="text-xs text-text-secondary mt-1" role="status">
                        @if (!string.IsNullOrEmpty(Vllm(VllmPresetSettings.SavedRecipeName)))
                        {
                            <text>Filled in from the saved recipe <span class="font-medium">@Vllm(VllmPresetSettings.SavedRecipeName)</span>. Changing that recipe later doesn't change this preset; pick it again to update.</text>
                        }
                        else if (!string.IsNullOrEmpty(Vllm(VllmPresetSettings.RecipeId)))
                        {
                            <text>Filled in from the recipe for <span class="font-mono">@Vllm(VllmPresetSettings.RecipeId)</span> (@Vllm(VllmPresetSettings.RecipeHardware), @Vllm(VllmPresetSettings.RecipeVariant)). A saved preset doesn't need the recipe site to start.</text>
                        }
                        else
                        {
                            <text>Recipes are vLLM's tested settings per model and GPU. Their command fills in the fields below for you to review.</text>
                        }
                    </p>
                </div>

                <div id="vllm-recipe-options" class="hidden space-y-3">
                    <p id="vllm-recipe-description" class="text-xs text-text-secondary"></p>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                        <div>
                            <label for="vllm-recipe-variant" class="block text-xs font-medium text-text-secondary mb-1">Variant</label>
                            <select id="vllm-recipe-variant" class="@selCls text-sm"></select>
                        </div>
                        <div>
                            <label for="vllm-recipe-hardware" class="block text-xs font-medium text-text-secondary mb-1">Hardware</label>
                            <select id="vllm-recipe-hardware" class="@selCls text-sm"></select>
                        </div>
                        <div>
                            <label for="vllm-recipe-strategy" class="block text-xs font-medium text-text-secondary mb-1">Strategy</label>
                            <select id="vllm-recipe-strategy" class="@selCls text-sm"></select>
                        </div>
                    </div>
                    <fieldset id="vllm-recipe-features" class="space-y-1">
                        <legend class="text-xs font-medium text-text-secondary mb-1">Features</legend>
                    </fieldset>
                    <button type="button" id="vllm-recipe-apply" class="px-3 py-2 rounded-lg bg-neon-cyan/10 text-neon-cyan border border-neon-cyan/30 hover:bg-neon-cyan/20 transition-all text-sm font-medium">Fill in the preset</button>
                </div>

                <div class="pt-2 border-t border-gray-700/30">
                    <button type="button" id="vllm-qwen38-profile" class="px-3 py-1.5 rounded-lg bg-neon-cyan/10 text-neon-cyan border border-neon-cyan/30 hover:bg-neon-cyan/20 transition-all text-xs font-medium">Fill in Qwen3.8 on Arc Pro B70</button>
                    <p class="text-xs text-text-secondary mt-1">For an Intel (XPU, Docker) install and a Qwen3.8-27B GPTQ INT4 model: MTP with 4 speculative tokens, 100K context, low reasoning by default. Replaces the settings below; the model stays as you entered it.</p>
                </div>

                @{ var startingWarnings = (Model as PresetCreateModel)?.StartingRecipeWarnings ?? []; }
                <div id="vllm-recipe-warnings" class="@(startingWarnings.Count == 0 ? "hidden " : "")rounded-lg border border-amber-400/30 bg-amber-400/5 p-3">
                    <p class="text-xs font-medium text-amber-400 mb-1">Check before saving</p>
                    <ul id="vllm-recipe-warning-list" class="list-disc pl-4 space-y-1 text-xs text-text-secondary">
                        @foreach (var w in startingWarnings)
                        {
                            <li>@w</li>
                        }
                    </ul>
                </div>
            </div>

            @foreach (var key in VllmPresetSettings.ProvenanceKeys)
            {
                <input type="hidden" name="ViewModel.EngineSettings[@key]" value="@Vllm(key)" />
            }

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="vllm-max-len" class="block text-sm font-medium text-text-secondary mb-1">Max context length</label>
                    <input id="vllm-max-len" name="ViewModel.EngineSettings[@VllmPresetSettings.MaxModelLen]" value="@Vllm(VllmPresetSettings.MaxModelLen)" placeholder="from the model's config" class="@inpCls" />
                    <p class="text-xs text-text-secondary mt-1"><span class="font-mono">--max-model-len</span>: 32768, 32k or auto. Lower it if the model doesn't fit a small GPU.</p>
                </div>
                <div>
                    <label for="vllm-gmu" class="block text-sm font-medium text-text-secondary mb-1">GPU memory share</label>
                    <input id="vllm-gmu" name="ViewModel.EngineSettings[@VllmPresetSettings.GpuMemoryUtilization]" value="@Vllm(VllmPresetSettings.GpuMemoryUtilization)" inputmode="decimal" placeholder="vLLM's default" class="@inpCls" />
                    <p class="text-xs text-text-secondary mt-1"><span class="font-mono">--gpu-memory-utilization</span>: the fraction of the GPU vLLM claims up front, 0–1. Lower it to share the GPU.</p>
                </div>
                <div>
                    <label for="vllm-dtype" class="block text-sm font-medium text-text-secondary mb-1">Data type</label>
                    <select id="vllm-dtype" name="ViewModel.EngineSettings[@VllmPresetSettings.Dtype]" class="@selCls">
                        <option value="">Automatic</option>
                        @foreach (var t in VllmPresetSettings.DtypeValues.Where(t => t != "auto"))
                        {
                            <option value="@t" selected="@(Vllm(VllmPresetSettings.Dtype) == t)">@t</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="vllm-concurrent" class="block text-sm font-medium text-text-secondary mb-1">Max concurrent requests</label>
                    <input id="vllm-concurrent" name="ViewModel.EngineSettings[@VllmPresetSettings.MaxConcurrentRequests]" value="@Vllm(VllmPresetSettings.MaxConcurrentRequests)" type="number" min="1" placeholder="@LR.Providers.Vllm.VllmProvider.DefaultMaxConcurrentRequests" class="@inpCls" />
                    <p class="text-xs text-text-secondary mt-1">How many the router sends at once. vLLM batches them itself; more wait in its queue.</p>
                </div>
                <div>
                    <label for="vllm-tool-parser" class="block text-sm font-medium text-text-secondary mb-1">Tool call parser</label>
                    <input id="vllm-tool-parser" name="ViewModel.EngineSettings[@VllmPresetSettings.ToolCallParser]" value="@Vllm(VllmPresetSettings.ToolCallParser)" placeholder="hermes, mistral, …" class="@inpCls font-mono text-sm" />
                    <p class="text-xs text-text-secondary mt-1"><span class="font-mono">--tool-call-parser</span>. Depends on the model; a recipe knows the right one.</p>
                </div>
                <div>
                    <label for="vllm-reasoning-parser" class="block text-sm font-medium text-text-secondary mb-1">Reasoning parser</label>
                    <input id="vllm-reasoning-parser" name="ViewModel.EngineSettings[@VllmPresetSettings.ReasoningParser]" value="@Vllm(VllmPresetSettings.ReasoningParser)" placeholder="qwen3, deepseek_r1, …" class="@inpCls font-mono text-sm" />
                    <p class="text-xs text-text-secondary mt-1"><span class="font-mono">--reasoning-parser</span>. Separates thinking from the answer.</p>
                </div>
            </div>

            <div class="space-y-2">
                <label class="flex items-start gap-2 text-sm text-text-secondary">
                    <input type="checkbox" name="ViewModel.EngineSettings[@VllmPresetSettings.AutoToolChoice]" value="true" checked="@VllmFlag(VllmPresetSettings.AutoToolChoice)" class="mt-0.5 rounded border-gray-600/30 bg-cyber-bg-dark text-neon-magenta focus:ring-neon-magenta/30" />
                    <span><span class="font-medium">Automatic tool choice</span><span class="block text-xs"><span class="font-mono">--enable-auto-tool-choice</span>. Needs a tool call parser.</span></span>
                </label>
                <label class="flex items-start gap-2 text-sm text-text-secondary">
                    <input type="checkbox" name="ViewModel.EngineSettings[@VllmPresetSettings.TrustRemoteCode]" value="true" checked="@VllmFlag(VllmPresetSettings.TrustRemoteCode)" class="mt-0.5 rounded border-gray-600/30 bg-cyber-bg-dark text-neon-magenta focus:ring-neon-magenta/30" />
                    <span><span class="font-medium">Trust remote code</span><span class="block text-xs"><span class="font-mono">--trust-remote-code</span>. Runs Python code from the model's repository on the server's machine; only for repositories you trust.</span></span>
                </label>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="vllm-extra" class="block text-sm font-medium text-text-secondary mb-1">Extra arguments</label>
                    <textarea id="vllm-extra" name="ViewModel.EngineSettings[@VllmPresetSettings.ExtraArgs]" rows="6" placeholder="--tensor-parallel-size&#10;1" class="@inpCls font-mono text-sm">@Vllm(VllmPresetSettings.ExtraArgs)</textarea>
                    <p class="text-xs text-text-secondary mt-1">One token per line, no quoting needed. The router sets the host, port and served model name.</p>
                </div>
                <div>
                    <label for="vllm-env" class="block text-sm font-medium text-text-secondary mb-1">Environment variables</label>
                    <textarea id="vllm-env" name="ViewModel.EngineSettings[@VllmPresetSettings.Environment]" rows="6" placeholder="VLLM_USE_V2_MODEL_RUNNER=1" class="@inpCls font-mono text-sm">@Vllm(VllmPresetSettings.Environment)</textarea>
                    <p class="text-xs text-text-secondary mt-1"><span class="font-mono">NAME=value</span> per line. The Hugging Face token from the model library settings is passed on for gated models.</p>
                </div>
            </div>

            <script>
                (() => {
                    const el = id => document.getElementById(id);
                    const section = el('section-vllm');
                    const actions = '/Features/Presets/Actions';
                    let catalog = null, catalogRequest = null, recipe = null;

                    const setStatus = (text, isError) => {
                        const status = el('vllm-recipe-status');
                        status.textContent = text;
                        status.classList.toggle('text-red-400', !!isError);
                        status.classList.toggle('text-text-secondary', !isError);
                    };

                    async function getJson(handler, params) {
                        const query = new URLSearchParams({ handler, ...params });
                        const response = await fetch(`${actions}?${query}`);
                        const body = await response.json().catch(() => ({}));
                        if (!response.ok) throw new Error(body.error || `The router answered ${response.status}.`);
                        return body;
                    }

                    // The recipe list is only fetched once a vLLM server is selected.
                    let savedRequest = null, saved = [];
                    function loadSaved() {
                        savedRequest ??= getJson('VllmSaved', {}).then(models => {
                            saved = models;
                            const select = el('vllm-saved-recipe');
                            const current = field('@VllmPresetSettings.SavedRecipeId')?.value;
                            const first = document.createElement('option');
                            first.value = '';
                            first.textContent = models.length ? 'Choose a recipe…' : 'No saved recipes yet: add them under Models → vLLM models';
                            select.replaceChildren(first, ...models.map(m => {
                                const group = document.createElement('optgroup');
                                group.label = `${m.name} (${m.hfId})`;
                                group.append(...m.recipes.map(r => {
                                    const option = document.createElement('option');
                                    option.value = r.id;
                                    option.textContent = `${r.name}${r.hardware ? ` · ${r.hardware}` : ''}${r.origin === 'Site' ? ' · recipes.vllm.ai' : ''}`;
                                    option.selected = r.id === current;
                                    return option;
                                }));
                                return group;
                            }));
                        }).catch(error => {
                            savedRequest = null;
                            el('vllm-saved-recipe').replaceChildren(Object.assign(document.createElement('option'), { value: '', textContent: `Couldn't load saved recipes: ${error.message}` }));
                        });
                        return savedRequest;
                    }

                    function showWarnings(list) {
                        el('vllm-recipe-warning-list').replaceChildren(...list.map(text => {
                            const item = document.createElement('li');
                            item.textContent = text;
                            return item;
                        }));
                        el('vllm-recipe-warnings').classList.toggle('hidden', list.length === 0);
                    }

                    function applySaved() {
                        const id = el('vllm-saved-recipe').value;
                        const model = saved.find(m => m.recipes.some(r => r.id === id));
                        const picked = model?.recipes.find(r => r.id === id);
                        if (!picked) return;
                        writeSettings(picked.settings);
                        const modelPath = el('ViewModel_ModelPath');
                        modelPath.value = picked.model;
                        const name = el('ViewModel_Name');
                        if (!name.value.trim()) name.value = model.hfId.split('/').pop().toLowerCase();
                        showWarnings(picked.warnings);
                        setStatus(`Filled in from the saved recipe ${picked.name} for ${model.name}. Review it, then save the preset.`);
                        modelPath.dispatchEvent(new Event('input', { bubbles: true }));
                    }

                    window.__vllmRecipesActivate = () => {
                        loadSaved();
                        catalogRequest ??= getJson('VllmCatalog', {}).then(data => {
                            catalog = data;
                            const list = el('vllm-recipe-list');
                            for (const m of data.models) {
                                const option = document.createElement('option');
                                option.value = m.hfId;
                                option.textContent = m.title;
                                list.appendChild(option);
                            }
                        }).catch(error => {
                            catalogRequest = null;
                            setStatus(`Couldn't load the recipe list: ${error.message} You can still fill in the fields by hand.`, true);
                        });
                        return catalogRequest;
                    };

                    function fillSelect(select, options) {
                        select.replaceChildren(...options.map(([value, label]) => {
                            const option = document.createElement('option');
                            option.value = value;
                            option.textContent = label;
                            return option;
                        }));
                    }

                    function refreshHardware() {
                        const variant = recipe.variants.find(v => v.key === el('vllm-recipe-variant').value);
                        // A variant's own list is often missing; then the recipe's (every profile it has a command for) applies.
                        const supported = new Set(variant?.supportedHardware?.length ? variant.supportedHardware : (recipe.hardware ?? []));
                        const offered = catalog.hardware
                            .filter(h => supported.size === 0 || supported.has(h.id))
                            .map(h => [h.id, `${h.displayName} (${h.gpuCount} × GPU, ${h.vramGb} GB)`]);
                        fillSelect(el('vllm-recipe-hardware'), [['', `Recipe's default${recipe.defaultHardware ? ` (${recipe.defaultHardware})` : ''}`], ...offered]);
                    }

                    async function loadRecipe() {
                        const hfId = el('vllm-recipe-search').value.trim();
                        if (!hfId) { setStatus('Enter or pick a model first.', true); return; }
                        el('vllm-recipe-options').classList.add('hidden');
                        el('vllm-recipe-warnings').classList.add('hidden');
                        setStatus('Loading the recipe…');
                        try {
                            await window.__vllmRecipesActivate();
                            if (!catalog) return;
                            recipe = await getJson('VllmRecipe', { hfId });
                        } catch (error) {
                            setStatus(error.message, true);
                            return;
                        }

                        el('vllm-recipe-description').textContent = [
                            recipe.description,
                            recipe.contextLength ? `Context: ${recipe.contextLength.toLocaleString()} tokens.` : null,
                            recipe.minVllmVersion ? `Needs vLLM ${recipe.minVllmVersion}+.` : null,
                        ].filter(Boolean).join(' ');

                        fillSelect(el('vllm-recipe-variant'), recipe.variants.map(v => [v.key,
                            [v.label || v.key, v.precision, v.vramMinimumGb ? `≥ ${v.vramMinimumGb} GB VRAM` : null].filter(Boolean).join(' · ')]));
                        fillSelect(el('vllm-recipe-strategy'), [['', "Recipe's default"], ...catalog.strategies.map(s => [s.id, s.displayName])]);
                        refreshHardware();

                        const features = el('vllm-recipe-features');
                        features.querySelectorAll('label').forEach(l => l.remove());
                        for (const feature of recipe.features) {
                            const label = document.createElement('label');
                            label.className = 'flex items-start gap-2 text-xs text-text-secondary';
                            const box = document.createElement('input');
                            box.type = 'checkbox';
                            box.value = feature.key;
                            box.checked = !feature.optIn;
                            box.className = 'mt-0.5 rounded border-gray-600/30 bg-cyber-bg-dark text-neon-magenta focus:ring-neon-magenta/30';
                            const text = document.createElement('span');
                            text.textContent = feature.description ? `${feature.key}: ${feature.description}` : feature.key;
                            label.append(box, text);
                            features.appendChild(label);
                        }
                        features.classList.toggle('hidden', recipe.features.length === 0);

                        el('vllm-recipe-options').classList.remove('hidden');
                        setStatus(`Loaded ${recipe.title}. Choose how to run it, then fill in the preset.`);
                    }

                    const field = key => section.querySelector(`[name="ViewModel.EngineSettings[${key}]"]`);

                    function writeSettings(settings) {
                        // A recipe replaces the whole section, so values from an earlier one don't linger.
                        section.querySelectorAll('[name^="ViewModel.EngineSettings["]').forEach(input => {
                            if (input.id === 'vllm-concurrent') return;
                            if (input.type === 'checkbox') input.checked = false;
                            else input.value = '';
                        });
                        for (const [key, value] of Object.entries(settings)) {
                            const input = field(key);
                            if (!input) continue;
                            if (input.type === 'checkbox') input.checked = value === 'true';
                            else input.value = value;
                        }
                    }

                    async function applyRecipe() {
                        const features = [...el('vllm-recipe-features').querySelectorAll('input:checked')].map(box => box.value);
                        setStatus('Getting the command for that choice…');
                        let applied;
                        try {
                            applied = await getJson('VllmApply', {
                                hfId: recipe.hfId,
                                variant: el('vllm-recipe-variant').value,
                                hardware: el('vllm-recipe-hardware').value,
                                strategy: el('vllm-recipe-strategy').value,
                                features: recipe.features.length ? (features.join(',') || 'none') : '',
                            });
                        } catch (error) {
                            setStatus(error.message, true);
                            return;
                        }

                        writeSettings(applied.settings);
                        const modelPath = el('ViewModel_ModelPath');
                        modelPath.value = applied.model;
                        const name = el('ViewModel_Name');
                        if (!name.value.trim()) name.value = applied.model.split('/').pop().toLowerCase();

                        showWarnings(applied.warnings);
                        el('vllm-saved-recipe').value = '';

                        setStatus(`Filled in from the recipe for ${applied.model} (${applied.hardware}, ${applied.variant}). Review it, then save the preset.`);
                        modelPath.dispatchEvent(new Event('input', { bubbles: true }));
                    }

                    el('vllm-qwen38-profile').addEventListener('click', () => {
                        writeSettings(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(VllmDocker.Qwen38Preset).Replace("</", "<\\/")));
                        el('vllm-recipe-warnings').classList.add('hidden');
                        el('vllm-saved-recipe').value = '';
                        setStatus('Filled in the Qwen3.8 settings for an Arc Pro B70. Enter the model folder or Hugging Face id, review them, then save the preset.');
                    });
                    el('vllm-saved-recipe').addEventListener('change', applySaved);
                    el('vllm-recipe-load').addEventListener('click', loadRecipe);
                    el('vllm-recipe-apply').addEventListener('click', applyRecipe);
                    el('vllm-recipe-variant').addEventListener('change', refreshHardware);
                    el('vllm-recipe-search').addEventListener('keydown', event => {
                        if (event.key === 'Enter') { event.preventDefault(); loadRecipe(); }
                    });
                })();
            </script>
        </div>

        <!-- ==================== TENSORFOLD (TensorFold servers only) ==================== -->
        <div id="section-tensorfold" class="hidden bg-cyber-card rounded-xl p-6 border border-neon-cyan/10 space-y-6 scroll-mt-24">
            <div class="space-y-1">
                <h2 class="text-lg font-semibold text-text-primary">TensorFold</h2>
                <p class="text-xs text-text-secondary">
                    How <span class="font-mono">tensorfold-native serve</span> runs this preset's model. Leave a setting blank for TensorFold's default.
                    TensorFold serves its own checkpoint formats (MLX 4/6/8-bit, NVFP4, FP8, EXL3…) for the model families it supports —
                    see its <a href="https://github.com/ashhart/TensorFold#models" target="_blank" rel="noopener" class="text-neon-cyan/80 hover:text-neon-cyan">model table</a>
                    for the repo ids and the hardware each was checked on.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="tf-pull" class="block text-sm font-medium text-text-secondary mb-1">Download the model</label>
                    <select id="tf-pull" name="ViewModel.EngineSettings[@TensorFoldPresetSettings.Pull]" class="@selCls">
                        <option value="">When it isn't in the Hugging Face cache yet</option>
                        <option value="always" selected="@(Tf(TensorFoldPresetSettings.Pull) == "always")">At every start (resumes and checks it)</option>
                        <option value="never" selected="@(Tf(TensorFoldPresetSettings.Pull) == "never")">Never (pulled by hand)</option>
                    </select>
                    <p class="text-xs text-text-secondary mt-1">Runs <span class="font-mono">tensorfold-native pull</span> for a repo id on the server's machine; a first start can take a long time. Not on Windows, where you pull it yourself.</p>
                </div>
                <div>
                    <label for="tf-context" class="block text-sm font-medium text-text-secondary mb-1">Context length</label>
                    <input id="tf-context" name="ViewModel.EngineSettings[@TensorFoldPresetSettings.Context]" value="@Tf(TensorFoldPresetSettings.Context)"
                           inputmode="numeric" placeholder="the model's default" class="@inpCls" />
                    <p class="text-xs text-text-secondary mt-1"><span class="font-mono">--context</span>: prompt plus reply tokens. The model's window and memory checks still apply.</p>
                </div>
                <div>
                    <label for="tf-parallel" class="block text-sm font-medium text-text-secondary mb-1">Parallel requests</label>
                    <input id="tf-parallel" name="ViewModel.EngineSettings[@TensorFoldPresetSettings.Parallel]" value="@Tf(TensorFoldPresetSettings.Parallel)"
                           placeholder="auto (up to 8, as memory allows)" class="@inpCls" />
                    <p class="text-xs text-text-secondary mt-1"><span class="font-mono">--parallel</span>. A number TensorFold can't fit is refused at start. The router sends at most this many at once.</p>
                </div>
                <div>
                    <label for="tf-maxtokens" class="block text-sm font-medium text-text-secondary mb-1">Default reply limit</label>
                    <input id="tf-maxtokens" name="ViewModel.EngineSettings[@TensorFoldPresetSettings.MaxTokens]" value="@Tf(TensorFoldPresetSettings.MaxTokens)"
                           type="number" min="1" placeholder="4096" class="@inpCls" />
                    <p class="text-xs text-text-secondary mt-1"><span class="font-mono">--max-tokens</span>, for requests that set none.</p>
                </div>
                <div>
                    <label for="tf-thinking" class="block text-sm font-medium text-text-secondary mb-1">Thinking</label>
                    <select id="tf-thinking" name="ViewModel.EngineSettings[@TensorFoldPresetSettings.Thinking]" class="@selCls">
                        <option value="">The chat template's default</option>
                        <option value="on" selected="@(Tf(TensorFoldPresetSettings.Thinking) == "on")">On (--thinking)</option>
                        <option value="off" selected="@(Tf(TensorFoldPresetSettings.Thinking) == "off")">Off (--no-thinking)</option>
                    </select>
                </div>
                <div>
                    <label for="tf-effort" class="block text-sm font-medium text-text-secondary mb-1">Reasoning effort</label>
                    <select id="tf-effort" name="ViewModel.EngineSettings[@TensorFoldPresetSettings.ReasoningEffort]" class="@selCls">
                        <option value="">The template's default</option>
                        @foreach (var effort in TensorFoldPresetSettings.ReasoningEffortValues)
                        {
                            <option value="@effort" selected="@(Tf(TensorFoldPresetSettings.ReasoningEffort) == effort)">@effort</option>
                        }
                    </select>
                    <p class="text-xs text-text-secondary mt-1"><span class="font-mono">--reasoning-effort</span>, for templates that take one.</p>
                </div>
                <div>
                    <label for="tf-drafter-library" class="block text-sm font-medium text-text-secondary mb-1">Drafter</label>
                    @{
                        var drafterValue = Tf(TensorFoldPresetSettings.Drafter);
                        var libraryCheckpoints = Model.Models.Where(m => m.Format == LR.Core.Models.ModelFormat.Checkpoint).ToList();
                    }
                    <select id="tf-drafter-library" class="@selCls mb-2" aria-label="Drafter from the model library">
                        <option value="">— From the model library —</option>
                        @foreach (var m in libraryCheckpoints)
                        {
                            <option value="@m.FilePath" data-agent="@(m.AgentId?.ToString() ?? "")"
                                    selected="@(string.Equals(m.FilePath, drafterValue, StringComparison.OrdinalIgnoreCase))">@m.Name</option>
                        }
                    </select>
                    <input id="tf-drafter" name="ViewModel.EngineSettings[@TensorFoldPresetSettings.Drafter]" value="@drafterValue"
                           placeholder="a library checkpoint (above), a folder, or a repo id in the Hugging Face cache" class="@inpCls font-mono text-sm" />
                    <p class="text-xs text-text-secondary mt-1">
                        <span class="font-mono">--drafter</span>: an external drafter for speculative decoding (e.g. z-lab/Qwen3.8-27B-DFlash2).
                        Picking one from the library uses its folder; in the Intel XPU Docker image it's mounted read-only. A repo id is looked up in the Hugging Face cache and isn't downloaded.
                    </p>
                    <script>
                        (() => {
                            const pick = document.getElementById('tf-drafter-library');
                            const field = document.getElementById('tf-drafter');
                            pick.addEventListener('change', () => { if (pick.value) { field.value = pick.value; field.dispatchEvent(new Event('input', { bubbles: true })); } });
                            field.addEventListener('input', () => { if (pick.value && pick.value !== field.value) pick.value = ''; });
                        })();
                    </script>
                </div>
                <div>
                    <label for="tf-vram" class="block text-sm font-medium text-text-secondary mb-1">Memory needed (GB)</label>
                    <input id="tf-vram" name="ViewModel.EngineSettings[@TensorFoldPresetSettings.VramGb]" value="@Tf(TensorFoldPresetSettings.VramGb)"
                           inputmode="decimal" placeholder="for memory groups" class="@inpCls" />
                    <p class="text-xs text-text-secondary mt-1">What the model takes on the device, for memory-group budgeting. The model table lists most.</p>
                </div>
                <div>
                    <label for="tf-prompt-cache" class="block text-sm font-medium text-text-secondary mb-1">Prompt cache (GiB)</label>
                    <input id="tf-prompt-cache" name="ViewModel.EngineSettings[@TensorFoldPresetSettings.PromptCacheGib]" value="@Tf(TensorFoldPresetSettings.PromptCacheGib)"
                           inputmode="decimal" placeholder="2 (0 turns it off)" class="@inpCls" />
                    <p class="text-xs text-text-secondary mt-1">
                        <span class="font-mono">--prompt-cache-gib</span>: saved prompt states, so a follow-up turn skips re-reading the conversation.
                        On Intel XPU it takes GPU memory from the context: lower it when a long context doesn't fit.
                    </p>
                </div>
                <div>
                    <label for="tf-wddm-chunk" class="block text-sm font-medium text-text-secondary mb-1">Intel WDDM chunk size (MB)</label>
                    <input id="tf-wddm-chunk" name="ViewModel.EngineSettings[@TensorFoldPresetSettings.WddmChunkMb]" value="@Tf(TensorFoldPresetSettings.WddmChunkMb)"
                           type="number" min="1" placeholder="the driver's default" class="@inpCls" />
                    <p class="text-xs text-text-secondary mt-1">
                        Intel XPU under WSL/Docker only: sets <span class="font-mono">@TensorFoldPresetSettings.WddmChunkVariable</span>.
                        Try 4096 if loading aborts in <span class="font-mono">wddm_memory_manager.cpp</span>.
                    </p>
                </div>
            </div>

            <label class="flex items-start gap-3 text-sm text-text-secondary">
                <input type="checkbox" name="ViewModel.EngineSettings[@TensorFoldPresetSettings.Vision]" value="true" checked="@(Tf(TensorFoldPresetSettings.Vision) == "true")" class="mt-1" />
                <span><span class="font-medium">Images</span><span class="block text-xs"><span class="font-mono">--vision</span>, for models with a vision tower. On CUDA it needs NVIDIA's cuBLASLt runtime.</span></span>
            </label>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="tf-extra" class="block text-sm font-medium text-text-secondary mb-1">Extra arguments</label>
                    <textarea id="tf-extra" name="ViewModel.EngineSettings[@TensorFoldPresetSettings.ExtraArgs]" rows="6" placeholder="--temperature&#10;0.6&#10;--compact-at&#10;0.9" class="@inpCls font-mono text-sm">@Tf(TensorFoldPresetSettings.ExtraArgs)</textarea>
                    <p class="text-xs text-text-secondary mt-1">One token per line, no quoting needed. The router sets the host, port and served model name.</p>
                </div>
                <div>
                    <label for="tf-env" class="block text-sm font-medium text-text-secondary mb-1">Environment variables</label>
                    <textarea id="tf-env" name="ViewModel.EngineSettings[@TensorFoldPresetSettings.Environment]" rows="6" placeholder="HF_HOME=/data/huggingface" class="@inpCls font-mono text-sm">@Tf(TensorFoldPresetSettings.Environment)</textarea>
