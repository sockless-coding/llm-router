                    <h3 class="text-sm font-semibold text-text-primary">Estimated VRAM Usage</h3>
                    <span id="vram-total" class="text-sm font-semibold text-neon-cyan"></span>
                </div>
                <div id="vram-breakdown" class="text-xs text-text-secondary space-y-0.5"></div>
