                        var id = "sd-" + key[(key.IndexOf('.') + 1)..].ToLowerInvariant();
                        <div>
                            <label for="@id" class="block text-sm font-medium text-text-secondary mb-1">@label <span class="font-mono text-xs">@flag</span></label>
                            <input id="@id" name="ViewModel.EngineSettings[@key]" value="@Sd(key)" list="sd-model-files"
                                   placeholder="pick from the library or enter a path" class="@inpCls" />
