                <div>
                    <label asp-for="ViewModel.FlashAttention" class="block text-sm font-medium text-text-secondary mb-1"></label>
                    <select asp-for="ViewModel.FlashAttention" id="flash-attention-select" class="@selCls">
                        <option value="">— default (auto) —</option>
                        <option value="on">on</option>
                        <option value="off">off</option>
                        <option value="auto">auto</option>
                    </select>
                </div>
                <div>
                    <label asp-for="ViewModel.Jinja" class="block text-sm font-medium text-text-secondary mb-1"></label>
                    <select asp-for="ViewModel.Jinja" class="@selCls">
                        <option value="">— default (enabled) —</option>
                        <option value="True">enabled</option>
                        <option value="False">disabled</option>
                    </select>
                </div>
            </div>

            <!-- Spec Type -->
            <div>
                <label asp-for="ViewModel.SpecType" class="block text-sm font-medium text-text-secondary mb-1"></label>
                <label class="flex items-center gap-2 mb-2 text-sm text-text-secondary">
                    <input type="checkbox" id="mtp-checkbox" class="rounded border-gray-600/30 bg-cyber-bg-dark text-neon-magenta focus:ring-neon-magenta/30" />
                    Enable MTP (multi-token prediction)
                </label>
                <p class="text-xs text-text-secondary mb-2">Uses the model's built-in draft head for self-speculative decoding — no separate draft model file needed. Sets Spec Type to <code>draft-mtp</code> and Draft N Max (below) to 3.</p>
                <input asp-for="ViewModel.SpecType" id="spec-type-input" placeholder="none, ngram-simple, draft-eagle3, ..."
                       class="@inpCls" />
            </div>
        </div>

        <!-- ==================== SAMPLING (Always Visible) ==================== -->
        <div id="section-sampling" class="bg-cyber-card rounded-xl p-6 border border-neon-magenta/10 space-y-4 scroll-mt-24">
