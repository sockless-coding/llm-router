            </div>

            <!-- KV Cache Types -->
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label asp-for="ViewModel.CacheTypeK" class="block text-sm font-medium text-text-secondary mb-1"></label>
                    <select asp-for="ViewModel.CacheTypeK" id="cache-type-k-select" class="@selCls">
                        <option value="">— default (f16) —</option>
                        @foreach (var v in new[] { "f32", "f16", "bf16", "q8_0", "q4_0", "q4_1", "iq4_nl", "q5_0", "q5_1" })
                        {
                            <option value="@v">@v</option>
                        }
                    </select>
                </div>
                <div>
                    <label asp-for="ViewModel.CacheTypeV" class="block text-sm font-medium text-text-secondary mb-1"></label>
                    <select asp-for="ViewModel.CacheTypeV" id="cache-type-v-select" class="@selCls">
                        <option value="">— default (f16) —</option>
                        @foreach (var v in new[] { "f32", "f16", "bf16", "q8_0", "q4_0", "q4_1", "iq4_nl", "q5_0", "q5_1" })
                        {
                            <option value="@v">@v</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Flash Attention & Jinja -->
