    const addBtn = document.getElementById('kwargs-add-btn');
    const hint = document.getElementById('kwargs-hint');
    const modelSelect = document.getElementById('model-select');
    const detectedDataEl = document.getElementById('kwargs-detected-data');
    if (!rowsContainer || !rawInput) return;

    const inputCls = '@inpCls';
    const selectCls = '@selCls';

    let detected = [];
    try { detected = JSON.parse(detectedDataEl ? detectedDataEl.textContent : '[]') || []; } catch (e) { detected = []; }

    let values = {};
    try {
        const parsed = JSON.parse(rawInput.value || '{}');
        if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) values = parsed;
    } catch (e) { /* leave values empty on invalid stored JSON */ }

    function customKeys() {
        return Object.keys(values).filter(k => !detected.some(d => d.name === k));
    }

    function coerce(text) {
        if (text === '') return undefined;
        if (text === 'true') return true;
        if (text === 'false') return false;
        if (/^-?\d+(\.\d+)?$/.test(text)) return Number(text);
        return text;
    }

    function displayValue(v) {
        if (v === undefined || v === null) return '';
        return typeof v === 'string' ? v : JSON.stringify(v);
    }

    function typeLabel(v) {
        if (v === undefined) return '';
        if (typeof v === 'boolean') return 'boolean';
        if (typeof v === 'number') return 'number';
        return 'string';
    }

    function sync() {
        rawInput.value = Object.keys(values).length ? JSON.stringify(values) : '';
    }

    function smallBtn(text, title) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.title = title || '';
        btn.className = 'text-text-secondary hover:text-red-400 text-xs px-1.5 shrink-0';
        btn.textContent = text;
        return btn;
    }

    function renderDetectedRow(v) {
        const row = document.createElement('div');
        row.className = 'flex items-center gap-2';

        const label = document.createElement('span');
        label.className = 'font-mono text-xs text-neon-magenta w-40 shrink-0 truncate';
        label.title = v.name;
        label.textContent = v.name;
        row.appendChild(label);

        if (v.literalValues && v.literalValues.length > 0) {
            const select = document.createElement('select');
            select.className = selectCls + ' flex-1';

            select.add(new Option('— not set —', ''));
            v.literalValues.forEach(lv => select.add(new Option(lv, lv)));
            select.add(new Option('Custom value…', '__custom__'));

            const customInput = document.createElement('input');
            customInput.type = 'text';
            customInput.className = inputCls + ' flex-1 hidden';
            customInput.placeholder = 'custom value';

            const current = values[v.name];
            const matchesLiteral = typeof current === 'string' && v.literalValues.includes(current);
            if (current === undefined) {
                select.value = '';
            } else if (matchesLiteral) {
                select.value = current;
            } else {
                select.value = '__custom__';
                customInput.value = displayValue(current);
                customInput.classList.remove('hidden');
            }

            select.addEventListener('change', () => {
                if (select.value === '') {
                    delete values[v.name];
                    customInput.classList.add('hidden');
                } else if (select.value === '__custom__') {
                    customInput.classList.remove('hidden');
                    customInput.focus();
                    const coerced = coerce(customInput.value);
                    if (coerced === undefined) delete values[v.name];
                    else values[v.name] = coerced;
                } else {
                    customInput.classList.add('hidden');
                    values[v.name] = select.value;
                }
                sync();
            });

            customInput.addEventListener('input', () => {
                const coerced = coerce(customInput.value);
                if (coerced === undefined) delete values[v.name];
                else values[v.name] = coerced;
                sync();
            });

            row.appendChild(select);
            row.appendChild(customInput);
        } else {
            const input = document.createElement('input');
            input.type = 'text';
            input.className = inputCls + ' flex-1';
            input.placeholder = 'not set';
            input.value = displayValue(values[v.name]);

            const badge = document.createElement('span');
            badge.className = 'text-[10px] text-text-secondary w-14 shrink-0 text-right';
            badge.textContent = typeLabel(values[v.name]);

            input.addEventListener('input', () => {
                const coerced = coerce(input.value);
                if (coerced === undefined) delete values[v.name];
                else values[v.name] = coerced;
                badge.textContent = typeLabel(values[v.name]);
                sync();
            });

            row.appendChild(input);
            row.appendChild(badge);
        }

        return row;
    }

    function renderCustomRow(key) {
        const row = document.createElement('div');
        row.className = 'flex items-center gap-2';

        const keyInput = document.createElement('input');
        keyInput.type = 'text';
        keyInput.className = inputCls + ' w-40 shrink-0 font-mono text-xs';
        keyInput.placeholder = 'key';
        keyInput.value = key;

        const valueInput = document.createElement('input');
        valueInput.type = 'text';
        valueInput.className = inputCls + ' flex-1';
        valueInput.placeholder = 'value';
        valueInput.value = displayValue(values[key]);

        const badge = document.createElement('span');
        badge.className = 'text-[10px] text-text-secondary w-14 shrink-0 text-right';
        badge.textContent = typeLabel(values[key]);

        keyInput.addEventListener('change', () => {
            const newKey = keyInput.value.trim();
            if (!newKey || newKey === key || newKey in values || detected.some(d => d.name === newKey)) {
                keyInput.value = key;
                return;
            }
            values[newKey] = values[key];
            delete values[key];
            key = newKey;
            sync();
        });

        valueInput.addEventListener('input', () => {
            const coerced = coerce(valueInput.value);
            if (coerced === undefined) delete values[key];
            else values[key] = coerced;
            badge.textContent = typeLabel(values[key]);
            sync();
        });

        const removeBtn = smallBtn('✕', 'Remove');
        removeBtn.addEventListener('click', () => {
            delete values[key];
            sync();
            render();
        });

        row.appendChild(keyInput);
        row.appendChild(valueInput);
        row.appendChild(badge);
        row.appendChild(removeBtn);
        return row;
    }

    function render() {
        rowsContainer.innerHTML = '';

        detected.forEach(v => rowsContainer.appendChild(renderDetectedRow(v)));
        customKeys().forEach(key => rowsContainer.appendChild(renderCustomRow(key)));

        if (rowsContainer.children.length === 0) {
            const empty = document.createElement('p');
            empty.className = 'text-xs text-text-secondary italic';
            empty.textContent = 'No kwargs set.';
            rowsContainer.appendChild(empty);
        }

        if (hint) {
            hint.textContent = detected.length > 0
                ? `Detected ${detected.length} variable${detected.length === 1 ? '' : 's'} from this model's template.`
                : '';
            hint.classList.toggle('hidden', detected.length === 0);
        }
    }

    if (addBtn) {
        addBtn.addEventListener('click', () => {
            let n = 1, key = 'key';
            while (key in values || detected.some(d => d.name === key)) key = `key${n++}`;
            values[key] = '';
            sync();
            render();
        });
    }

    rawInput.addEventListener('change', () => {
        try {
            const parsed = JSON.parse(rawInput.value || '{}');
            values = (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) ? parsed : {};
        } catch (e) {
            return; // leave rows as-is while the JSON is mid-edit / invalid
        }
        render();
    });

    async function refreshDetected(modelId) {
        if (!modelId) { detected = []; render(); return; }
        try {
            const resp = await fetch(`?handler=TemplateVariables&modelId=${encodeURIComponent(modelId)}`);
            detected = resp.ok ? await resp.json() : [];
        } catch (e) {
            detected = [];
        }
        render();
    }

    if (modelSelect) {
        modelSelect.addEventListener('change', () => refreshDetected(modelSelect.value));
    }

    render();
    sync();

    // Re-syncs against the currently selected model in case it differs from the
    // preset's last-saved template (e.g. after a validation error re-render).
    if (modelSelect && modelSelect.value) {
        refreshDetected(modelSelect.value);
    }
})();
</script>

<script>
(function () {
    const mtpCheckbox = document.getElementById('mtp-checkbox');
    const specTypeInput = document.getElementById('spec-type-input');
    const specDraftNMaxInput = document.getElementById('spec-draft-n-max-input');
    if (!mtpCheckbox || !specTypeInput) return;

    const MTP_VALUE = 'draft-mtp';

    function applyLockedState(locked) {
        specTypeInput.readOnly = locked;
        specTypeInput.classList.toggle('opacity-60', locked);
    }

    mtpCheckbox.checked = specTypeInput.value.trim() === MTP_VALUE;
    applyLockedState(mtpCheckbox.checked);

    mtpCheckbox.addEventListener('change', () => {
        if (mtpCheckbox.checked) {
            specTypeInput.value = MTP_VALUE;
            if (specDraftNMaxInput && !specDraftNMaxInput.value.trim())
                specDraftNMaxInput.value = '3';
        } else if (specTypeInput.value.trim() === MTP_VALUE) {
            specTypeInput.value = '';
        }
        applyLockedState(mtpCheckbox.checked);
    });
})();
</script>

