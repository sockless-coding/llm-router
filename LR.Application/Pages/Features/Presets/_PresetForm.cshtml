        <!-- ==================== DIFFUSION (stable-diffusion.cpp servers only) ==================== -->
        <div id="section-diffusion" class="hidden bg-cyber-card rounded-xl p-6 border border-neon-cyan/10 space-y-6 scroll-mt-24">
            <div class="space-y-1">
                <h2 class="text-lg font-semibold text-text-primary">Diffusion</h2>
                <p class="text-xs text-text-secondary">
                    How stable-diffusion.cpp loads this preset's model, and the defaults it generates with. Clients reach it at
                    <span class="font-mono">POST /v1/images/generations</span> with this preset's name as the model; a request's own
                    <span class="font-mono">size</span>, <span class="font-mono">n</span>, <span class="font-mono">seed</span>, <span class="font-mono">steps</span>,
                    <span class="font-mono">cfg_scale</span>, <span class="font-mono">negative_prompt</span>… override the defaults below. Leave a setting blank for stable-diffusion.cpp's default.
                </p>
            </div>

            <datalist id="sd-model-files">
                @foreach (var m in Model.Models)
                {
                    var role = DiffusionModelGuide.ClassifyFile(m);
                    <option value="@m.FilePath" data-agent="@(m.AgentId?.ToString() ?? "")">@m.Name@(role is DiffusionFileRole.Model or DiffusionFileRole.Other ? "" : $" ({DiffusionModelGuide.Label(role)})")</option>
                }
            </datalist>

            <div class="space-y-4">
                <h3 class="text-xs font-semibold text-text-secondary uppercase tracking-wide">Model files</h3>
                <div id="sd-suggestion" class="hidden rounded-lg border border-neon-cyan/20 bg-neon-cyan/5 p-3 space-y-1.5 text-sm"></div>
                <script id="sd-suggestions-data" type="application/json">@Html.Raw(sdSuggestionsJson)</script>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="sd-model-role" class="block text-sm font-medium text-text-secondary mb-1">Model is</label>
                        <select id="sd-model-role" name="ViewModel.EngineSettings[@StableDiffusionPresetSettings.ModelRole]" class="@selCls">
                            <option value="">Detect (a diffusion model when a VAE or text encoder is set)</option>
                            <option value="@StableDiffusionPresetSettings.RoleCheckpoint" selected="@(Sd(StableDiffusionPresetSettings.ModelRole) == StableDiffusionPresetSettings.RoleCheckpoint)">A full checkpoint (-m)</option>
                            <option value="@StableDiffusionPresetSettings.RoleDiffusion" selected="@(Sd(StableDiffusionPresetSettings.ModelRole) == StableDiffusionPresetSettings.RoleDiffusion)">A standalone diffusion model (--diffusion-model)</option>
                        </select>
                        <p class="text-xs text-text-secondary mt-1">SD 1.x/2.x/SDXL checkpoints carry their own VAE and encoders; Flux, SD3, Qwen-Image and Z-Image need them set below.</p>
                    </div>
                    <div>
                        <label for="sd-lora-dir" class="block text-sm font-medium text-text-secondary mb-1">LoRA folder</label>
                        <input id="sd-lora-dir" name="ViewModel.EngineSettings[@StableDiffusionPresetSettings.LoraDir]" value="@Sd(StableDiffusionPresetSettings.LoraDir)"
                               placeholder="C:\models\loras" class="@inpCls" />
                        <p class="text-xs text-text-secondary mt-1">Where requests' <span class="font-mono">lora</span> entries are looked up.</p>
                    </div>
                    @foreach (var (key, flag, label) in StableDiffusionPresetSettings.ComponentFiles)
