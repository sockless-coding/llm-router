<script>
(function () {
    const select = document.getElementById('model-select');
    const info = document.getElementById('model-gguf-info');
    const ctxInput = document.getElementById('context-size-input');
    if (!select || !info) return;

    function badge(label, value) {
        return `<span class="text-xs px-2 py-0.5 rounded bg-neon-cyan/10 text-neon-cyan border border-neon-cyan/20">${label}: ${value}</span>`;
    }

    function render() {
        const opt = select.options[select.selectedIndex];
        const arch = opt?.dataset.arch;
        const params = opt?.dataset.params;
        const quant = opt?.dataset.quant;
        const context = opt?.dataset.context;

        if (!opt || !opt.value || (!arch && !params && !quant && !context)) {
            info.classList.add('hidden');
            info.innerHTML = '';
            if (ctxInput) ctxInput.placeholder = 'from model';
            return;
        }

        let html = '';
        if (arch) html += badge('Arch', arch);
        if (params) html += badge('Params', params);
        if (quant) html += badge('Quant', quant);
        if (context) html += badge('Context', context);
        info.innerHTML = html;
        info.classList.remove('hidden');

        if (ctxInput) ctxInput.placeholder = context ? `from model (${context})` : 'from model';
    }

    select.addEventListener('change', render);
    render();
})();
</script>

<script>
(function () {
    const select = document.getElementById('model-select');
    const box = document.getElementById('vram-estimate');
    const totalEl = document.getElementById('vram-total');
    const breakdownEl = document.getElementById('vram-breakdown');
    const caveatEl = document.getElementById('vram-caveat');
    const ctxInput = document.getElementById('context-size-input');
    const gpuLayersInput = document.getElementById('gpu-layers-input');
    const cacheKSelect = document.getElementById('cache-type-k-select');
    const cacheVSelect = document.getElementById('cache-type-v-select');
    const ubatchInput = document.getElementById('ubatch-size-input');
    const cpuMoeSelect = document.getElementById('cpu-moe-select');
    const nCpuMoeInput = document.getElementById('n-cpu-moe-input');
    const flashAttnSelect = document.getElementById('flash-attention-select');
    if (!select || !box) return;

    // Approximate bytes-per-element for llama.cpp's K/V cache quant types (block-quant
    // overhead included). Weight size doesn't need a similar table because the model's
    // file size on disk already reflects its quantization.
    const CACHE_BYTES_PER_ELEM = {
        f32: 4, f16: 2, bf16: 2,
        q8_0: 1.0625, q5_1: 0.75, q5_0: 0.6875,
        q4_1: 0.625, q4_0: 0.5625, iq4_nl: 0.5625
    };
    const QUANTIZED_CACHE_TYPES = new Set(['q8_0', 'q5_0', 'q5_1', 'q4_0', 'q4_1', 'iq4_nl']);

    function fmtGiB(bytes) {
        return (bytes / 1073741824).toFixed(2) + ' GiB';
    }

    function calc() {
        const opt = select.options[select.selectedIndex];
        const fileSize = opt ? Number(opt.dataset.filesize) : NaN;
        const blocks = opt ? Number(opt.dataset.blocks) : NaN;
        const heads = opt ? Number(opt.dataset.heads) : NaN;
        const kvHeads = opt ? Number(opt.dataset.kvheads) : NaN;
        const embed = opt ? Number(opt.dataset.embed) : NaN;

        if (!opt || !opt.value || !fileSize || !blocks || !heads || !kvHeads || !embed) {
            box.classList.add('hidden');
            return;
        }

        const modelContext = Number(opt.dataset.context) || 4096;
        const ctxSize = Number(ctxInput?.value) || modelContext;
        const gpuLayersRaw = (gpuLayersInput?.value ?? '').trim();
        const gpuLayers = gpuLayersRaw === '' ? blocks : Math.max(0, Math.min(Number(gpuLayersRaw), blocks));
        const offloadFrac = blocks > 0 ? gpuLayers / blocks : 0;

        const weightsBytes = fileSize * offloadFrac;

        const kTypeBytes = CACHE_BYTES_PER_ELEM[cacheKSelect?.value] ?? CACHE_BYTES_PER_ELEM.f16;
        const vTypeBytes = CACHE_BYTES_PER_ELEM[cacheVSelect?.value] ?? CACHE_BYTES_PER_ELEM.f16;
        const headDim = embed / heads;
        // Only the layers actually offloaded to GPU keep their KV cache in VRAM.
        const kvCacheBytes = gpuLayers * kvHeads * headDim * ctxSize * (kTypeBytes + vTypeBytes);

        // The compute (activation) buffer's biggest driver is whether Flash Attention is on.
        // Without it, llama.cpp materializes the full attention score matrix (ubatch rows x
        // context columns x heads, in f32) in the compute graph, so it scales with context
        // length. With it fused/streamed, the buffer stays small and roughly constant. This is
        // the least precise term overall — it also varies with backend and llama.cpp build.
        const ubatch = Number(ubatchInput?.value) || 512;
        const flashAttnOff = (flashAttnSelect?.value ?? '').trim().toLowerCase() === 'off';
        const computeBufferBytes = flashAttnOff
            ? Math.max(268435456, ubatch * ctxSize * heads * 4)
            : Math.max(268435456, ubatch * embed * 4 * 4);

        const totalBytes = weightsBytes + kvCacheBytes + computeBufferBytes;

        breakdownEl.innerHTML =
            `<div class="flex justify-between"><span>Weights (${gpuLayers}/${blocks} layers on GPU)</span><span>${fmtGiB(weightsBytes)}</span></div>` +
            `<div class="flex justify-between"><span>KV cache (ctx ${ctxSize})</span><span>${fmtGiB(kvCacheBytes)}</span></div>` +
            `<div class="flex justify-between"><span>Compute buffer &amp; overhead (rough${flashAttnOff ? ', flash-attn off' : ''})</span><span>${fmtGiB(computeBufferBytes)}</span></div>`;
        totalEl.textContent = fmtGiB(totalBytes);

        const notes = ['Rough estimate only — actual usage varies by llama.cpp build and backend.'];
        const cpuMoeOn = cpuMoeSelect?.value === 'True' || (nCpuMoeInput?.value ?? '').trim() !== '';
        if (cpuMoeOn) notes.push('MoE CPU offload is enabled but not modeled here, so actual GPU weight usage will likely be lower.');
        if (gpuLayersRaw === '') notes.push('GPU Layers is "auto" — assuming full offload (all layers on GPU).');
        if (flashAttnOff) {
            notes.push('Flash Attention is off, so the compute buffer grows with context length instead of staying roughly constant — enabling it usually cuts this a lot at long contexts.');
        } else {
            notes.push('Assumes Flash Attention is effectively on (kept small); if it ends up disabled at runtime for this backend/model, the compute buffer can grow with context instead.');
        }
        const kQuantized = QUANTIZED_CACHE_TYPES.has(cacheKSelect?.value);
        const vQuantized = QUANTIZED_CACHE_TYPES.has(cacheVSelect?.value);
        if (flashAttnOff && (kQuantized || vQuantized)) {
            notes.push('Quantized K/V cache types normally require Flash Attention to be on in llama.cpp — this combination may fail to load.');
        }
        caveatEl.textContent = notes.join(' ');

        box.classList.remove('hidden');
    }

    [select, ctxInput, gpuLayersInput, cacheKSelect, cacheVSelect, ubatchInput, cpuMoeSelect, nCpuMoeInput, flashAttnSelect].forEach(el => {
        if (!el) return;
        el.addEventListener('input', calc);
        el.addEventListener('change', calc);
    });

    calc();
})();
</script>

<script>
(function () {
    const rowsContainer = document.getElementById('kwargs-rows');
    const rawInput = document.getElementById('kwargs-raw');
    const addBtn = document.getElementById('kwargs-add-btn');
    const hint = document.getElementById('kwargs-hint');
    const modelSelect = document.getElementById('model-select');
    const detectedDataEl = document.getElementById('kwargs-detected-data');
    if (!rowsContainer || !rawInput) return;

    const inputCls = '@inpCls';
    const selectCls = '@selCls';

    let detected = [];
    try { detected = JSON.parse(detectedDataEl ? detectedDataEl.textContent : '[]') || []; } catch (e) { detected = []; }

    let values = {};
    try {
        const parsed = JSON.parse(rawInput.value || '{}');
        if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) values = parsed;
    } catch (e) { /* leave values empty on invalid stored JSON */ }

    function customKeys() {
        return Object.keys(values).filter(k => !detected.some(d => d.name === k));
    }

    function coerce(text) {
        if (text === '') return undefined;
        if (text === 'true') return true;
        if (text === 'false') return false;
        if (/^-?\d+(\.\d+)?$/.test(text)) return Number(text);
        return text;
    }

    function displayValue(v) {
        if (v === undefined || v === null) return '';
        return typeof v === 'string' ? v : JSON.stringify(v);
    }

    function typeLabel(v) {
        if (v === undefined) return '';
        if (typeof v === 'boolean') return 'boolean';
        if (typeof v === 'number') return 'number';
        return 'string';
    }

    function sync() {
        rawInput.value = Object.keys(values).length ? JSON.stringify(values) : '';
    }

    function smallBtn(text, title) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.title = title || '';
        btn.className = 'text-text-secondary hover:text-red-400 text-xs px-1.5 shrink-0';
        btn.textContent = text;
        return btn;
    }

    function renderDetectedRow(v) {
        const row = document.createElement('div');
        row.className = 'flex items-center gap-2';

        const label = document.createElement('span');
        label.className = 'font-mono text-xs text-neon-magenta w-40 shrink-0 truncate';
        label.title = v.name;
        label.textContent = v.name;
        row.appendChild(label);

        if (v.literalValues && v.literalValues.length > 0) {
            const select = document.createElement('select');
            select.className = selectCls + ' flex-1';

            select.add(new Option('— not set —', ''));
            v.literalValues.forEach(lv => select.add(new Option(lv, lv)));
            select.add(new Option('Custom value…', '__custom__'));

            const customInput = document.createElement('input');
            customInput.type = 'text';
            customInput.className = inputCls + ' flex-1 hidden';
            customInput.placeholder = 'custom value';

            const current = values[v.name];
            const matchesLiteral = typeof current === 'string' && v.literalValues.includes(current);
            if (current === undefined) {
                select.value = '';
            } else if (matchesLiteral) {
                select.value = current;
            } else {
                select.value = '__custom__';
                customInput.value = displayValue(current);
                customInput.classList.remove('hidden');
            }

            select.addEventListener('change', () => {
                if (select.value === '') {
                    delete values[v.name];
                    customInput.classList.add('hidden');
                } else if (select.value === '__custom__') {
                    customInput.classList.remove('hidden');
                    customInput.focus();
                    const coerced = coerce(customInput.value);
                    if (coerced === undefined) delete values[v.name];
                    else values[v.name] = coerced;
                } else {
                    customInput.classList.add('hidden');
                    values[v.name] = select.value;
                }
                sync();
            });

            customInput.addEventListener('input', () => {
                const coerced = coerce(customInput.value);
                if (coerced === undefined) delete values[v.name];
                else values[v.name] = coerced;
                sync();
            });

            row.appendChild(select);
            row.appendChild(customInput);
        } else {
            const input = document.createElement('input');
            input.type = 'text';
            input.className = inputCls + ' flex-1';
            input.placeholder = 'not set';
            input.value = displayValue(values[v.name]);

            const badge = document.createElement('span');
            badge.className = 'text-[10px] text-text-secondary w-14 shrink-0 text-right';
            badge.textContent = typeLabel(values[v.name]);

            input.addEventListener('input', () => {
                const coerced = coerce(input.value);
                if (coerced === undefined) delete values[v.name];
                else values[v.name] = coerced;
                badge.textContent = typeLabel(values[v.name]);
                sync();
            });

            row.appendChild(input);
            row.appendChild(badge);
        }

        return row;
    }

    function renderCustomRow(key) {
        const row = document.createElement('div');
        row.className = 'flex items-center gap-2';

        const keyInput = document.createElement('input');
        keyInput.type = 'text';
        keyInput.className = inputCls + ' w-40 shrink-0 font-mono text-xs';
        keyInput.placeholder = 'key';
        keyInput.value = key;

        const valueInput = document.createElement('input');
        valueInput.type = 'text';
        valueInput.className = inputCls + ' flex-1';
        valueInput.placeholder = 'value';
        valueInput.value = displayValue(values[key]);

        const badge = document.createElement('span');
        badge.className = 'text-[10px] text-text-secondary w-14 shrink-0 text-right';
        badge.textContent = typeLabel(values[key]);

        keyInput.addEventListener('change', () => {
            const newKey = keyInput.value.trim();
            if (!newKey || newKey === key || newKey in values || detected.some(d => d.name === newKey)) {
                keyInput.value = key;
                return;
            }
            values[newKey] = values[key];
            delete values[key];
            key = newKey;
            sync();
        });

        valueInput.addEventListener('input', () => {
            const coerced = coerce(valueInput.value);
            if (coerced === undefined) delete values[key];
            else values[key] = coerced;
            badge.textContent = typeLabel(values[key]);
            sync();
        });

        const removeBtn = smallBtn('✕', 'Remove');
        removeBtn.addEventListener('click', () => {
            delete values[key];
            sync();
            render();
        });

        row.appendChild(keyInput);
        row.appendChild(valueInput);
        row.appendChild(badge);
        row.appendChild(removeBtn);
        return row;
    }

    function render() {
        rowsContainer.innerHTML = '';

        detected.forEach(v => rowsContainer.appendChild(renderDetectedRow(v)));
        customKeys().forEach(key => rowsContainer.appendChild(renderCustomRow(key)));

        if (rowsContainer.children.length === 0) {
            const empty = document.createElement('p');
            empty.className = 'text-xs text-text-secondary italic';
            empty.textContent = 'No kwargs set.';
            rowsContainer.appendChild(empty);
        }

        if (hint) {
            hint.textContent = detected.length > 0
                ? `Detected ${detected.length} variable${detected.length === 1 ? '' : 's'} from this model's template.`
                : '';
            hint.classList.toggle('hidden', detected.length === 0);
        }
    }

    if (addBtn) {
        addBtn.addEventListener('click', () => {
            let n = 1, key = 'key';
            while (key in values || detected.some(d => d.name === key)) key = `key${n++}`;
            values[key] = '';
            sync();
            render();
        });
    }

    rawInput.addEventListener('change', () => {
        try {
            const parsed = JSON.parse(rawInput.value || '{}');
            values = (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) ? parsed : {};
        } catch (e) {
            return; // leave rows as-is while the JSON is mid-edit / invalid
        }
        render();
    });

    async function refreshDetected(modelId) {
        if (!modelId) { detected = []; render(); return; }
        try {
            const resp = await fetch(`?handler=TemplateVariables&modelId=${encodeURIComponent(modelId)}`);
            detected = resp.ok ? await resp.json() : [];
        } catch (e) {
            detected = [];
        }
        render();
    }

    if (modelSelect) {
        modelSelect.addEventListener('change', () => refreshDetected(modelSelect.value));
    }

    render();
    sync();

    // Re-syncs against the currently selected model in case it differs from the
    // preset's last-saved template (e.g. after a validation error re-render).
    if (modelSelect && modelSelect.value) {
        refreshDetected(modelSelect.value);
    }
})();
</script>

<script>
(function () {
    const mtpCheckbox = document.getElementById('mtp-checkbox');
    const specTypeInput = document.getElementById('spec-type-input');
    const specDraftNMaxInput = document.getElementById('spec-draft-n-max-input');
    if (!mtpCheckbox || !specTypeInput) return;

    const MTP_VALUE = 'draft-mtp';

    function applyLockedState(locked) {
        specTypeInput.readOnly = locked;
        specTypeInput.classList.toggle('opacity-60', locked);
    }

    mtpCheckbox.checked = specTypeInput.value.trim() === MTP_VALUE;
    applyLockedState(mtpCheckbox.checked);

    mtpCheckbox.addEventListener('change', () => {
        if (mtpCheckbox.checked) {
            specTypeInput.value = MTP_VALUE;
            if (specDraftNMaxInput && !specDraftNMaxInput.value.trim())
                specDraftNMaxInput.value = '3';
        } else if (specTypeInput.value.trim() === MTP_VALUE) {
            specTypeInput.value = '';
        }
        applyLockedState(mtpCheckbox.checked);
    });
})();
</script>

