@page
@using LR.Application.Pages.Features.Presets
@model PresetCreateModel
@{
    ViewData["Title"] = "Create Preset";
}

@* Helper: input class *@
@{ var inpCls = "w-full px-3 py-2 rounded-lg bg-cyber-bg-dark border border-gray-600/30 text-gray-100 focus:border-neon-magenta focus:ring-1 focus:ring-neon-magenta/30 outline-none transition-all placeholder-gray-500"; }
@{ var selCls = "w-full px-3 py-2 rounded-lg bg-cyber-bg-dark border border-gray-600/30 text-gray-100 focus:border-neon-magenta focus:ring-1 focus:ring-neon-magenta/30 outline-none transition-all"; }


<div class="max-w-4xl mx-auto">
    <form method="post" class="space-y-6">
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="bg-red-500/10 border border-red-500/30 rounded-xl p-4 space-y-2">
                <h3 class="text-sm font-semibold text-red-400">Please fix the following errors:</h3>
                <ul class="list-disc list-inside text-sm text-red-300 space-y-1">
                    @foreach (var entry in ViewData.ModelState.Values.Where(e => e?.Errors != null && e.Errors.Any()))
                    {
                        @foreach (var error in entry.Errors)
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    }
                </ul>
            </div>
        }

        <!-- ==================== IDENTITY ==================== -->
        <div class="bg-cyber-card rounded-xl p-6 border border-neon-magenta/10 space-y-4">
            <h2 class="text-lg font-semibold text-gray-100">Identity</h2>

            <!-- Server Instance -->
            <div>
                <label asp-for="ViewModel.ServerInstanceId" class="block text-sm font-medium text-gray-300 mb-1"></label>
                <select asp-for="ViewModel.ServerInstanceId" asp-items="@(new SelectList(Model.Servers, "Id", "Name"))"
                        class="@selCls @Html.Raw(ViewData.ModelState["ViewModel.ServerInstanceId"]?.Errors?.Any() == true ? "border-red-500/60" : "")">
                    <option value="">— Select a server —</option>
                </select>
                <span asp-validation-for="ViewModel.ServerInstanceId" class="text-xs text-red-400"></span>
            </div>

            <!-- Name -->
            <div>
                <label asp-for="ViewModel.Name" class="block text-sm font-medium text-gray-300 mb-1"></label>
                <input asp-for="ViewModel.Name" required placeholder="e.g. llama-3-cuda"
                       class="@inpCls @Html.Raw(ViewData.ModelState["ViewModel.Name"]?.Errors?.Any() == true ? "border-red-500/60" : "")" />
                <span asp-validation-for="ViewModel.Name" class="text-xs text-red-400"></span>
            </div>

            <!-- Model Path -->
            <div>
                <label asp-for="ViewModel.ModelPath" class="block text-sm font-medium text-gray-300 mb-1"></label>
                <input asp-for="ViewModel.ModelPath" required placeholder="/path/to/model.gguf"
                       class="@inpCls @Html.Raw(ViewData.ModelState["ViewModel.ModelPath"]?.Errors?.Any() == true ? "border-red-500/60" : "")" />
                <span asp-validation-for="ViewModel.ModelPath" class="text-xs text-red-400"></span>
            </div>
        </div>

        <!-- ==================== CORE SETTINGS (Always Visible) ==================== -->
        <div class="bg-cyber-card rounded-xl p-6 border border-neon-magenta/10 space-y-4">
            <h2 class="text-lg font-semibold text-gray-100">Core Settings</h2>

            <!-- Context Size & GPU Layers -->
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label asp-for="ViewModel.ContextSize" class="block text-sm font-medium text-gray-300 mb-1"></label>
                    <input asp-for="ViewModel.ContextSize" type="number" min="0"
                           placeholder="from model"
                           class="@inpCls" />
                </div>
                <div>
                    <label asp-for="ViewModel.GpuLayers" class="block text-sm font-medium text-gray-300 mb-1"></label>
                    <input asp-for="ViewModel.GpuLayers" type="number"
                           placeholder="auto"
                           class="@inpCls" />
                </div>
            </div>

            <!-- KV Cache Types -->
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label asp-for="ViewModel.CacheTypeK" class="block text-sm font-medium text-gray-300 mb-1"></label>
                    <select asp-for="ViewModel.CacheTypeK" class="@selCls">
                        <option value="">— default (f16) —</option>
                        @foreach (var v in new[] { "f32", "f16", "bf16", "q8_0", "q4_0", "q4_1", "iq4_nl", "q5_0", "q5_1" })
                        {
                            <option value="@v">@v</option>
                        }
                    </select>
                </div>
                <div>
                    <label asp-for="ViewModel.CacheTypeV" class="block text-sm font-medium text-gray-300 mb-1"></label>
                    <select asp-for="ViewModel.CacheTypeV" class="@selCls">
                        <option value="">— default (f16) —</option>
                        @foreach (var v in new[] { "f32", "f16", "bf16", "q8_0", "q4_0", "q4_1", "iq4_nl", "q5_0", "q5_1" })
                        {
                            <option value="@v">@v</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Flash Attention & Jinja -->
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label asp-for="ViewModel.FlashAttention" class="block text-sm font-medium text-gray-300 mb-1"></label>
                    <select asp-for="ViewModel.FlashAttention" class="@selCls">
                        <option value="">— default (auto) —</option>
                        <option value="on">on</option>
                        <option value="off">off</option>
                        <option value="auto">auto</option>
                    </select>
                </div>
                <div>
                    <label asp-for="ViewModel.Jinja" class="block text-sm font-medium text-gray-300 mb-1"></label>
                    <select asp-for="ViewModel.Jinja" class="@selCls">
                        <option value="">— default (enabled) —</option>
                        <option value="True">enabled</option>
                        <option value="False">disabled</option>
                    </select>
                </div>
            </div>

            <!-- Spec Type -->
            <div>
                <label asp-for="ViewModel.SpecType" class="block text-sm font-medium text-gray-300 mb-1"></label>
                <input asp-for="ViewModel.SpecType" placeholder="none, ngram-simple, draft-eagle3, ..."
                       class="@inpCls" />
            </div>
        </div>

        <!-- ==================== SAMPLING (Always Visible) ==================== -->
        <div class="bg-cyber-card rounded-xl p-6 border border-neon-magenta/10 space-y-4">
            <h2 class="text-lg font-semibold text-gray-100">Sampling</h2>

            <!-- Temperature & Top-K -->
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label asp-for="ViewModel.Temperature" class="block text-sm font-medium text-gray-300 mb-1"></label>
                    <input asp-for="ViewModel.Temperature" type="number" step="any"
                           placeholder="0.8"
                           class="@inpCls" />
                </div>
                <div>
                    <label asp-for="ViewModel.TopK" class="block text-sm font-medium text-gray-300 mb-1"></label>
                    <input asp-for="ViewModel.TopK" type="number"
                           placeholder="40"
                           class="@inpCls" />
                </div>
            </div>

            <!-- Min-P & Top-P -->
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label asp-for="ViewModel.MinP" class="block text-sm font-medium text-gray-300 mb-1"></label>
                    <input asp-for="ViewModel.MinP" type="number" step="any"
                           placeholder="0.05"
                           class="@inpCls" />
                </div>
                <div>
                    <label asp-for="ViewModel.TopP" class="block text-sm font-medium text-gray-300 mb-1"></label>
                    <input asp-for="ViewModel.TopP" type="number" step="any"
                           placeholder="0.95"
                           class="@inpCls" />
                </div>
            </div>

            <!-- Repeat Penalty & Presence Penalty -->
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label asp-for="ViewModel.RepeatPenalty" class="block text-sm font-medium text-gray-300 mb-1"></label>
                    <input asp-for="ViewModel.RepeatPenalty" type="number" step="any"
                           placeholder="1.0"
                           class="@inpCls" />
                </div>
                <div>
                    <label asp-for="ViewModel.PresencePenalty" class="block text-sm font-medium text-gray-300 mb-1"></label>
                    <input asp-for="ViewModel.PresencePenalty" type="number" step="any"
                           placeholder="0.0"
                           class="@inpCls" />
                </div>
            </div>
        </div>

        <!-- ==================== ADVANCED: Generation ==================== -->
        <details class="bg-cyber-card rounded-xl border border-gray-600/20 group">
            <summary class="cursor-pointer px-6 py-4 text-lg font-semibold text-gray-100 hover:text-neon-magenta transition-colors [&::-webkit-details-marker]:hidden flex items-center gap-2">
                <svg class="w-5 h-5 group-open:rotate-90 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                Advanced: Generation
            </summary>
            <div class="px-6 pb-6 space-y-4">
                <div class="grid grid-cols-3 gap-4">
                    <div>
                        <label asp-for="ViewModel.Threads" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.Threads" type="number" placeholder="auto" class="@inpCls" />
                    </div>
                    <div>
                        <label asp-for="ViewModel.ThreadsBatch" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.ThreadsBatch" type="number" placeholder="auto" class="@inpCls" />
                    </div>
                    <div>
                        <label asp-for="ViewModel.PredictN" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.PredictN" type="number" placeholder="-1 (∞)" class="@inpCls" />
                    </div>
                </div>
                <div class="grid grid-cols-3 gap-4">
                    <div>
                        <label asp-for="ViewModel.BatchSize" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.BatchSize" type="number" placeholder="2048" class="@inpCls" />
                    </div>
                    <div>
                        <label asp-for="ViewModel.UbatchSize" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.UbatchSize" type="number" placeholder="512" class="@inpCls" />
                    </div>
                    <div>
                        <label asp-for="ViewModel.KeepN" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.KeepN" type="number" placeholder="0" class="@inpCls" />
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="ViewModel.Seed" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.Seed" type="number" placeholder="random" class="@inpCls" />
                    </div>
                    <div>
                        <label asp-for="ViewModel.IgnoreEos" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <select asp-for="ViewModel.IgnoreEos" class="@selCls">
                            <option value="">— default (false) —</option>
                            <option value="True">enabled</option>
                            <option value="False">disabled</option>
                        </select>
                    </div>
                </div>
            </div>
        </details>

        <!-- ==================== ADVANCED: GPU/Device ==================== -->
        <details class="bg-cyber-card rounded-xl border border-gray-600/20 group">
            <summary class="cursor-pointer px-6 py-4 text-lg font-semibold text-gray-100 hover:text-neon-magenta transition-colors [&::-webkit-details-marker]:hidden flex items-center gap-2">
                <svg class="w-5 h-5 group-open:rotate-90 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                Advanced: GPU / Device
            </summary>
            <div class="px-6 pb-6 space-y-4">
                <div class="grid grid-cols-3 gap-4">
                    <div>
                        <label asp-for="ViewModel.Device" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.Device" placeholder="cuda0,cuda1" class="@inpCls" />
                    </div>
                    <div>
                        <label asp-for="ViewModel.SplitMode" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <select asp-for="ViewModel.SplitMode" class="@selCls">
                            <option value="">— default (layer) —</option>
                            <option value="none">none</option>
                            <option value="layer">layer</option>
                            <option value="row">row</option>
                            <option value="tensor">tensor</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="ViewModel.TensorSplit" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.TensorSplit" placeholder="3,1" class="@inpCls" />
                    </div>
                </div>
                <div class="grid grid-cols-4 gap-4">
                    <div>
                        <label asp-for="ViewModel.MainGpu" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.MainGpu" type="number" placeholder="0" class="@inpCls" />
                    </div>
                    <div>
                        <label asp-for="ViewModel.Fit" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <select asp-for="ViewModel.Fit" class="@selCls">
                            <option value="">— default (on) —</option>
                            <option value="on">on</option>
                            <option value="off">off</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="ViewModel.KvOffload" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <select asp-for="ViewModel.KvOffload" class="@selCls">
                            <option value="">— default (enabled) —</option>
                            <option value="True">enabled</option>
                            <option value="False">disabled</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="ViewModel.Repack" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <select asp-for="ViewModel.Repack" class="@selCls">
                            <option value="">— default (enabled) —</option>
                            <option value="True">enabled</option>
                            <option value="False">disabled</option>
                        </select>
                    </div>
                </div>
            </div>
        </details>

        <!-- ==================== ADVANCED: Memory ==================== -->
        <details class="bg-cyber-card rounded-xl border border-gray-600/20 group">
            <summary class="cursor-pointer px-6 py-4 text-lg font-semibold text-gray-100 hover:text-neon-magenta transition-colors [&::-webkit-details-marker]:hidden flex items-center gap-2">
                <svg class="w-5 h-5 group-open:rotate-90 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                Advanced: Memory
            </summary>
            <div class="px-6 pb-6 space-y-4">
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="ViewModel.LoadMode" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <select asp-for="ViewModel.LoadMode" class="@selCls">
                            <option value="">— default (mmap) —</option>
                            <option value="none">none</option>
                            <option value="mmap">mmap</option>
                            <option value="mlock">mlock</option>
                            <option value="dio">dio</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="ViewModel.CacheRam" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.CacheRam" type="number" placeholder="8192 (MiB)" class="@inpCls" />
                    </div>
                </div>
            </div>
        </details>

        <!-- ==================== ADVANCED: RoPE Scaling ==================== -->
        <details class="bg-cyber-card rounded-xl border border-gray-600/20 group">
            <summary class="cursor-pointer px-6 py-4 text-lg font-semibold text-gray-100 hover:text-neon-magenta transition-colors [&::-webkit-details-marker]:hidden flex items-center gap-2">
                <svg class="w-5 h-5 group-open:rotate-90 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                Advanced: RoPE Scaling
            </summary>
            <div class="px-6 pb-6 space-y-4">
                <div class="grid grid-cols-3 gap-4">
                    <div>
                        <label asp-for="ViewModel.RopeScalingType" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <select asp-for="ViewModel.RopeScalingType" class="@selCls">
                            <option value="">— default —</option>
                            <option value="none">none</option>
                            <option value="linear">linear</option>
                            <option value="yarn">yarn</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="ViewModel.RopeScale" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.RopeScale" type="number" step="any" class="@inpCls" />
                    </div>
                    <div>
                        <label asp-for="ViewModel.RopeFreqBase" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.RopeFreqBase" type="number" step="any" class="@inpCls" />
                    </div>
                </div>
                <div class="grid grid-cols-3 gap-4">
                    <div>
                        <label asp-for="ViewModel.RopeFreqScale" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.RopeFreqScale" type="number" step="any" class="@inpCls" />
                    </div>
                    <div>
                        <label asp-for="ViewModel.YarnOrigCtx" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.YarnOrigCtx" type="number" placeholder="model ctx" class="@inpCls" />
                    </div>
                    <div>
                        <label asp-for="ViewModel.YarnExtFactor" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.YarnExtFactor" type="number" step="any" placeholder="-1.00" class="@inpCls" />
                    </div>
                </div>
                <div class="grid grid-cols-3 gap-4">
                    <div>
                        <label asp-for="ViewModel.YarnAttnFactor" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.YarnAttnFactor" type="number" step="any" placeholder="-1.00" class="@inpCls" />
                    </div>
                    <div>
                        <label asp-for="ViewModel.YarnBetaSlow" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.YarnBetaSlow" type="number" step="any" placeholder="-1.00" class="@inpCls" />
                    </div>
                    <div>
                        <label asp-for="ViewModel.YarnBetaFast" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.YarnBetaFast" type="number" step="any" placeholder="-1.00" class="@inpCls" />
                    </div>
                </div>
            </div>
        </details>

        <!-- ==================== ADVANCED: Sampling (Extended) ==================== -->
        <details class="bg-cyber-card rounded-xl border border-gray-600/20 group">
            <summary class="cursor-pointer px-6 py-4 text-lg font-semibold text-gray-100 hover:text-neon-magenta transition-colors [&::-webkit-details-marker]:hidden flex items-center gap-2">
                <svg class="w-5 h-5 group-open:rotate-90 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                Advanced: Sampling (Extended)
            </summary>
            <div class="px-6 pb-6 space-y-4">
                <!-- Top-N-Sigma, XTC, Typical-P -->
                <div class="grid grid-cols-3 gap-4">
                    <div>
                        <label asp-for="ViewModel.TopNSigma" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.TopNSigma" type="number" step="any" placeholder="-1.00 (off)" class="@inpCls" />
                    </div>
                    <div>
                        <label asp-for="ViewModel.XtcProbability" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.XtcProbability" type="number" step="any" placeholder="0 (off)" class="@inpCls" />
                    </div>
                    <div>
                        <label asp-for="ViewModel.XtcThreshold" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.XtcThreshold" type="number" step="any" placeholder="0.10" class="@inpCls" />
                    </div>
                </div>
                <div class="grid grid-cols-3 gap-4">
                    <div>
                        <label asp-for="ViewModel.TypicalP" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.TypicalP" type="number" step="any" placeholder="1.0 (off)" class="@inpCls" />
                    </div>
                    <div>
                        <label asp-for="ViewModel.RepeatLastN" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.RepeatLastN" type="number" placeholder="64" class="@inpCls" />
                    </div>
                    <div>
                        <label asp-for="ViewModel.FrequencyPenalty" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.FrequencyPenalty" type="number" step="any" placeholder="0.0" class="@inpCls" />
                    </div>
                </div>

                <!-- DRY -->
                <h3 class="text-sm font-semibold text-gray-400 mt-2">DRY</h3>
                <div class="grid grid-cols-4 gap-4">
                    <div>
                        <label asp-for="ViewModel.DryMultiplier" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.DryMultiplier" type="number" step="any" placeholder="0 (off)" class="@inpCls" />
                    </div>
                    <div>
                        <label asp-for="ViewModel.DryBase" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.DryBase" type="number" step="any" placeholder="1.75" class="@inpCls" />
                    </div>
                    <div>
                        <label asp-for="ViewModel.DryAllowedLength" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.DryAllowedLength" type="number" placeholder="2" class="@inpCls" />
                    </div>
                    <div>
                        <label asp-for="ViewModel.DryPenaltyLastN" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.DryPenaltyLastN" type="number" placeholder="-1 (ctx)" class="@inpCls" />
                    </div>
                </div>

                <!-- Mirostat -->
                <h3 class="text-sm font-semibold text-gray-400 mt-2">Mirostat</h3>
                <div class="grid grid-cols-3 gap-4">
                    <div>
                        <label asp-for="ViewModel.Mirostat" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <select asp-for="ViewModel.Mirostat" class="@selCls">
                            <option value="">— off —</option>
                            <option value="0">off</option>
                            <option value="1">Mirostat 1.0</option>
                            <option value="2">Mirostat 2.0</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="ViewModel.MirostatTau" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.MirostatTau" type="number" step="any" placeholder="5.0 (eta)" class="@inpCls" />
                    </div>
                    <div>
                        <label asp-for="ViewModel.MirostatEta" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.MirostatEta" type="number" step="any" placeholder="0.1 (lr)" class="@inpCls" />
                    </div>
                </div>

                <!-- Dynatemp -->
                <h3 class="text-sm font-semibold text-gray-400 mt-2">Dynatemp</h3>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="ViewModel.DynatempRange" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.DynatempRange" type="number" step="any" placeholder="0 (off)" class="@inpCls" />
                    </div>
                    <div>
                        <label asp-for="ViewModel.DynatempExp" class="block text-sm font-medium text-gray-300 mb-1"></label>
                        <input asp-for="ViewModel.DynatempExp" type="number" step="any" placeholder="1.0" class="@inpCls" />
                    </div>
                </div>
