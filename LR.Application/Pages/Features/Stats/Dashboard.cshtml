@page
@using LR.Core.Models
@model LR.Application.Pages.Features.Stats.DashboardModel
@{
    ViewData["Title"] = "Statistics Dashboard";
}

<div class="max-w-7xl mx-auto px-4 py-6">
    <h1 class="text-3xl font-bold mb-6 text-neon-cyan flex items-center gap-3">
        <span aria-hidden="true">📊</span> Statistics Dashboard
        <span id="statsLiveBadge" class="inline-flex items-center gap-1.5 text-xs font-medium px-2 py-0.5 rounded-full bg-gray-700/30 text-text-secondary border border-gray-600/30 align-middle" title="SignalR live-update connection status">
            <span id="statsLiveDot" class="w-1.5 h-1.5 rounded-full bg-gray-500"></span>
            <span id="statsLiveText">Connecting…</span>
        </span>
    </h1>

    <!-- Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <div class="bg-cyber-card rounded-xl p-5 border border-gray-700/30 shadow-neon-cyan">
            <p class="text-sm text-text-secondary">Total Requests (24h)</p>
            <p id="statTotalRequests" class="text-3xl font-bold mt-1 text-neon-cyan">@Model.TotalRequests</p>
        </div>
        <div class="bg-cyber-card rounded-xl p-5 border border-gray-700/30 shadow-neon-green">
            <p class="text-sm text-text-secondary">Total Tokens (24h)</p>
            <p id="statTotalTokens" class="text-3xl font-bold mt-1 text-neon-green">@Model.TotalTokens</p>
        </div>
        <div class="bg-cyber-card rounded-xl p-5 border border-gray-700/30 shadow-neon-magenta">
            <p class="text-sm text-text-secondary">Avg Latency (24h)</p>
            <p id="statAvgLatency" class="text-3xl font-bold mt-1 text-neon-magenta">@string.Format("{0:F1}", Model.AvgLatencyMs) ms</p>
        </div>
        <div class="bg-cyber-card rounded-xl p-5 border border-gray-700/30 shadow-neon-cyan">
            <p class="text-sm text-text-secondary">Active Servers</p>
            <p class="text-3xl font-bold mt-1 text-neon-cyan">@Model.Servers.Count(s => s.Status == ServerStatus.Running)</p>
        </div>
    </div>

    <!-- Time Range Selector -->
    <div class="flex gap-2 mb-6">
        @foreach (var range in new[] { "1h", "6h", "24h", "7d" })
        {
            var activeClass = range == "24h"
                ? "bg-neon-cyan/20 text-neon-cyan border-neon-cyan shadow-neon-cyan"
                : "bg-gray-800/50 text-text-secondary border-transparent hover:bg-neon-cyan/10 hover:text-neon-cyan";
            <button type="button" onclick="updateAllCharts('@range')" aria-pressed="@(range == "24h" ? "true" : "false")" class="px-4 py-2 rounded-lg text-sm font-medium transition-colors time-btn border @activeClass">
                @range
            </button>
        }
    </div>

    <!-- Charts Row 1 -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
        <!-- Prompt Throughput Chart -->
        <div class="bg-cyber-card rounded-xl p-5 border border-gray-700/30 shadow-neon-cyan">
            <h2 class="text-lg font-semibold mb-4 text-neon-cyan"><span aria-hidden="true">⚡</span> Prompt Processing Speed (tokens/sec)</h2>
            <canvas id="promptThroughputChart"></canvas>
        </div>

        <!-- Generation Throughput Chart -->
        <div class="bg-cyber-card rounded-xl p-5 border border-gray-700/30 shadow-neon-green">
            <h2 class="text-lg font-semibold mb-4 text-neon-green"><span aria-hidden="true">🚀</span> Token Generation Speed (tokens/sec)</h2>
            <canvas id="genThroughputChart"></canvas>
        </div>
    </div>

    <!-- Charts Row 2 -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
        <!-- Context Usage Chart -->
        <div class="bg-cyber-card rounded-xl p-5 border border-gray-700/30 shadow-neon-magenta">
            <h2 class="text-lg font-semibold mb-4 text-neon-magenta"><span aria-hidden="true">🧠</span> Context Window Usage</h2>
            @if (Model.Presets.Any())
            {
                <div class="mb-3">
                    <select id="presetSelect" onchange="updateContextChart()" class="bg-cyber-surface text-text-primary border border-gray-600 rounded-lg px-3 py-1.5 text-sm">
                        @foreach (var preset in Model.Presets)
                        {
                            <option value="@preset.Id">@preset.Name (@(preset.ContextSize?.ToString() ?? "auto")) ctx</option>
                        }
                    </select>
                </div>
            }
            else
            {
                <p class="text-text-secondary text-sm italic mb-3">No presets with data yet. Send some inference requests first.</p>
            }
            <canvas id="contextUsageChart"></canvas>
        </div>

        <!-- Latency Chart -->
        <div class="bg-cyber-card rounded-xl p-5 border border-gray-700/30 shadow-neon-cyan">
            <h2 class="text-lg font-semibold mb-4 text-neon-red"><span aria-hidden="true">⏱️</span> Request Latency (ms)</h2>
            <canvas id="latencyChart"></canvas>
        </div>
    </div>
</div>

<script>
// Wrapped in an IIFE, and the two functions used by inline onclick/onchange exposed via
// window.*: this script re-runs on every htmx-boosted navigation to this page, and the
// top-level let/const below would throw "already declared" the second time.
(function () {
// ── Chart.js theme-aware defaults, read from the active theme's CSS variables so any
// theme added in site.css (see the comment there) picks up chart colors automatically,
// with no changes needed here. ──
const isDarkTheme = document.documentElement.classList.contains('dark');
const rootStyle = getComputedStyle(document.documentElement);
const cssVar = name => rootStyle.getPropertyValue(name).trim();

Chart.defaults.color = cssVar('--text-secondary');
Chart.defaults.borderColor = isDarkTheme ? 'rgba(75,85,99,0.2)' : 'rgba(107,114,128,0.25)';  // grid lines
Chart.defaults.font.family = "'Inter', system-ui, sans-serif";
Chart.defaults.plugins.legend.labels.usePointStyle = true;
Chart.defaults.plugins.tooltip.backgroundColor = 'rgba(10,10,15,0.92)';
Chart.defaults.plugins.tooltip.titleColor = '#f0f0f5';
Chart.defaults.plugins.tooltip.bodyColor = '#d1d5db';
Chart.defaults.plugins.tooltip.borderColor = cssVar('--neon-cyan') + '4d'; // ~30% alpha
Chart.defaults.plugins.tooltip.borderWidth = 1;

const timeRanges = {
    '1h': { hours: 1 },
    '6h': { hours: 6 },
    '24h': { hours: 24 },
    '7d': { hours: 168 }
};

let charts = {};

// Server data from backend
const servers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Servers.Select(s => new { id = s.Id, name = s.Name })));
const serverNames = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ServerNames));
const presets = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Presets.Select(p => new { id = p.Id, name = p.Name })));

// Running summary-card totals, seeded from the page-load snapshot and updated in place as
// SignalR events arrive (see connectStatsHub below) — kept exact via the same incremental-
// average formula GetAvgTotalLatencyAsync uses, since both share the same 24h/all-servers scope.
let liveTotalRequests = @Model.TotalRequests;
let liveTotalTokens = @Model.TotalTokens;
let liveAvgLatencyMs = @Model.AvgLatencyMs;

// Line colors, read straight from the active theme's --neon-* variables (site.css picks
// values that clear >= 3:1 contrast against the canvas background per WCAG 1.4.11 already).
const chartColors = [
    cssVar('--neon-cyan'),
    cssVar('--neon-green'),
    cssVar('--neon-magenta'),
    cssVar('--neon-red'),
];
const chartColorsAlpha = chartColors.map(c => {
    const hex = c.slice(1);
    const r = parseInt(hex.substring(0, 2), 16);
    const g = parseInt(hex.substring(2, 4), 16);
    const b = parseInt(hex.substring(4, 6), 16);
    return `rgba(${r},${g},${b},0.15)`;
});

function getFromTimestamp(rangeKey) {
    const range = timeRanges[rangeKey];
    return new Date(Date.now() - range.hours * 60 * 60 * 1000).toISOString();
}

async function loadPromptThroughput(rangeKey = '24h') {
    const from = getFromTimestamp(rangeKey);
    try {
        const resp = await fetch(`/api/stats/prompt-throughput?from=${encodeURIComponent(from)}`);
        const data = await resp.json();
        return buildMultiServerChart(data, servers, chartColors, 'Prompt Tokens/sec');
    } catch (e) { console.error('Failed to load prompt throughput:', e); }
}

async function loadGenThroughput(rangeKey = '24h') {
    const from = getFromTimestamp(rangeKey);
    try {
        const resp = await fetch(`/api/stats/gen-throughput?from=${encodeURIComponent(from)}`);
        const data = await resp.json();
        return buildMultiServerChart(data, servers, chartColors, 'Gen Tokens/sec');
    } catch (e) { console.error('Failed to load gen throughput:', e); }
}

async function loadLatency(rangeKey = '24h') {
    const from = getFromTimestamp(rangeKey);
    try {
        const resp = await fetch(`/api/stats/latency?from=${encodeURIComponent(from)}`);
        const data = await resp.json();
        return buildMultiServerChart(data, servers, chartColors, 'Latency (ms)');
    } catch (e) { console.error('Failed to load latency:', e); }
}

async function loadContextUsage(rangeKey = '24h') {
    const selectEl = document.getElementById('presetSelect');
    if (!selectEl || !selectEl.value) return;

    const from = getFromTimestamp(rangeKey);
    try {
        const resp = await fetch(`/api/stats/context-usage?presetId=${encodeURIComponent(selectEl.value)}&from=${encodeURIComponent(from)}`);
        const data = await resp.json();

        charts.context.data.labels = data.map(d => new Date(d.timestamp).toLocaleTimeString('en-GB', { hour12: false }));
        charts.context.data.datasets[0].data = data.map(d => d.tokensUsed);
        charts.context.update();
    } catch (e) { console.error('Failed to load context usage:', e); }
}

window.updateContextChart = function() {
    const activeRange = document.querySelector('.time-btn.border-neon-cyan')?.textContent.trim() || '24h';
    loadContextUsage(activeRange);
};

function buildMultiServerChart(dataPointsByServerId, servers, colors, labelPrefix) {
    const datasets = [];
    let allLabels = new Set();

    for (const server of servers) {
        const points = dataPointsByServerId[server.id] || [];
        if (points.length === 0) continue;

        // Build a per-server dataset with nulls aligned to shared labels
        datasets.push({
            label: serverNames[server.id],
            data: [],  // filled after we know all labels
            borderColor: colors[servers.indexOf(server) % colors.length],
            backgroundColor: chartColorsAlpha[servers.indexOf(server) % colors.length],
            tension: 0.3,
            pointRadius: 2,
        });

        points.forEach(p => {
            const label = new Date(p.timestamp).toLocaleTimeString('en-GB', { hour12: false });
            allLabels.add(label);
        });
    }

    // Sort labels chronologically (they're HH:mm:ss strings — lexicographic sort works)
    const sortedLabels = [...allLabels].sort();

    // For each dataset, map points to the shared label index
    for (const server of servers) {
        const points = dataPointsByServerId[server.id] || [];
        if (points.length === 0) continue;

        const pointMap = {};
        points.forEach(p => {
            const label = new Date(p.timestamp).toLocaleTimeString('en-GB', { hour12: false });
            const yVal = Math.round(p.value * 100) / 100;
            // If multiple points share the same time label, keep the last one
            pointMap[label] = yVal;
        });

        const idx = datasets.findIndex(d => d.label === serverNames[server.id]);
        if (idx >= 0) {
            datasets[idx].data = sortedLabels.map(label => pointMap[label] ?? null);
        }
    }

    return { datasets, labels: sortedLabels };
}

function initChart(canvasId, label) {
    const ctx = document.getElementById(canvasId).getContext('2d');
    return new Chart(ctx, {
        type: 'line',
        data: { labels: [], datasets: [] },
        options: {
            responsive: true,
            animation: false,
            scales: {
                x: {
                    title: { display: true, text: 'Time' }
                },
                y: {
                    beginAtZero: true,
                    title: { display: true, text: label }
                }
            },
            plugins: {
                legend: { position: 'top' },
                tooltip: { mode: 'index', intersect: false }
            }
        }
    });
}

window.updateAllCharts = async function(rangeKey = '24h') {
    // Update active button styling
    document.querySelectorAll('.time-btn').forEach(btn => {
        const isMatch = btn.textContent.trim() === rangeKey;
        btn.classList.toggle('border-neon-cyan', isMatch);
        btn.classList.toggle('border-transparent', !isMatch);
        btn.setAttribute('aria-pressed', isMatch ? 'true' : 'false');
    });

    // Prompt throughput
    const ptData = await loadPromptThroughput(rangeKey);
    if (ptData) {
        charts.prompt.data.labels = ptData.labels;
        charts.prompt.data.datasets = ptData.datasets;
        charts.prompt.update();
    }

    // Gen throughput
    const gtData = await loadGenThroughput(rangeKey);
    if (gtData) {
        charts.gen.data.labels = gtData.labels;
        charts.gen.data.datasets = gtData.datasets;
        charts.gen.update();
    }

    // Latency
    const latData = await loadLatency(rangeKey);
    if (latData) {
        charts.latency.data.labels = latData.labels;
        charts.latency.data.datasets = latData.datasets;
        charts.latency.update();
    }

    // Context usage
    loadContextUsage(rangeKey);
};

// Runs immediately rather than waiting for DOMContentLoaded: the canvases above are
// already in the document by the time this script executes (both on a normal page load,
// where script execution always follows earlier markup, and on an htmx-boosted navigation,
// where the whole fragment — canvases included — is inserted before its scripts run).
// DOMContentLoaded fires once per real browser navigation, so gating on it here would mean
// this init never runs on a boosted revisit to this page.

// Destroy any charts from a previous visit to this page — htmx's boosted navigation keeps
// this JS realm alive across page swaps, so without this, revisiting would leak Chart.js
// instances bound to now-detached canvases.
if (window.__statsCharts) {
    Object.values(window.__statsCharts).forEach(c => c.destroy());
}

charts.prompt = initChart('promptThroughputChart', 'Prompt Tokens/sec');
charts.gen = initChart('genThroughputChart', 'Gen Tokens/sec');
charts.latency = initChart('latencyChart', 'Latency (ms)');

// Context usage chart (bar chart)
const ctxContext = document.getElementById('contextUsageChart').getContext('2d');
charts.context = new Chart(ctxContext, {
    type: 'bar',
    data: { labels: [], datasets: [{ label: 'Tokens Used', data: [], backgroundColor: chartColors[0] + '99', borderColor: chartColors[0], borderWidth: 1 }] },
    options: {
        responsive: true,
        animation: false,
        scales: {
            x: { title: { display: true, text: 'Time' } },
            y: { beginAtZero: true, title: { display: true, text: 'Tokens Used' } }
        }
    }
});

window.__statsCharts = charts;
window.updateAllCharts('24h');

// ── Live updates via SignalR ──
// Connection is stored on window and reused across htmx-boosted navigations, following the
// same pattern as /serverHub (see Index.cshtml): detach this page's previous handler first
// since it's a closure over now-stale DOM/counters, then (re)attach against the shared
// connection so revisiting this page doesn't disconnect/reconnect the socket each time.
if (window.__statsHubHandler && window.__statsHubConnection) {
    window.__statsHubConnection.off('ReceiveStatUpdate', window.__statsHubHandler);
    window.__statsHubHandler = null;
}

function setLiveBadge(state) {
    const dot = document.getElementById('statsLiveDot');
    const text = document.getElementById('statsLiveText');
    if (!dot || !text) return;
    const styles = {
        connecting: { dot: 'bg-gray-500', label: 'Connecting…' },
        live: { dot: 'bg-neon-green animate-pulse', label: 'Live' },
        down: { dot: 'bg-neon-red', label: 'Disconnected' },
    };
    const s = styles[state] || styles.connecting;
    dot.className = 'w-1.5 h-1.5 rounded-full ' + s.dot;
    text.textContent = s.label;
}

// Refreshing all four charts on every single event would hammer the /api/stats/* endpoints
// during a burst of concurrent requests, so refreshes are coalesced to at most once per
// interval instead of firing immediately for every incoming stat.
let chartRefreshPending = false;
function scheduleChartRefresh() {
    if (chartRefreshPending) return;
    chartRefreshPending = true;
    setTimeout(() => {
        chartRefreshPending = false;
        const activeRange = document.querySelector('.time-btn.border-neon-cyan')?.textContent.trim() || '24h';
        window.updateAllCharts(activeRange);
    }, 2000);
}

function handleStatUpdate(stat) {
    liveTotalRequests += 1;
    liveTotalTokens += stat.promptTokensProcessed + stat.generatedTokenCount;
    liveAvgLatencyMs = ((liveAvgLatencyMs * (liveTotalRequests - 1)) + stat.totalLatencyMs) / liveTotalRequests;

    const reqEl = document.getElementById('statTotalRequests');
    const tokEl = document.getElementById('statTotalTokens');
    const latEl = document.getElementById('statAvgLatency');
    if (reqEl) reqEl.textContent = liveTotalRequests;
    if (tokEl) tokEl.textContent = liveTotalTokens;
    if (latEl) latEl.textContent = liveAvgLatencyMs.toFixed(1) + ' ms';

    scheduleChartRefresh();
}

function connectStatsHub() {
    let connection = window.__statsHubConnection;
    const isLive = connection && connection.state !== signalR.HubConnectionState.Disconnected;

    if (!isLive) {
        connection = new signalR.HubConnectionBuilder()
            .withUrl('/statsHub', { transport: signalR.HttpTransportType.WebSockets })
            .withAutomaticReconnect()
            .build();
        window.__statsHubConnection = connection;

        connection.onreconnecting(() => setLiveBadge('connecting'));
        connection.onreconnected(() => setLiveBadge('live'));
        connection.onclose(() => setLiveBadge('down'));
    }

    connection.on('ReceiveStatUpdate', handleStatUpdate);
    window.__statsHubHandler = handleStatUpdate;

    if (!isLive) {
        connection.start().then(() => {
            setLiveBadge('live');
        }).catch(err => {
            console.warn('[SignalR] statsHub connection failed:', err.message);
            setLiveBadge('down');
        });
    } else {
        setLiveBadge('live');
    }
}

connectStatsHub();
})();
</script>
