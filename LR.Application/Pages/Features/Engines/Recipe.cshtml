@page
@using LR.Core.Models
@model LR.Application.Pages.Features.Engines.EngineRecipeModel
@{
    ViewData["Title"] = Model.IsExisting ? "Edit recipe" : "New recipe";
    string input = "w-full px-3 py-2 rounded-lg bg-cyber-bg-dark border border-gray-600/30 text-text-primary focus:border-neon-magenta focus:ring-1 focus:ring-neon-magenta/30 outline-none transition-all";
    string label = "block text-sm font-medium text-text-secondary mb-1";
    // TensorFold builds with Zig: its recipe's arguments are zig build's, and the CMake-only fields go.
    var zig = Model.Input.Engine == ServerEngine.TensorFold;
    var argsPlaceholder = zig ? "-Dgpu=sm_120" : "-DGGML_SYCL=ON\n-DGGML_SYCL_F16=ON";
}

<div class="flex items-center gap-3 mb-6">
    <a href="/Features/Engines/Index?engine=@Model.Input.Engine" class="text-text-secondary hover:text-neon-cyan transition-colors text-sm">← Engines</a>
    <span class="text-text-secondary">/</span>
    <p class="text-text-primary text-sm font-medium">@ViewData["Title"]</p>
</div>

@if (Model.IsBuiltIn)
{
    <div class="bg-cyber-card border border-neon-cyan/20 text-text-secondary rounded-lg px-4 py-3 text-sm mb-6">
        This is a built-in template — saving your changes creates a new editable copy.
    </div>
}
@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="bg-red-500/10 border border-red-500/30 text-neon-red rounded-lg px-4 py-3 text-sm mb-6">@Model.StatusMessage</div>
}

<form method="post" hx-boost="false" class="bg-cyber-card rounded-xl border border-gray-700/30 p-6 space-y-4 max-w-3xl">
    @Html.AntiForgeryToken()
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
            <label class="@label" asp-for="Input.Name">Name</label>
            <input class="@input" asp-for="Input.Name" />
        </div>
        <div>
            <label class="@label" asp-for="Input.Engine">Engine</label>
            <select class="@input" asp-for="Input.Engine">
                @foreach (var (engine, engineLabel) in LR.Application.Pages.Features.Engines.EngineRecipeModel.RecipeEngines)
                {
                    <option value="@engine" data-repo="@LlamaCppBuildRecipe.DefaultRepoUrl(engine)" data-ref="@LlamaCppBuildRecipe.DefaultGitRef(engine)" data-zig="@(engine == ServerEngine.TensorFold ? "true" : "false")" selected="@(engine == Model.Input.Engine)">@engineLabel</option>
                }
            </select>
        </div>
        <div>
            <label class="@label" asp-for="Input.BackendType">Backend</label>
            <select class="@input" asp-for="Input.BackendType" asp-items="Html.GetEnumSelectList<BackendType>()"></select>
        </div>
    </div>
    <div>
        <label class="@label" asp-for="Input.Description">Description</label>
        <input class="@input" asp-for="Input.Description" />
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
            <label class="@label" asp-for="Input.GitRepoUrl">Git repo URL</label>
            <input class="@input" asp-for="Input.GitRepoUrl" />
        </div>
        <div>
            <label class="@label" asp-for="Input.GitRef">Git ref (branch / tag / SHA)</label>
            <input class="@input" asp-for="Input.GitRef" />
        </div>
    </div>
    <div>
        <label class="@label" asp-for="Input.CMakeArgsText" id="args-label" data-cmake="CMake arguments (one per line)" data-zig="zig build arguments (one per line)">@(zig ? "zig build arguments (one per line)" : "CMake arguments (one per line)")</label>
        <textarea class="@input font-mono text-xs" rows="6" asp-for="Input.CMakeArgsText" placeholder="@argsPlaceholder"></textarea>
        <div id="zig-help" class="@(zig ? "" : "hidden") text-xs text-text-secondary mt-1 space-y-1">
            <p>
                Runs <span class="font-mono">zig build &lt;these&gt;</span> in the checkout with the Zig version it pins (downloaded once), then builds the
                grammar library from the xgrammar tag it pins. The server must land in <span class="font-mono">zig-out/native</span> (CUDA,
                <span class="font-mono">-Dgpu=sm_NN</span>), <span class="font-mono">zig-out/native-hip</span> (HIP, <span class="font-mono">native-hip -Dhip=true -Dhip-arch=gfxNNNN</span>)
                or <span class="font-mono">zig-out/xpu</span> (XPU, <span class="font-mono">xpu-native</span>) — the backend above picks which.
            </p>
            <p>
                Filled in when left out: <span class="font-mono">-Dnvcc</span> from the installed CUDA Toolkit, <span class="font-mono">-Dhipcc</span> from the HIP SDK / ROCm,
                <span class="font-mono">-Docloc</span> and the nGEN headers for XPU. On Windows a CUDA build runs under Visual Studio's <span class="font-mono">vcvars64.bat</span>
                unless an environment setup command is set below. XPU builds only on Linux.
            </p>
        </div>
    </div>

    <details data-cmake-only class="@(zig ? "hidden" : "") rounded-lg border border-gray-600/30 bg-cyber-bg-dark/40 group">
        <summary class="cursor-pointer px-4 py-2.5 text-sm font-medium text-text-secondary hover:text-neon-cyan transition-colors [&::-webkit-details-marker]:hidden flex items-center gap-2">
            <svg class="w-4 h-4 group-open:rotate-90 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            Upstream build reference
        </summary>
        <div class="px-4 pb-4 pt-1 space-y-3">
            <p class="text-xs text-text-secondary">The <code>cmake</code> commands the selected engine documents for the selected backend, pulled live from its repo. "Apply" fills the fields above — review before saving.</p>
            <button type="button" id="ref-load" class="text-xs px-3 py-1.5 rounded-md bg-neon-cyan/10 text-neon-cyan border border-neon-cyan/30 hover:bg-neon-cyan/20 transition-all font-medium">Load reference</button>
            <div id="ref-body" class="space-y-4"></div>
        </div>
    </details>

    <div data-cmake-only class="@(zig ? "hidden" : "") grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
            <label class="@label" asp-for="Input.CMakeGenerator">CMake generator (optional)</label>
            <input class="@input" asp-for="Input.CMakeGenerator" placeholder="Ninja" />
        </div>
        <div>
            <label class="@label" asp-for="Input.BuildConfig">Build config</label>
            <input class="@input" asp-for="Input.BuildConfig" />
        </div>
    </div>
    <div>
        <label class="@label" asp-for="Input.EnvironmentSetupCommand">Environment setup command (optional)</label>
        <input class="@input font-mono text-xs" asp-for="Input.EnvironmentSetupCommand" placeholder="&quot;C:\Program Files (x86)\Intel\oneAPI\setvars.bat&quot; intel64" />
        <p class="text-xs text-text-secondary mt-1">Sourced before git and the build so toolchain vars (e.g. Intel oneAPI, MSVC's vcvars64.bat) are in scope.</p>
    </div>
    <div data-cmake-only class="@(zig ? "hidden" : "")">
        <label class="@label" asp-for="Input.ExtraArtifactGlobsText">Extra artifact globs (one per line, relative to the build dir)</label>
        <textarea class="@input font-mono text-xs" rows="2" asp-for="Input.ExtraArtifactGlobsText"></textarea>
    </div>

    <div class="flex items-center gap-3 pt-2">
        <button type="submit" class="px-5 py-2 rounded-lg bg-neon-magenta/10 text-neon-magenta border border-neon-magenta/30 hover:bg-neon-magenta/20 transition-all text-sm font-medium">Save recipe</button>
        @if (Model.IsExisting && !Model.IsBuiltIn)
        {
            <button type="submit" asp-page-handler="Delete" formnovalidate onclick="return confirm('Delete this recipe?')" class="px-4 py-2 rounded-lg bg-red-500/10 text-neon-red border border-red-500/30 hover:bg-red-500/20 transition-all text-sm font-medium">Delete</button>
        }
    </div>
</form>

@if (!Model.IsExisting && Model.AllRecipes.Any())
{
    <div class="mt-6 max-w-3xl">
        <p class="text-sm text-text-secondary mb-2">…or start from an existing recipe:</p>
        <div class="flex flex-wrap gap-2">
            @foreach (var r in Model.AllRecipes)
            {
                <a href="/Features/Engines/Recipe?cloneFrom=@r.Id" class="text-xs px-3 py-1.5 rounded-md bg-gray-700/30 text-text-secondary border border-gray-600/20 hover:text-neon-magenta transition-all">@r.Name</a>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        (function () {
            const backendSelect = document.getElementById('Input_BackendType');
            const engineSelect = document.getElementById('Input_Engine');
            const repoField = document.getElementById('Input_GitRepoUrl');

            // Switching engine swaps the repo URL and ref too — unless they've been changed to a fork / own ref.
            if (engineSelect && repoField) {
                const refField = document.getElementById('Input_GitRef');
                const defaults = [...engineSelect.options].map(o => o.dataset.repo);
                const refDefaults = [...engineSelect.options].map(o => o.dataset.ref);
                const argsLabel = document.getElementById('args-label');
                engineSelect.addEventListener('change', () => {
                    const opt = engineSelect.selectedOptions[0];
                    if (!repoField.value.trim() || defaults.includes(repoField.value.trim()))
                        repoField.value = opt.dataset.repo;
                    if (refField && (!refField.value.trim() || refDefaults.includes(refField.value.trim())))
                        refField.value = opt.dataset.ref;
                    const isZig = opt.dataset.zig === 'true';
                    document.querySelectorAll('[data-cmake-only]').forEach(el => el.classList.toggle('hidden', isZig));
                    document.getElementById('zig-help')?.classList.toggle('hidden', !isZig);
                    if (argsLabel) argsLabel.textContent = isZig ? argsLabel.dataset.zig : argsLabel.dataset.cmake;
                });
            }
            const loadBtn = document.getElementById('ref-load');
            const body = document.getElementById('ref-body');
            if (!loadBtn || !body) return;

            const argsField = document.getElementById('Input_CMakeArgsText');
            const genField = document.getElementById('Input_CMakeGenerator');
            const cfgField = document.getElementById('Input_BuildConfig');

            const esc = (s) => (s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
            let loadedFor = null;

            function applyParsed(p) {
                if (Array.isArray(p.cmakeArgs) && p.cmakeArgs.length) argsField.value = p.cmakeArgs.join('\n');
                if (p.generator) genField.value = p.generator;
                if (p.buildConfig) cfgField.value = p.buildConfig;
                argsField.dispatchEvent(new Event('input'));
            }
            window.__applyParsed = applyParsed;

            async function load() {
                const backend = backendSelect ? backendSelect.value : 'Cpu';
                const engine = engineSelect ? engineSelect.value : 'LlamaCpp';
                loadedFor = engine + '/' + backend;
                body.innerHTML = '<p class="text-xs text-text-secondary">Loading…</p>';
                try {
                    const resp = await fetch(`/Features/Engines/Recipe?handler=Reference&engine=${encodeURIComponent(engine)}&backend=${encodeURIComponent(backend)}`);
                    const data = await resp.json();
                    body.innerHTML = data.docs.map(renderDoc).join('') || '<p class="text-xs text-text-secondary">Nothing found.</p>';
                } catch (e) {
                    body.innerHTML = `<p class="text-xs text-neon-red">Could not load reference: ${esc(String(e))}</p>`;
                }
            }

            function renderDoc(d) {
                const head = `<div class="text-xs"><a href="${esc(d.url)}" target="_blank" rel="noopener" class="text-neon-cyan hover:underline font-mono">${esc(d.path)}</a></div>`;
                if (d.error) return `${head}<p class="text-xs text-text-secondary mt-1">${esc(d.error)}</p>`;
                if (!d.commands.length) return `${head}<p class="text-xs text-text-secondary mt-1">No cmake configure commands found.</p>`;
                const cmds = d.commands.map((c, i) => {
                    const p = c.parsed;
                    const btn = p
                        ? `<button type="button" class="text-[11px] px-2 py-1 rounded bg-neon-magenta/10 text-neon-magenta border border-neon-magenta/30 hover:bg-neon-magenta/20 transition-all font-medium" onclick='window.__applyParsed(${JSON.stringify(p)})'>Apply</button>`
                        : '';
                    const ignored = (p && p.ignored && p.ignored.length)
                        ? `<p class="text-[11px] text-yellow-400/80 mt-1">not applied (put in the environment setup command if needed): <span class="font-mono">${esc(p.ignored.join(' '))}</span></p>`
                        : '';
                    return `<div class="mt-2">
                        <div class="flex items-start gap-2">
                            <pre class="flex-1 bg-black/50 border border-gray-700/30 rounded p-2 text-[11px] font-mono text-text-secondary overflow-x-auto whitespace-pre-wrap">${esc(c.command)}</pre>
                            ${btn}
                        </div>${ignored}
                    </div>`;
                }).join('');
                return `${head}${cmds}`;
            }

            loadBtn.addEventListener('click', load);
            const reloadIfStale = () => {
                if (loadedFor && loadedFor !== `${engineSelect ? engineSelect.value : 'LlamaCpp'}/${backendSelect ? backendSelect.value : 'Cpu'}`) load();
            };
            if (backendSelect) backendSelect.addEventListener('change', reloadIfStale);
            if (engineSelect) engineSelect.addEventListener('change', reloadIfStale);
        })();
    </script>
}
