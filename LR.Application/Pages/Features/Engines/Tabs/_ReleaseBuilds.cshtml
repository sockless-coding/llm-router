@using LR.Core.Models
@using LR.Application.Pages.Features.Engines
@model LR.Application.Pages.Features.Engines.EnginesIndexModel
@* The selected engine's downloaded/compiled builds — shared by the engine tabs that install prebuilt releases. *@

<h2 class="text-sm font-semibold uppercase tracking-wider text-text-secondary mb-3">Installed builds</h2>
@if (!Model.Builds.Any())
{
    <div class="text-center py-12 bg-cyber-card rounded-xl border border-neon-cyan/10 mb-8">
        <p class="text-text-secondary">No managed builds yet</p>
        <p class="text-text-secondary text-sm mt-1">@(Model.Recipes.Any() ? "Install an official release, or compile one from a recipe below." : "Install an official release to get started.")</p>
    </div>
}
else
{
    <div class="bg-cyber-card rounded-xl border border-gray-700/30 overflow-hidden overflow-x-auto mb-8">
        <table class="w-full text-sm">
            <thead>
                <tr class="border-b border-gray-700/50 bg-gray-800/30">
                    <th class="text-left px-4 py-3 text-text-secondary font-medium">Name</th>
                    <th class="text-left px-4 py-3 text-text-secondary font-medium">Backend</th>
                    <th class="text-left px-4 py-3 text-text-secondary font-medium">Version</th>
                    <th class="text-left px-4 py-3 text-text-secondary font-medium">Source</th>
                    <th class="text-right px-4 py-3 text-text-secondary font-medium">Size</th>
                    <th class="text-center px-4 py-3 text-text-secondary font-medium">Status</th>
                    <th class="text-center px-4 py-3 text-text-secondary font-medium">Used By</th>
                    <th class="text-right px-4 py-3 text-text-secondary font-medium"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model.Builds)
                {
                    var usage = Model.ServerUsageCounts.GetValueOrDefault(b.Id, 0);
                    var inFlight = b.Status is EngineBuildStatus.Downloading or EngineBuildStatus.Building;
                    <tr class="border-b border-gray-700/30 hover:bg-gray-800/20">
                        <td class="px-4 py-3">
                            <a href="/Features/Engines/Detail?id=@b.Id" class="text-text-primary font-medium hover:text-neon-cyan transition-colors">@b.Name</a>
                            <p class="text-xs text-text-secondary mt-0.5 font-mono">@b.InstallPath</p>
                        </td>
                        <td class="px-4 py-3"><span class="text-xs px-2 py-0.5 rounded border @EngineDisplay.BackendBadge(b.BackendType)">@EngineDisplay.BackendLabel(b.BackendType)</span></td>
                        <td class="px-4 py-3 text-text-primary font-mono">@(b.VersionTag ?? (b.CommitSha is { Length: >= 7 } sha ? sha[..7] : "—"))</td>
                        <td class="px-4 py-3 text-text-secondary">@(b.Source == EngineBuildSource.OfficialRelease ? "Release" : "Compiled")</td>
                        <td class="px-4 py-3 text-right text-text-primary">@EngineDisplay.FormatSize(b.SizeBytes)</td>
                        <td class="px-4 py-3 text-center"><partial name="~/Pages/Features/Engines/Tabs/_StatusBadge.cshtml" model="b" /></td>
                        <td class="px-4 py-3 text-center text-text-primary">@usage</td>
                        <td class="px-4 py-3 text-right whitespace-nowrap">
                            @if (b.Status == EngineBuildStatus.Ready)
                            {
                                <a href="/Features/Engines/Changelog?id=@b.Id" class="text-xs px-2 py-1 rounded-md bg-yellow-500/10 text-yellow-400 hover:bg-yellow-500/20 transition-all font-medium">Check updates</a>
                            }
                            @if (inFlight)
                            {
                                <button type="button" onclick="cancelBuild('@b.Id')" class="text-xs px-2 py-1 rounded-md bg-yellow-500/10 text-yellow-400 hover:bg-yellow-500/20 transition-all font-medium">Cancel</button>
                            }
                            else
                            {
                                <button type="button" onclick="deleteBuild('@b.Id', '@b.Name', @usage)" class="text-xs px-2 py-1 rounded-md bg-red-500/10 text-neon-red hover:bg-red-500/20 transition-all font-medium">Delete</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
