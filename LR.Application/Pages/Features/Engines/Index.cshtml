@page
@using LR.Core.Models
@using Microsoft.AspNetCore.Html
@model LR.Application.Pages.Features.Engines.EnginesIndexModel
@{
    ViewData["Title"] = "Engines";
    var selected = Model.SelectedEngine;
}

<form id="csrf-form" hidden>@Html.AntiForgeryToken()</form>

<p class="text-text-secondary mb-6">Install, track and update the inference engines your servers run. Servers bind to an install here so they always know which version they're on.</p>

<details class="bg-cyber-card rounded-xl border border-gray-600/20 group mb-6" @(string.IsNullOrEmpty(Model.InstallRootFolder) ? "open" : "")>
    <summary class="cursor-pointer px-6 py-4 text-base font-semibold text-text-primary hover:text-neon-cyan transition-colors [&::-webkit-details-marker]:hidden flex items-center gap-2">
        <svg class="w-5 h-5 group-open:rotate-90 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        Engine Build Settings
    </summary>
    <div class="px-6 pb-6 space-y-4">
        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="text-sm text-neon-green">@Model.StatusMessage</div>
        }
        <form method="post" asp-page-handler="SaveSettings" hx-boost="false" class="grid grid-cols-1 md:grid-cols-2 gap-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Engine" value="@selected.Engine" />
            <div>
                <label asp-for="InstallRootFolder" class="block text-sm font-medium text-text-secondary mb-1">Install Root Folder</label>
                <input asp-for="InstallRootFolder" placeholder="C:\llama-builds" class="w-full px-3 py-2 rounded-lg bg-cyber-bg-dark border border-gray-600/30 text-text-primary focus:border-neon-cyan focus:ring-1 focus:ring-neon-cyan/30 outline-none transition-all" />
                <p class="text-xs text-text-secondary mt-1">Where finished installs live — each downloaded or compiled build (and each Strata clone made here) gets its own subfolder, and servers bind to these paths.</p>
            </div>
            <div>
                <label asp-for="BuildWorkspaceFolder" class="block text-sm font-medium text-text-secondary mb-1">Build Workspace Folder (optional)</label>
                <input asp-for="BuildWorkspaceFolder" placeholder="D:\scratch\llama-build" class="w-full px-3 py-2 rounded-lg bg-cyber-bg-dark border border-gray-600/30 text-text-primary focus:border-neon-cyan focus:ring-1 focus:ring-neon-cyan/30 outline-none transition-all" />
                <p class="text-xs text-text-secondary mt-1">Shared scratch area for compiling — per-build staging, reused git clones, and build/update logs. Leave blank to use a <span class="font-mono">.build</span> folder under the install root.</p>
            </div>
            <div>
                <label asp-for="GitHubApiToken" class="block text-sm font-medium text-text-secondary mb-1">GitHub API Token (optional)</label>
                <input asp-for="GitHubApiToken" type="password" placeholder="ghp_..." class="w-full px-3 py-2 rounded-lg bg-cyber-bg-dark border border-gray-600/30 text-text-primary focus:border-neon-cyan focus:ring-1 focus:ring-neon-cyan/30 outline-none transition-all" />
                <p class="text-xs text-text-secondary mt-1">Raises the anonymous GitHub rate limit for release / changelog lookups.</p>
            </div>
            <div class="md:col-span-2">
                <button type="submit" class="px-5 py-2 rounded-lg bg-neon-cyan/10 text-neon-cyan border border-neon-cyan/30 hover:bg-neon-cyan/20 transition-all text-sm font-medium">Save Settings</button>
            </div>
        </form>
    </div>
</details>

<!-- One tab per registered engine -->
<nav class="flex items-center gap-1 border-b border-gray-700/50 mb-6" aria-label="Engines">
    @foreach (var engine in Model.Engines)
    {
        var active = engine.Engine == selected.Engine;
        <a href="/Features/Engines/Index?engine=@engine.Engine"
           aria-current="@(active ? "page" : null)"
           class="px-4 py-2 -mb-px text-sm font-medium border-b-2 transition-colors @(active ? "border-neon-cyan text-neon-cyan" : "border-transparent text-text-secondary hover:text-text-primary")">@engine.DisplayName</a>
    }
</nav>

@{
    IHtmlContent? tab = null;
    try
    {
        tab = await Html.PartialAsync($"~/Pages/Features/Engines/Tabs/_{selected.Engine}.cshtml", Model);
    }
    catch (InvalidOperationException)
    {
        // No tab partial for this engine (yet).
    }
}
@if (tab is not null)
{
    @tab
}
else
{
    <div class="text-center py-12 bg-cyber-card rounded-xl border border-gray-700/30">
        <p class="text-text-secondary">Version management isn't available for @selected.DisplayName yet.</p>
        <p class="text-text-secondary text-sm mt-1">Point its servers at an install folder from the server's settings.</p>
    </div>
}

@section Scripts {
    <script>
        (function () {
            const token = () => document.querySelector('#csrf-form input[name="__RequestVerificationToken"]')?.value || '';

            async function postAction(fields) {
                const formData = new FormData();
                for (const [k, v] of Object.entries(fields)) formData.append(k, v);
                formData.append('__RequestVerificationToken', token());
                const resp = await fetch('/Features/Engines/Actions', { method: 'POST', body: formData });
                return resp.json();
            }

            const toDetail = (id) => { location.href = '/Features/Engines/Detail?id=' + id; };

            // --- shared ---

            window.cancelBuild = async function (id) {
                if (!confirm('Cancel this job?')) return;
                const result = await postAction({ Command: 'cancel', BuildId: id });
                if (result.success) location.reload(); else alert(result.message || 'Cancel failed.');
            };

            // --- llama.cpp ---

            window.deleteBuild = async function (id, name, usage) {
                let msg = `Delete build "${name}"?`;
                if (usage > 0) msg += ` ${usage} server(s) are bound to it — they will lose the link.`;
                if (!confirm(msg)) return;
                const deleteFiles = confirm('Also delete the install folder from disk?');
                const result = await postAction({ Command: 'delete', BuildId: id, DeleteFiles: deleteFiles });
                if (result.success) location.reload(); else alert(result.message || 'Delete failed.');
            };

            window.startBuild = async function (recipeId, name) {
                if (!confirm(`Start a source build from recipe "${name}"? This can take a while.`)) return;
                const result = await postAction({ Command: 'startBuild', RecipeId: recipeId });
                if (result.success) toDetail(result.buildId);
                else alert(result.message || 'Could not start build.');
            };

            // --- Strata ---

            window.registerStrata = async function () {
                const folder = document.getElementById('strata-register-folder').value.trim();
                const name = document.getElementById('strata-register-name').value.trim();
                const result = await postAction({ Command: 'registerStrata', Folder: folder, Name: name });
                if (result.success) location.reload(); else alert(result.message || 'Could not add the checkout.');
            };

            window.cloneStrata = async function () {
                const folderName = document.getElementById('strata-clone-folder').value.trim();
                const name = document.getElementById('strata-clone-name').value.trim();
                if (!confirm('Clone Strata from GitHub into the install root?')) return;
                const result = await postAction({ Command: 'cloneStrata', FolderName: folderName, Name: name });
                if (result.success) toDetail(result.buildId); else alert(result.message || 'Could not start the clone.');
            };

            window.updateInstall = async function (id, name) {
                if (!confirm(`Update "${name}" to the newest version (the latest release for a release install, main otherwise) and run Strata's setup.py --update? Stop any server using it first.`)) return;
                const result = await postAction({ Command: 'update', BuildId: id });
                if (result.success) toDetail(result.buildId); else alert(result.message || 'Could not start the update.');
            };

            window.rollbackEngine = async function (id, name) {
                if (!confirm(`Put back the engine "${name}" had before its last update? Stop any server using it first.`)) return;
                const result = await postAction({ Command: 'rollbackEngine', BuildId: id });
                if (result.success) toDetail(result.buildId); else alert(result.message || 'Could not start the rollback.');
            };

            window.refreshInstall = async function (id) {
                const result = await postAction({ Command: 'refresh', BuildId: id });
                if (result.success) location.reload(); else alert(result.message || 'Refresh failed.');
            };

            window.unregisterInstall = async function (id, name, usage) {
                let msg = `Stop tracking "${name}"? Its folder, models and settings stay on disk.`;
                if (usage > 0) msg += ` ${usage} server(s) bound to it keep using the folder.`;
                if (!confirm(msg)) return;
                const result = await postAction({ Command: 'delete', BuildId: id, DeleteFiles: false });
                if (result.success) location.reload(); else alert(result.message || 'Remove failed.');
            };

            // Live status for in-flight jobs — reload the page when one finishes.
            const badges = document.querySelectorAll('.build-status');
            if (badges.length > 0) {
                let connection = window.__engineBuildHubConnection;
                const isLive = connection && connection.state !== signalR.HubConnectionState.Disconnected;
                if (!isLive) {
                    connection = new signalR.HubConnectionBuilder().withUrl('/engineBuildHub').build();
                    window.__engineBuildHubConnection = connection;
                }
                if (window.__engineBuildIndexHandler) connection.off('ReceiveBuildProgress', window.__engineBuildIndexHandler);
                const handler = (p) => {
                    const badge = document.querySelector(`.build-status[data-build-id="${p.buildId}"]`);
                    if (!badge) return;
                    if (p.status === 'completed' || p.status === 'error') location.reload();
                    else if (p.percent != null) badge.textContent = `Working… ${p.percent}%`;
                    else if (p.message) badge.textContent = p.message.length > 24 ? p.message.slice(0, 24) + '…' : p.message;
                };
                connection.on('ReceiveBuildProgress', handler);
                window.__engineBuildIndexHandler = handler;
                if (!isLive) connection.start().catch(() => {});
            }
        })();
    </script>
}
