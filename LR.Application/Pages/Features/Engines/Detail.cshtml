@page
@using LR.Core.Models
@model LR.Application.Pages.Features.Engines.EngineBuildDetailModel
@{
    ViewData["Title"] = Model.Build?.Name ?? "Build";
    var b = Model.Build!;
}

<form id="csrf-form" hidden>@Html.AntiForgeryToken()</form>

<!-- Full-height flex column so the build log can stretch to fill the viewport and scroll internally -->
<div class="flex flex-col h-full min-h-0">

<div class="flex items-center gap-3 mb-6 shrink-0">
    <a href="/Features/Engines/Index" class="text-text-secondary hover:text-neon-cyan transition-colors text-sm">← Engines</a>
    <span class="text-text-secondary">/</span>
    <p class="text-text-primary text-sm font-medium">@b.Name</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6 shrink-0">
    <div class="bg-cyber-card rounded-xl border border-gray-700/30 p-4 space-y-2 text-sm">
        <div class="flex justify-between"><span class="text-text-secondary">Backend</span><span class="text-text-primary">@b.BackendType</span></div>
        <div class="flex justify-between"><span class="text-text-secondary">Source</span><span class="text-text-primary">@(b.Source == EngineBuildSource.OfficialRelease ? "Official release" : "Compiled from source")</span></div>
        <div class="flex justify-between"><span class="text-text-secondary">Version tag</span><span class="text-text-primary font-mono">@(b.VersionTag ?? "—")</span></div>
        <div class="flex justify-between"><span class="text-text-secondary">Commit</span><span class="text-text-primary font-mono">@(b.CommitSha ?? "—")</span></div>
        <div class="flex justify-between"><span class="text-text-secondary">Target</span><span class="text-text-primary font-mono">@(b.TargetOs)-@(b.TargetArch)</span></div>
        <div class="flex justify-between"><span class="text-text-secondary">Status</span><span class="text-text-primary" id="build-status">@b.Status</span></div>
        <div class="flex justify-between"><span class="text-text-secondary">Bound servers</span><span class="text-text-primary">@Model.ServerUsage</span></div>
    </div>
    <div class="bg-cyber-card rounded-xl border border-gray-700/30 p-4 space-y-2 text-sm">
        <div><span class="text-text-secondary block mb-1">Install path</span><span class="text-text-primary font-mono break-all">@b.InstallPath</span></div>
        @if (!string.IsNullOrEmpty(b.StatusMessage))
        {
            <div><span class="text-text-secondary block mb-1">Message</span><span class="text-neon-red break-words">@b.StatusMessage</span></div>
        }
        <div class="pt-2">
            @if (Model.InFlight)
            {
                <button type="button" onclick="cancelBuild('@b.Id')" class="text-xs px-3 py-1.5 rounded-md bg-yellow-500/10 text-yellow-400 border border-yellow-500/30 hover:bg-yellow-500/20 transition-all font-medium">Cancel build</button>
            }
        </div>
    </div>
</div>

<h2 class="text-sm font-semibold uppercase tracking-wider text-text-secondary mb-2 shrink-0">Build log</h2>
<pre id="build-log" class="flex-1 min-h-[12rem] bg-black/60 border border-gray-700/30 rounded-xl p-4 text-xs font-mono text-text-secondary overflow-auto whitespace-pre-wrap">@(Model.BuildLog ?? "(no log)")</pre>

</div>

@section Scripts {
    <script>
        (function () {
            const token = () => document.querySelector('#csrf-form input[name="__RequestVerificationToken"]')?.value || '';
            const buildId = '@b.Id';
            let inFlight = @(Model.InFlight ? "true" : "false");

            window.cancelBuild = async function (id) {
                if (!confirm('Cancel this build?')) return;
                const formData = new FormData();
                formData.append('Command', 'cancel');
                formData.append('BuildId', id);
                formData.append('__RequestVerificationToken', token());
                const resp = await fetch('/Features/Engines/Actions', { method: 'POST', body: formData });
                const result = await resp.json();
                if (!result.success) alert(result.message || 'Cancel failed.');
            };

            const logEl = document.getElementById('build-log');
            const statusEl = document.getElementById('build-status');

            // Stick to the bottom as new output streams in, but stop fighting the user
            // the moment they scroll up to read something further back.
            const stuckToBottom = () => logEl.scrollHeight - logEl.scrollTop - logEl.clientHeight < 40;
            const scrollToBottom = () => { logEl.scrollTop = logEl.scrollHeight; };

            // Server-rendered log starts scrolled to the bottom too.
            scrollToBottom();

            async function poll() {
                if (!inFlight) return;
                try {
                    const resp = await fetch(`/Features/Engines/Detail?handler=Log&id=${buildId}`);
                    const data = await resp.json();
                    if (data.log) {
                        const wasStuck = stuckToBottom();
                        logEl.textContent = data.log;
                        if (wasStuck) scrollToBottom();
                    }
                    if (statusEl && data.status) statusEl.textContent = data.status;
                    if (!data.inFlight) { inFlight = false; setTimeout(() => location.reload(), 800); return; }
                } catch { /* transient */ }
                setTimeout(poll, 2000);
            }
            poll();
        })();
    </script>
}
