@page
@using LR.Core.Models
@model LR.Application.Pages.Features.Models.Vllm.VllmModelsIndexModel
@{
    ViewData["Title"] = "vLLM Models";
    var selCls = "px-3 py-2 rounded-lg bg-cyber-bg-dark border border-gray-600/30 text-text-primary focus:border-neon-magenta focus:ring-1 focus:ring-neon-magenta/30 outline-none transition-all text-sm";
    var inpCls = "w-full px-3 py-2 rounded-lg bg-cyber-bg-dark border border-gray-600/30 text-text-primary focus:border-neon-magenta focus:ring-1 focus:ring-neon-magenta/30 outline-none transition-all placeholder-gray-500 text-sm";
    var btnCyan = "inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-neon-cyan/10 text-neon-cyan border border-neon-cyan/30 hover:bg-neon-cyan/20 transition-all text-sm font-medium";
    var chip = "inline-flex items-center px-2 py-0.5 rounded text-xs font-medium border";
    var hardwareNames = Model.HardwareProfiles.ToDictionary(h => h.Id, h => h.DisplayName);
}

<form id="csrf-form" hidden>@Html.AntiForgeryToken()</form>

<div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <p class="text-text-secondary max-w-3xl">
        Models vLLM serves straight from Hugging Face, each with the recipes saved for it: recipes.vllm.ai's tested commands for a GPU, or your own.
        A preset made from a recipe copies its settings, so changing a recipe later leaves existing presets as they are.
    </p>
    <a href="/Features/Models/Index" class="px-4 py-2 rounded-lg bg-gray-700/30 text-text-secondary border border-gray-600/20 hover:bg-gray-700/50 transition-all text-sm font-medium">Model files</a>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="mb-4 rounded-lg border border-neon-green/30 bg-neon-green/5 px-4 py-3 text-sm text-neon-green" role="status">@Model.Message</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="mb-4 rounded-lg border border-red-500/30 bg-red-500/5 px-4 py-3 text-sm text-red-400" role="alert">@Model.ErrorMessage</div>
}

<!-- Hardware filter: applies to the saved recipes below and to the recipe search. -->
<div class="bg-cyber-card rounded-xl p-4 border border-gray-600/20 mb-6 flex flex-wrap items-center gap-3">
    <form method="get" class="flex items-center gap-2" hx-boost="false">
        <label for="hardware-filter" class="text-sm font-medium text-text-secondary">Hardware</label>
        <select id="hardware-filter" name="hardware" class="@selCls" onchange="this.form.submit()">
            <option value="">All hardware</option>
            @foreach (var brand in Model.HardwareProfiles.GroupBy(h => h.Brand))
            {
                <optgroup label="@(brand.Key.Length > 0 ? brand.Key : "Saved recipes")">
                    @foreach (var h in brand)
                    {
                        <option value="@h.Id" selected="@(string.Equals(Model.Hardware, h.Id, StringComparison.OrdinalIgnoreCase))">
                            @h.DisplayName@(h.GpuCount > 0 ? $" ({h.GpuCount} × GPU, {h.VramGb} GB)" : "")
                        </option>
                    }
                </optgroup>
            }
        </select>
        <noscript><button type="submit" class="@btnCyan">Filter</button></noscript>
    </form>
    @if (Model.DetectedHardware.Count > 0)
    {
        <span class="text-xs text-text-secondary">Looks like this machine:</span>
        @foreach (var h in Model.DetectedHardware.Take(3))
        {
            var on = string.Equals(Model.Hardware, h.Id, StringComparison.OrdinalIgnoreCase);
            <a href="?hardware=@h.Id" class="@chip @(on ? "bg-neon-magenta/10 text-neon-magenta border-neon-magenta/30" : "text-neon-cyan border-neon-cyan/30 hover:bg-neon-cyan/10")">@h.DisplayName</a>
        }
    }
    @if (Model.CatalogError is not null)
    {
        <span class="text-xs text-amber-400">recipes.vllm.ai didn't answer (@Model.CatalogError); only saved recipes' hardware is listed.</span>
    }
</div>

<!-- Add a model -->
<details id="add-model" class="bg-cyber-card rounded-xl border border-neon-cyan/10 mb-6 group" @(Model.Models.Count == 0 ? "open" : "")>
    <summary class="cursor-pointer px-6 py-4 text-base font-semibold text-text-primary hover:text-neon-cyan transition-colors [&::-webkit-details-marker]:hidden flex items-center gap-2">
        <svg class="w-5 h-5 group-open:rotate-90 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        Add a model
    </summary>
    <div class="px-6 pb-6 space-y-4">
        <p class="text-xs text-text-secondary">
            Search recipes.vllm.ai and Hugging Face. Models with a recipe come first@(Model.Hardware is not null ? $", limited to recipes for {Model.HardwareLabel(Model.Hardware)}" : "").
            A Hugging Face model without one can still be added, and given recipes of your own. Leave the search empty to list every recipe for the selected hardware.
        </p>
        <form id="vllm-search-form" class="flex gap-2" hx-boost="false">
            <input id="vllm-search" type="search" autocomplete="off" placeholder="Qwen3, gemma-4, org/name…" class="@inpCls font-mono" />
            <button type="submit" class="@btnCyan shrink-0">Search</button>
        </form>
        <p id="vllm-search-status" class="text-xs text-text-secondary" role="status"></p>
        <div id="vllm-search-results" class="space-y-4"></div>

        <form method="post" asp-page-handler="Add" class="flex gap-2 pt-3 border-t border-gray-700/30">
            <input type="hidden" name="hardware" value="@Model.Hardware" />
            <input name="hfId" required autocomplete="off" placeholder="Or add by id: org/name" class="@inpCls font-mono" />
            <button type="submit" class="@btnCyan shrink-0">Add</button>
        </form>
    </div>
</details>

@if (Model.Models.Count == 0)
{
    <div class="text-center py-16 bg-cyber-card rounded-xl border border-neon-cyan/10">
        <p class="text-text-secondary">No vLLM models yet</p>
        <p class="text-text-secondary text-sm mt-1">Search above to add one, then save the recipes you want to run it with.</p>
    </div>
}
else if (!Model.VisibleModels.Any())
{
    <div class="text-center py-12 bg-cyber-card rounded-xl border border-neon-cyan/10">
        <p class="text-text-secondary">No saved recipe runs on @Model.HardwareLabel(Model.Hardware).</p>
        <p class="text-text-secondary text-sm mt-1"><a href="?" class="text-neon-cyan hover:underline">Show all hardware</a>, or add a recipe for it from a model's page.</p>
    </div>
}
else
{
    <div class="space-y-4">
        @foreach (var m in Model.VisibleModels)
        {
            var recipes = m.Recipes.Where(Model.Matches).ToList();
            var hidden = m.Recipes.Count - recipes.Count;
            <div class="bg-cyber-card rounded-xl border border-gray-600/20 p-5">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div class="min-w-0">
                        <div class="flex flex-wrap items-center gap-2">
                            <a href="/Features/Models/Vllm/Model?id=@m.Id@(Model.Hardware is not null ? $"&hardware={Model.Hardware}" : "")" class="text-lg font-semibold text-text-primary hover:text-neon-cyan">@m.Name</a>
                            @if (m.HasSiteRecipe)
                            {
                                <span class="@chip text-neon-cyan border-neon-cyan/30">recipes.vllm.ai</span>
                            }
                            @if (m.PipelineTag is not null)
                            {
                                <span class="@chip text-text-secondary border-gray-600/30">@m.PipelineTag</span>
                            }
                        </div>
                        <p class="text-xs text-text-secondary font-mono mt-0.5">@m.HfId@(m.Provider is not null ? $" · {m.Provider}" : "")</p>
                    </div>
                    <a href="/Features/Models/Vllm/Model?id=@m.Id@(Model.Hardware is not null ? $"&hardware={Model.Hardware}" : "")" class="@btnCyan">Recipes</a>
                </div>

                @if (recipes.Count == 0)
                {
                    <p class="text-sm text-text-secondary mt-3">No recipes yet. <a href="/Features/Models/Vllm/Model?id=@m.Id" class="text-neon-cyan hover:underline">Add one</a>.</p>
                }
                else
                {
                    <div class="mt-3 overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead>
                                <tr class="text-left text-xs text-text-secondary">
                                    <th class="py-1 pr-4 font-medium">Recipe</th>
                                    <th class="py-1 pr-4 font-medium">Hardware</th>
                                    <th class="py-1 pr-4 font-medium">Variant</th>
                                    <th class="py-1 pr-4 font-medium">VRAM</th>
                                    <th class="py-1 pr-4 font-medium">Presets</th>
                                    <th class="py-1"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in recipes)
                                {
                                    <tr class="border-t border-gray-700/30">
                                        <td class="py-2 pr-4">
                                            <a href="/Features/Models/Vllm/Model?id=@m.Id#recipe-@r.Id" class="text-text-primary hover:text-neon-cyan">@r.Name</a>
                                            <span class="@chip ml-1 @(r.Origin == VllmRecipeOrigin.Site ? "text-neon-cyan border-neon-cyan/30" : "text-neon-magenta border-neon-magenta/30")">@(r.Origin == VllmRecipeOrigin.Site ? "site" : "custom")</span>
                                        </td>
                                        <td class="py-2 pr-4 text-text-secondary">@(r.Hardware is null ? "Any" : hardwareNames.GetValueOrDefault(r.Hardware, r.Hardware))</td>
                                        <td class="py-2 pr-4 text-text-secondary font-mono text-xs">@(r.Variant ?? "—")</td>
                                        <td class="py-2 pr-4 text-text-secondary">@(r.VramGb is { } v ? $"≥ {v:0.#} GB" : "—")</td>
                                        <td class="py-2 pr-4 text-text-secondary">@Model.PresetCounts.GetValueOrDefault(r.Id)</td>
                                        <td class="py-2 text-right whitespace-nowrap">
                                            <a href="/Features/Presets/Create?vllmRecipe=@r.Id" class="text-xs text-neon-magenta hover:underline">Create preset</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (hidden > 0)
                        {
                            <p class="text-xs text-text-secondary mt-2">@hidden more for other hardware.</p>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

<script>
    (() => {
        const el = id => document.getElementById(id);
        const hardware = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Hardware));
        const hardwareNames = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(hardwareNames).Replace("</", "<\\/"));
        const token = document.querySelector('#csrf-form input[name="__RequestVerificationToken"]').value;
        const status = el('vllm-search-status');
        const results = el('vllm-search-results');
        let request = 0;

        const setStatus = (text, isError) => {
            status.textContent = text;
            status.classList.toggle('text-red-400', !!isError);
            status.classList.toggle('text-text-secondary', !isError);
        };

        function addButton(hfId, added) {
            if (added) {
                const span = document.createElement('span');
                span.className = 'text-xs text-text-secondary';
                span.textContent = 'Added';
                return span;
            }
            const form = document.createElement('form');
            form.method = 'post';
            form.action = '/Features/Models/Vllm?handler=Add';
            for (const [name, value] of [['__RequestVerificationToken', token], ['hfId', hfId], ['hardware', hardware ?? '']]) {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = name;
                input.value = value;
                form.appendChild(input);
            }
            const button = document.createElement('button');
            button.type = 'submit';
            button.className = 'px-2.5 py-1 rounded-lg bg-neon-cyan/10 text-neon-cyan border border-neon-cyan/30 hover:bg-neon-cyan/20 transition-all text-xs font-medium';
            button.textContent = 'Add';
            form.appendChild(button);
            return form;
        }

        function row(title, subtitle, detail, hfId, added) {
            const item = document.createElement('li');
            item.className = 'flex items-center justify-between gap-3 py-2 border-t border-gray-700/30';
            const text = document.createElement('div');
            text.className = 'min-w-0';
            const name = document.createElement('a');
            name.href = `https://huggingface.co/${hfId}`;
            name.target = '_blank';
            name.rel = 'noopener noreferrer';
            name.className = 'text-sm text-text-primary hover:text-neon-cyan';
            name.textContent = title;
            const sub = document.createElement('p');
            sub.className = 'text-xs text-text-secondary font-mono truncate';
            sub.textContent = subtitle;
            text.append(name, sub);
            if (detail) {
                const d = document.createElement('p');
                d.className = 'text-xs text-text-secondary';
                d.textContent = detail;
                text.appendChild(d);
            }
            item.append(text, addButton(hfId, added));
            return item;
        }

        function group(heading, items) {
            const wrap = document.createElement('div');
            const h = document.createElement('h3');
            h.className = 'text-sm font-medium text-text-secondary mb-1';
            h.textContent = heading;
            const list = document.createElement('ul');
            list.append(...items);
            wrap.append(h, list);
            return wrap;
        }

        async function search() {
            const q = el('vllm-search').value.trim();
            if (!q && !hardware) { setStatus('Enter a search, or pick a hardware to list its recipes.', true); return; }
            const mine = ++request;
            results.replaceChildren();
            setStatus(hardware
                ? 'Searching… The first search for a hardware reads every recipe on recipes.vllm.ai to see what it runs on, which can take a minute.'
                : 'Searching…');
            let body;
            try {
                const response = await fetch(`/Features/Models/Vllm?${new URLSearchParams({ handler: 'Search', q, hardware: hardware ?? '' })}`);
                body = await response.json();
                if (!response.ok) throw new Error(body.error || `The router answered ${response.status}.`);
            } catch (error) {
                if (mine === request) setStatus(error.message, true);
                return;
            }
            if (mine !== request) return;

            const groups = [];
            if (body.recipes.length) {
                groups.push(group(hardware ? `With a recipe for ${hardwareNames[hardware] ?? hardware}` : 'With a vLLM recipe',
                    body.recipes.map(r => row(r.title, `${r.hfId}${r.provider ? ` · ${r.provider}` : ''}`,
                        r.hardware && r.hardware.length ? `Runs on: ${r.hardware.map(h => hardwareNames[h] ?? h).join(', ')}` : null, r.hfId, r.added))));
            }
            if (body.hub.length) {
                groups.push(group('On Hugging Face, no vLLM recipe',
                    body.hub.map(r => row(r.hfId, `${r.author ?? ''} · ${r.downloads.toLocaleString()} downloads`, null, r.hfId, r.added))));
            }
            results.replaceChildren(...groups);
            const notes = [body.recipeError, body.hubError].filter(Boolean);
            setStatus(notes.length ? notes.join(' ') : (groups.length ? '' : 'Nothing found.'), notes.length > 0);
        }

        el('vllm-search-form').addEventListener('submit', event => { event.preventDefault(); search(); });
    })();
</script>
