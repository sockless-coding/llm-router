@using LR.Core.Services
@model LR.Application.Pages.Features.Models.ModelTypeBadgeViewModel
@{
    // Class strings stay in this .cshtml so Tailwind's content scan (Pages/**/*.cshtml) keeps them.
    var (cls, title) = Model.Type switch
    {
        ModelType.Chat => ("bg-neon-cyan/10 text-neon-cyan border-neon-cyan/20", "Text generation: /v1/chat/completions, /v1/messages, /api/chat"),
        ModelType.Embedding => ("bg-neon-green/10 text-neon-green border-neon-green/20", "Embeddings: /v1/embeddings, /api/embed"),
        ModelType.Reranker => ("bg-neon-green/10 text-neon-green border-neon-green/20", "Reranking (rank pooling)"),
        ModelType.Decision => ("bg-amber-500/10 text-amber-700 dark:text-amber-300 border-amber-500/30", "Native decision model: POST /v1/systemone"),
        ModelType.Image => ("bg-neon-magenta/10 text-neon-magenta border-neon-magenta/20", "Diffusion model: /v1/images/generations"),
        ModelType.Projector => ("bg-purple-500/10 text-purple-700 dark:text-purple-300 border-purple-500/20", "Multimodal projector (mmproj), paired with a model for image/audio input"),
        _ => ("bg-purple-500/10 text-purple-700 dark:text-purple-300 border-purple-500/20", "Diffusion companion file, set in a preset's Diffusion section"),
    };
}
<span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded border whitespace-nowrap @cls" title="@title">
    <span>@Model.Label</span>
    @if (!string.IsNullOrEmpty(Model.Detail))
    {
        <span class="opacity-70 font-mono">· @Model.Detail</span>
    }
</span>
