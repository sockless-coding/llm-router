@page
@model LR.Application.Pages.Features.Models.ModelsHuggingFaceModel
@using LR.Core.Models
@{
    ViewData["Title"] = "Browse Hugging Face";
    var safetensors = Model.Format == HfModelFormat.Safetensors;
}

<form id="csrf-form" hidden>@Html.AntiForgeryToken()</form>
<div id="page-data" hidden data-prefill-repo-id="@Model.PrefillRepoId" data-format="@Model.Format"></div>

<div class="flex items-center justify-between mb-6">
    <p class="text-text-secondary">
        @if (safetensors)
        {
            @:Search the Hugging Face hub for safetensors diffusion checkpoints, VAEs and text encoders for stable-diffusion.cpp.
        }
        else
        {
            @:Search the Hugging Face hub for GGUF models and download them into your library.
        }
    </p>
    <a href="/Features/Models/Index" class="px-4 py-2 rounded-lg bg-gray-700/30 text-text-secondary border border-gray-600/20 hover:bg-gray-700/50 transition-all text-sm font-medium">
        Back to Models
    </a>
</div>

<!-- One tab per file format; GGUF also covers quantized diffusion models (e.g. FLUX GGUFs) -->
<nav class="flex items-center gap-1 border-b border-gray-700/50 mb-6" aria-label="File format">
    @foreach (var format in Enum.GetValues<HfModelFormat>())
    {
        var active = format == Model.Format;
        <a href="/Features/Models/HuggingFace?format=@format"
           aria-current="@(active ? "page" : null)"
           class="px-4 py-2 -mb-px text-sm font-medium border-b-2 transition-colors @(active ? "border-neon-cyan text-neon-cyan" : "border-transparent text-text-secondary hover:text-text-primary")">@format.DisplayName()</a>
    }
</nav>

<div class="bg-cyber-card rounded-xl p-6 border border-neon-cyan/10 mb-6">
    <div class="flex gap-3">
        <input id="searchQuery" type="text" placeholder="@(safetensors ? "e.g. sdxl, flux, stable-diffusion-v1-5..." : "e.g. llama-3, qwen2.5, mistral...")" value="@Model.PrefillRepoId"
               class="flex-1 px-3 py-2 rounded-lg bg-cyber-bg-dark border border-gray-600/30 text-text-primary focus:border-neon-cyan focus:ring-1 focus:ring-neon-cyan/30 outline-none transition-all" />
        <button id="searchBtn" type="button" class="px-6 py-2 rounded-lg bg-neon-cyan/10 text-neon-cyan border border-neon-cyan/30 hover:bg-neon-cyan/20 transition-all font-medium text-sm">
            Search
        </button>
    </div>
    @if (safetensors)
    {
        <label class="flex items-center gap-2 mt-3 text-sm text-text-secondary">
            <input id="textToImageOnly" type="checkbox" checked class="rounded border-gray-600/30 bg-cyber-bg-dark text-neon-cyan focus:ring-neon-cyan/30" />
            Text-to-image models only
        </label>
        <p class="text-xs text-text-secondary mt-1">Most models beyond SD 1.x/SDXL come as separate parts — a diffusion model, a VAE and text encoders, often from different repos. Show Files on a repo of a known model family lists what it needs, what you already have, and where to get the rest.</p>
        <p class="text-xs text-text-secondary mt-1">Untick to find standalone VAEs and text encoders, which are often untagged. Diffusers-layout repos list each component's files under their subfolders (<span class="font-mono">vae/</span>, <span class="font-mono">text_encoder/</span>, …); stable-diffusion.cpp needs single-file checkpoints or components, not sharded <span class="font-mono">-0000N-of-0000N</span> files.</p>
    }
</div>

<div id="results" class="space-y-3"></div>

@section Scripts {
    <script>
        // Wrapped in an IIFE: this script re-runs on every htmx-boosted navigation to this
        // page, and the top-level const below would throw "already declared" the second time.
        (function () {
        const format = document.getElementById('page-data')?.dataset.format || 'Gguf';
        const extension = format === 'Safetensors' ? '.safetensors' : '.gguf';
        const token = () => document.querySelector('#csrf-form input[name="__RequestVerificationToken"]')?.value || '';

        async function postAction(fields) {
            const formData = new FormData();
            for (const [k, v] of Object.entries(fields)) formData.append(k, v);
            formData.append('__RequestVerificationToken', token());
            const resp = await fetch('/Features/Models/Actions', { method: 'POST', body: formData });
            return resp.json();
        }

        function formatBytes(bytes) {
            if (bytes == null) return '—';
            const gb = bytes / 1024 / 1024 / 1024;
            return gb >= 1 ? gb.toFixed(2) + ' GB' : (bytes / 1024 / 1024).toFixed(0) + ' MB';
        }

        function buildRepoCard(repoId, statsText) {
            const card = document.createElement('div');
            card.className = 'bg-cyber-card rounded-xl p-4 border border-gray-700/30';
            card.innerHTML = `
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-text-primary font-medium repo-name"></p>
                        <p class="text-xs text-text-secondary mt-0.5 repo-stats"></p>
                    </div>
                    <div class="flex items-center gap-2">
                        <button type="button" class="details-btn text-xs px-3 py-1.5 rounded-md bg-gray-700/30 text-text-secondary border border-gray-600/20 hover:bg-gray-700/50 transition-all font-medium">
                            Details
                        </button>
                        <button type="button" class="load-files-btn text-xs px-3 py-1.5 rounded-md bg-neon-magenta/10 text-neon-magenta hover:bg-neon-magenta/20 transition-all font-medium">
                            Show Files
                        </button>
                    </div>
                </div>
                <div class="details-container mt-3 space-y-1 hidden text-sm"></div>
                <div class="files-container mt-3 space-y-1 hidden"></div>
            `;
            // Set untrusted values via text/dataset properties (not string-interpolated HTML/attributes)
            // to avoid a markup/attribute-breakout injection from a malicious repo id.
            card.querySelector('.repo-name').textContent = repoId;
            card.querySelector('.repo-stats').textContent = statsText ?? '';
            card.querySelector('.load-files-btn').dataset.repoId = repoId;
            card.querySelector('.details-btn').dataset.repoId = repoId;
            card.querySelector('.load-files-btn').addEventListener('click', function () { loadFiles(this); });
            card.querySelector('.details-btn').addEventListener('click', function () { loadDetails(this); });
            return card;
        }

        async function runSearch() {
            const q = document.getElementById('searchQuery').value.trim();
            const resultsEl = document.getElementById('results');
            if (!q) { resultsEl.innerHTML = ''; return; }

            resultsEl.innerHTML = '<p class="text-text-secondary text-sm">Searching…</p>';
            const textToImage = document.getElementById('textToImageOnly')?.checked ?? false;
            const resp = await fetch('?handler=Search&format=' + format + '&textToImage=' + textToImage + '&q=' + encodeURIComponent(q));
            const repos = await resp.json();

            if (!Array.isArray(repos) || repos.length === 0) {
                resultsEl.innerHTML = '<p class="text-text-secondary text-sm">No results.</p>';
                return;
            }

            resultsEl.innerHTML = '';
            for (const repo of repos) {
                resultsEl.appendChild(buildRepoCard(repo.id, `${repo.downloads ?? 0} downloads · ${repo.likes ?? 0} likes`));
            }
        }

        async function loadFiles(btn) {
            const repoId = btn.dataset.repoId;
            const container = btn.closest('div.bg-cyber-card').querySelector('.files-container');

            if (!container.classList.contains('hidden')) {
                container.classList.add('hidden');
                return;
            }

            container.classList.remove('hidden');
            container.innerHTML = '<p class="text-xs text-text-secondary">Loading files…</p>';

            const resp = await fetch('?handler=Files&format=' + format + '&repoId=' + encodeURIComponent(repoId));
            const data = await resp.json();

            container.innerHTML = '';
            if (!resp.ok || data.error) {
                const p = document.createElement('p');
                p.className = 'text-xs text-text-secondary';
                p.textContent = data.error || 'Failed to load files.';
                container.appendChild(p);
                return;
            }
            if (data.guide) container.appendChild(buildGuide(data.guide));

            const files = data.files || [];
            if (files.length === 0) {
                const p = document.createElement('p');
                p.className = 'text-xs text-text-secondary';
                p.textContent = `No ${extension} files found in this repo.`;
                container.appendChild(p);
                return;
            }

            // Diffusion repos mix the model with its VAE/encoders: group the files by what they are.
            const roles = [...new Set(files.map(f => f.role).filter(Boolean))];
            const grouped = roles.length > 1;
            const sorted = grouped
                ? [...files].sort((a, b) => ROLE_ORDER.indexOf(a.role) - ROLE_ORDER.indexOf(b.role))
                : files;
            let lastRole;
            for (const file of sorted) {
                if (grouped && file.role !== lastRole) {
                    lastRole = file.role;
                    const heading = document.createElement('p');
                    heading.className = 'text-xs font-semibold text-text-secondary uppercase tracking-wide pt-3';
                    heading.textContent = file.role;
                    container.appendChild(heading);
                }
                const row = document.createElement('div');
                row.className = 'flex items-center justify-between gap-3 text-sm border-t border-gray-700/30 pt-2';
                row.innerHTML = `
                    <span class="flex items-center gap-2 min-w-0">
                        <span class="role-badge hidden shrink-0 text-[10px] px-1.5 py-0.5 rounded border bg-purple-500/10 text-purple-300 border-purple-500/20"></span>
                        <span class="text-text-primary filename-label break-all"></span>
                    </span>
                    <span class="in-library hidden shrink-0 text-xs px-3 py-1 rounded-md bg-gray-700/30 text-text-secondary">In library</span>
                    <button type="button" class="download-btn shrink-0 text-xs px-3 py-1 rounded-md bg-neon-green/10 text-neon-green hover:bg-neon-green/20 transition-all font-medium">Download</button>
                `;
                row.querySelector('.filename-label').textContent = file.parts > 1
                    ? `${file.filename} (${file.parts} parts, ${formatBytes(file.sizeBytes)} — all downloaded together)`
                    : `${file.filename} (${formatBytes(file.sizeBytes)})`;
                if (file.role && !grouped) {
                    const badge = row.querySelector('.role-badge');
                    badge.textContent = file.role;
                    badge.classList.remove('hidden');
                }
                if (file.inLibrary) {
                    row.querySelector('.in-library').classList.remove('hidden');
                    row.querySelector('.download-btn').remove();
                } else {
                    row.querySelector('.download-btn').addEventListener('click', () => downloadFile(repoId, file.filename));
                }
                container.appendChild(row);
            }
        }

        const ROLE_ORDER = ['Model', 'VAE', 'CLIP-L', 'CLIP-G', 'T5-XXL', 'LLM text encoder', 'Text encoder', 'TAESD', 'LoRA', 'Not loadable on its own'];

        // The checklist of parts this repo's model family needs: each one already in the library,
        // in this repo (listed below, or on the other format's tab), or to get from another repo.
        function buildGuide(guide) {
            const box = document.createElement('div');
            box.className = 'rounded-lg border border-neon-cyan/20 bg-neon-cyan/5 p-3 mb-2 space-y-2';
            box.innerHTML = `
                <p class="text-sm text-text-primary"><span class="font-medium family-name"></span> <span class="text-text-secondary">— the files a stable-diffusion.cpp preset needs</span></p>
                <ul class="space-y-2 parts"></ul>
            `;
            box.querySelector('.family-name').textContent = guide.family;
            const list = box.querySelector('.parts');
            for (const part of guide.parts) {
                const li = document.createElement('li');
                li.className = 'flex gap-2 text-sm';
                li.innerHTML = `
                    <span class="status shrink-0 w-4 text-center font-bold"></span>
                    <div class="min-w-0">
                        <span class="text-text-primary part-label"></span>
                        <span class="optional hidden text-xs text-text-secondary">(optional)</span>
                        <p class="detail text-xs text-text-secondary break-words"></p>
                    </div>
                `;
                li.querySelector('.part-label').textContent = part.label;
                if (!part.required) li.querySelector('.optional').classList.remove('hidden');
                const status = li.querySelector('.status');
                const detail = li.querySelector('.detail');

                if (part.inLibrary) {
                    status.textContent = '✓';
                    status.classList.add('text-neon-green');
                    detail.textContent = `In your library: ${part.inLibrary}`;
                } else if (part.repoFiles.length) {
                    status.textContent = '↓';
                    status.classList.add('text-neon-cyan');
                    const otherTab = part.repoFiles.every(f => !f.toLowerCase().endsWith(extension));
                    const files = part.repoFiles.length === 1 ? part.repoFiles[0] : `${part.repoFiles.length} files, pick one`;
                    detail.textContent = `In this repo${otherTab ? ' (on the other format tab)' : ''}: ${files}. ${part.hint}`;
                } else {
                    status.textContent = '○';
                    status.classList.add(part.required ? 'text-amber-400' : 'text-text-secondary');
                    detail.append('Get it from ');
                    const link = document.createElement('a');
                    link.className = 'text-neon-cyan hover:underline font-mono';
                    link.href = part.sourceUrl;
                    link.textContent = part.sourceRepo;
                    detail.append(link, `: ${part.hint}`);
                }
                list.appendChild(li);
            }
            if (guide.note) {
                const note = document.createElement('p');
                note.className = 'text-xs text-text-secondary';
                note.textContent = guide.note;
                box.appendChild(note);
            }
            return box;
        }

        function formatDate(iso) {
            if (!iso) return 'unknown';
            const d = new Date(iso);
            return isNaN(d.getTime()) ? 'unknown' : d.toLocaleDateString();
        }

        async function loadDetails(btn) {
            const repoId = btn.dataset.repoId;
            const container = btn.closest('div.bg-cyber-card').querySelector('.details-container');

            if (!container.classList.contains('hidden')) {
                container.classList.add('hidden');
                return;
            }

            container.classList.remove('hidden');
            container.innerHTML = '<p class="text-xs text-text-secondary">Loading details…</p>';

            const resp = await fetch('?handler=Details&format=' + format + '&repoId=' + encodeURIComponent(repoId));
            const info = await resp.json();

            if (!resp.ok || info.error) {
                container.innerHTML = '<p class="text-xs text-text-secondary"></p>';
                container.querySelector('p').textContent = info.error || 'Failed to load details.';
                return;
            }

            const rows = [
                ['Author', info.author || 'unknown'],
                ['License', info.license || 'unknown'],
                ['Pipeline', info.pipelineTag || 'unknown'],
                ['Library', info.libraryName || 'unknown'],
                ['Last updated', formatDate(info.lastModified)],
                ['Downloads', String(info.downloads ?? 0)],
                ['Likes', String(info.likes ?? 0)],
                [`${extension} files`, `${info.fileCount ?? 0} (${formatBytes(info.totalSizeBytes)})`],
                ['Tags', (info.tags && info.tags.length) ? info.tags.join(', ') : 'none'],
            ];

            container.innerHTML = '';
            const grid = document.createElement('div');
            grid.className = 'grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 border-t border-gray-700/30 pt-2';
            for (const [label, value] of rows) {
                const dt = document.createElement('span');
                dt.className = 'text-text-secondary';
                dt.textContent = label;
                const dd = document.createElement('span');
                dd.className = 'text-text-primary';
                dd.textContent = value;
                grid.appendChild(dt);
                grid.appendChild(dd);
            }
            container.appendChild(grid);
        }

        async function downloadFile(repoId, filename) {
            const result = await postAction({ Command: 'Download', RepoId: repoId, Filename: filename, Revision: 'main' });
            if (result.success) {
                alert('Download started. Track progress on the Models page.');
                window.location.href = '/Features/Models/Index';
            } else {
                alert(result.message || 'Failed to start download.');
            }
        }

        document.getElementById('searchBtn').addEventListener('click', runSearch);
        document.getElementById('searchQuery').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') runSearch();
        });

        // Arrived from the Models list's "+ Version" link for a specific repo — skip the search
        // step and go straight to that repo's file list.
        const prefillRepoId = document.getElementById('page-data')?.dataset.prefillRepoId || '';
        if (prefillRepoId) {
            const resultsEl = document.getElementById('results');
            resultsEl.innerHTML = '';
            const card = buildRepoCard(prefillRepoId, '');
            resultsEl.appendChild(card);
            loadFiles(card.querySelector('.load-files-btn'));
        }
        })();
    </script>
}
