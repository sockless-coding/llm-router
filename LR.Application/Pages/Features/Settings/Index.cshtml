@page
@model LR.Application.Pages.Features.Settings.IndexModel
@{
    ViewData["Title"] = "System Settings";
}

<div class="max-w-3xl mx-auto px-4 py-6">
    <h1 class="text-3xl font-bold mb-6 text-neon-cyan"><span aria-hidden="true">⚙️</span> System Settings</h1>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        var isError = Model.StatusMessage.Contains("failed", StringComparison.OrdinalIgnoreCase);
        <div class="mb-6 rounded-xl p-4 border @(isError ? "border-red-500/30 bg-red-500/10" : "border-neon-green/30 bg-neon-green/10")" role="status">
            <p class="text-sm @(isError ? "text-red-700 dark:text-red-400" : "text-neon-green")">@Model.StatusMessage</p>
        </div>
    }

    <!-- Updates — talks to /Features/Settings/Update (JSON), separate from the settings form below -->
    <form id="update-csrf-form" hidden>@Html.AntiForgeryToken()</form>
    <div id="update-card" class="bg-cyber-card rounded-xl p-6 border border-gray-700/30 mb-6">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-semibold text-neon-green"><span aria-hidden="true">🔄</span> Updates</h2>
            <button type="button" id="update-check-btn"
class="bg-gray-700/50 hover:bg-neon-cyan/20 text-text-secondary hover:text-neon-cyan border border-gray-600 hover:border-neon-cyan/40 px-4 py-1.5 rounded-lg text-sm font-medium transition-colors">
                Check now
            </button>
        </div>

        <dl class="grid grid-cols-2 gap-y-2 text-sm">
            <dt class="text-text-secondary">Installed version</dt>
            <dd id="update-current" class="text-text-primary font-mono">…</dd>
            <dt class="text-text-secondary">Latest release</dt>
            <dd class="text-text-primary font-mono"><span id="update-latest">…</span> <a id="update-latest-link" href="#" target="_blank" rel="noopener" class="hidden text-neon-cyan hover:underline font-sans text-xs ml-1">release notes</a></dd>
        </dl>

        <div id="update-progress" class="hidden mt-4">
            <div class="h-2 rounded-full bg-gray-700/50 overflow-hidden" role="progressbar" aria-label="Update progress" aria-valuemin="0" aria-valuemax="100">
                <div id="update-progress-bar" class="h-full bg-neon-cyan/60 transition-all" style="width: 0%"></div>
            </div>
        </div>
        <p id="update-message" class="text-sm text-text-secondary mt-3 hidden" role="status" aria-live="polite"></p>
        <p id="update-unavailable" class="text-xs text-text-secondary mt-3 hidden"></p>
        <p id="update-last-result" class="text-xs mt-3 hidden"></p>

        <div class="mt-4">
            <button type="button" id="update-install-btn"
class="hidden bg-neon-green/20 hover:bg-neon-green/30 text-neon-green border border-neon-green px-6 py-2.5 rounded-lg font-medium transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                <span aria-hidden="true">⬇️</span> Install <span id="update-install-version"></span> and restart
            </button>
        </div>
    </div>

    <form method="post" hx-boost="false">
        <!-- Request Logging Section -->
        <div class="bg-cyber-card rounded-xl p-6 border border-gray-700/30 mb-6">
            <h2 class="text-lg font-semibold text-neon-cyan mb-4"><span aria-hidden="true">📋</span> Request Logging</h2>

            <!-- Enable/Disable -->
            <div class="flex items-center justify-between py-3 border-b border-gray-700/20">
                <div id="enableLoggingLabel">
                    <p class="text-sm text-text-primary font-medium">Enable Request Logging</p>
                    <p class="text-xs text-text-secondary mt-0.5">Log all API requests passing through the router</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" name="EnableRequestLogging" value="true" checked="@(Model.EnableRequestLogging ? "checked" : null)"
class="sr-only peer" aria-labelledby="enableLoggingLabel"
                               asp-for="EnableRequestLogging" />
                    <!-- Always send false when unchecked -->
                    <input type="hidden" name="EnableRequestLogging" value="false" />
                    <div class="w-11 h-6 bg-gray-700 rounded-full peer-checked:bg-neon-cyan/40 peer-focus:ring-2 peer-focus:ring-neon-cyan/30 transition-colors"></div>
                    <span class="absolute left-0.5 top-0.5 w-5 h-5 bg-white rounded-full shadow-md transform peer-checked:translate-x-5 transition-transform"></span>
                </label>
            </div>

            <!-- Log Full Payloads -->
            <div class="flex items-center justify-between py-3 border-b border-gray-700/20">
                <div id="logFullPayloadsLabel">
                    <p class="text-sm text-text-primary font-medium">Log Full Payloads</p>
                    <p class="text-xs text-text-secondary mt-0.5">Store complete request/response bodies (8KB limit when disabled)</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" name="LogFullPayloads" value="true" checked="@(Model.LogFullPayloads ? "checked" : null)"
class="sr-only peer" aria-labelledby="logFullPayloadsLabel"
                               asp-for="LogFullPayloads" />
                    <input type="hidden" name="LogFullPayloads" value="false" />
                    <div class="w-11 h-6 bg-gray-700 rounded-full peer-checked:bg-neon-cyan/40 peer-focus:ring-2 peer-focus:ring-neon-cyan/30 transition-colors"></div>
                    <span class="absolute left-0.5 top-0.5 w-5 h-5 bg-white rounded-full shadow-md transform peer-checked:translate-x-5 transition-transform"></span>
                </label>
            </div>

            <!-- Retention Days -->
            <div class="flex items-center justify-between py-3">
                <div id="retentionDaysLabel">
                    <p class="text-sm text-text-primary font-medium">Retention Period</p>
                    <p class="text-xs text-text-secondary mt-0.5">How many days to keep request logs (auto-cleaned hourly)</p>
                </div>
                <div class="flex items-center gap-2">
                    <input type="number" name="RequestLogRetentionDays" min="1" max="365" value="@Model.RequestLogRetentionDays"
class="bg-cyber-surface text-text-primary border border-gray-600 rounded-lg px-3 py-2 w-20 text-sm text-center" aria-labelledby="retentionDaysLabel"
                               asp-for="RequestLogRetentionDays" />
                    <span class="text-xs text-text-secondary" aria-hidden="true">days</span>
                </div>
            </div>
        </div>

        <!-- Gateway Section -->
        <div class="bg-cyber-card rounded-xl p-6 border border-gray-700/30 mb-6">
            <h2 class="text-lg font-semibold text-neon-magenta mb-4"><span aria-hidden="true">🌐</span> API Gateway</h2>

            <!-- Require API Key -->
            <div class="flex items-center justify-between py-3 border-b border-gray-700/20">
                <div id="requireApiKeyLabel">
                    <p class="text-sm text-text-primary font-medium">Require API Key</p>
                    <p class="text-xs text-text-secondary mt-0.5">
                        Reject OpenAI/Responses/Claude/Ollama requests without a valid key. Manage keys under
                        <a href="/Features/ApiKeys/Index" class="text-neon-cyan hover:underline">API Keys</a>.
                    </p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" name="RequireApiKey" value="true" checked="@(Model.RequireApiKey ? "checked" : null)"
class="sr-only peer" aria-labelledby="requireApiKeyLabel"
                               asp-for="RequireApiKey" />
                    <!-- Always send false when unchecked -->
                    <input type="hidden" name="RequireApiKey" value="false" />
                    <div class="w-11 h-6 bg-gray-700 rounded-full peer-checked:bg-neon-cyan/40 peer-focus:ring-2 peer-focus:ring-neon-cyan/30 transition-colors"></div>
                    <span class="absolute left-0.5 top-0.5 w-5 h-5 bg-white rounded-full shadow-md transform peer-checked:translate-x-5 transition-transform"></span>
                </label>
            </div>

            <!-- Routing Port -->
            <div class="flex items-center justify-between py-3 border-b border-gray-700/20">
                <div id="routingPortLabel">
                    <p class="text-sm text-text-primary font-medium">Routing API Port</p>
                    <p class="text-xs text-text-secondary mt-0.5">
                        Port for /v1/* and Ollama /api/* endpoints. Admin UI stays on port @Model.AdminPort.
                        Set to 0 to serve routing traffic on the admin port instead (single-port mode).
                        Requires a restart to take effect.
                    </p>
                </div>
                <input type="number" name="RoutingPort" min="0" max="65535" value="@Model.RoutingPort"
class="bg-cyber-surface text-text-primary border border-gray-600 rounded-lg px-3 py-2 w-24 text-sm text-center" aria-labelledby="routingPortLabel"
                           asp-for="RoutingPort" />
            </div>

            <!-- Max Queue Size -->
            <div class="flex items-center justify-between py-3 border-b border-gray-700/20">
                <div id="maxQueueSizeLabel">
                    <p class="text-sm text-text-primary font-medium">Max Queue Size</p>
                    <p class="text-xs text-text-secondary mt-0.5">Maximum requests queued when all servers are busy (-1 = unlimited)</p>
                </div>
                <input type="number" name="MaxQueueSize" min="-1" value="@Model.MaxQueueSize"
class="bg-cyber-surface text-text-primary border border-gray-600 rounded-lg px-3 py-2 w-24 text-sm text-center" aria-labelledby="maxQueueSizeLabel"
                           asp-for="MaxQueueSize" />
            </div>

            <!-- Queue Timeout -->
            <div class="flex items-center justify-between py-3 border-b border-gray-700/20">
                <div id="queueTimeoutLabel">
                    <p class="text-sm text-text-primary font-medium">Queue Timeout</p>
                    <p class="text-xs text-text-secondary mt-0.5">Seconds a request can wait in queue before timing out (-1 = no timeout)</p>
                </div>
                <div class="flex items-center gap-2">
                    <input type="number" name="QueueTimeoutSeconds" min="-1" value="@Model.QueueTimeoutSeconds"
class="bg-cyber-surface text-text-primary border border-gray-600 rounded-lg px-3 py-2 w-24 text-sm text-center" aria-labelledby="queueTimeoutLabel"
                               asp-for="QueueTimeoutSeconds" />
                    <span class="text-xs text-text-secondary" aria-hidden="true">seconds</span>
                </div>
            </div>

            <!-- Default Parallel Slots -->
            <div class="flex items-center justify-between py-3 border-b border-gray-700/20">
                <div id="defaultParallelSlotsLabel">
                    <p class="text-sm text-text-primary font-medium">Default Parallel Slots</p>
                    <p class="text-xs text-text-secondary mt-0.5">Concurrent requests sent to one llama.cpp server when its slot count is unknown and the preset doesn't set Parallel. Mirrors llama.cpp's automatic <code>-np</code>.</p>
                </div>
                <input type="number" name="DefaultParallelSlots" min="1" value="@Model.DefaultParallelSlots"
class="bg-cyber-surface text-text-primary border border-gray-600 rounded-lg px-3 py-2 w-24 text-sm text-center" aria-labelledby="defaultParallelSlotsLabel"
                           asp-for="DefaultParallelSlots" />
            </div>

            <!-- Context-Aware Queuing -->
            <div class="flex items-center justify-between py-3 border-b border-gray-700/20">
                <div id="contextAwareQueuingLabel">
                    <p class="text-sm text-text-primary font-medium">Context-Aware Queuing</p>
                    <p class="text-xs text-text-secondary mt-0.5">Hold a new request in the queue — even with a free slot — while the target llama.cpp server's context (KV cache) is near full and it already has a request in flight, letting that work finish and free context first.</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" name="ContextAwareQueuing" value="true" checked="@(Model.ContextAwareQueuing ? "checked" : null)"
class="sr-only peer" aria-labelledby="contextAwareQueuingLabel"
                               asp-for="ContextAwareQueuing" />
                    <!-- Always send false when unchecked -->
                    <input type="hidden" name="ContextAwareQueuing" value="false" />
                    <div class="w-11 h-6 bg-gray-700 rounded-full peer-checked:bg-neon-cyan/40 peer-focus:ring-2 peer-focus:ring-neon-cyan/30 transition-colors"></div>
                    <span class="absolute left-0.5 top-0.5 w-5 h-5 bg-white rounded-full shadow-md transform peer-checked:translate-x-5 transition-transform"></span>
                </label>
            </div>

            <!-- Context Usage Queue Threshold -->
            <div class="flex items-center justify-between py-3">
                <div id="contextUsageThresholdLabel">
                    <p class="text-sm text-text-primary font-medium">Context Usage Queue Threshold</p>
                    <p class="text-xs text-text-secondary mt-0.5">KV-cache usage percentage at or above which Context-Aware Queuing holds new requests.</p>
                </div>
                <div class="flex items-center gap-2">
                    <input type="number" name="ContextUsageQueueThresholdPercent" min="1" max="100" value="@Model.ContextUsageQueueThresholdPercent"
class="bg-cyber-surface text-text-primary border border-gray-600 rounded-lg px-3 py-2 w-24 text-sm text-center" aria-labelledby="contextUsageThresholdLabel"
                               asp-for="ContextUsageQueueThresholdPercent" />
                    <span class="text-xs text-text-secondary" aria-hidden="true">%</span>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex gap-3">
            <button type="submit" name="action" value="save"
class="bg-neon-cyan/20 hover:bg-neon-cyan/30 text-neon-cyan border border-neon-cyan shadow-neon-cyan px-6 py-2.5 rounded-lg font-medium transition-colors">
                <span aria-hidden="true">💾</span> Save Settings
            </button>

            <button type="submit" name="action" value="cleanup"
class="bg-gray-700/50 hover:bg-red-500/20 text-text-secondary hover:text-red-400 border border-gray-600 hover:border-red-500/30 px-6 py-2.5 rounded-lg font-medium transition-colors">
                <span aria-hidden="true">🧹</span> Run Cleanup Now
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            const card = document.getElementById('update-card');
            if (!card) return;

            const el = (id) => document.getElementById(id);
            const token = () => document.querySelector('#update-csrf-form input[name="__RequestVerificationToken"]')?.value || '';
            const show = (node, visible) => node.classList.toggle('hidden', !visible);
            const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
            // hx-boost re-runs this script on each visit; stop any loop once the card is gone.
            const onPage = () => document.body.contains(card);

            async function post(fields) {
                const formData = new FormData();
                for (const [k, v] of Object.entries(fields)) formData.append(k, v);
                formData.append('__RequestVerificationToken', token());
                const resp = await fetch('/Features/Settings/Update', { method: 'POST', body: formData });
                return resp.json();
            }

            async function getStatus() {
                const resp = await fetch('/Features/Settings/Update', { cache: 'no-store' });
                if (!resp.ok) throw new Error('HTTP ' + resp.status);
                return resp.json();
            }

            function setMessage(text, isError) {
                const msg = el('update-message');
                msg.textContent = text || '';
                msg.className = 'text-sm mt-3 ' + (isError ? 'text-red-700 dark:text-red-400' : 'text-text-secondary');
                show(msg, !!text);
            }

            function render(s) {
                const busy = s.state === 'Checking' || s.state === 'Downloading' || s.state === 'Restarting';
                el('update-current').textContent = s.currentVersion;
                el('update-latest').textContent = s.latestVersion
                    ? s.latestVersion + (s.updateAvailable ? '' : ' (up to date)')
                    : (s.lastCheckedUtc ? 'none found' : '…');
                const link = el('update-latest-link');
                if (s.latestReleaseUrl) link.href = s.latestReleaseUrl;
                show(link, !!s.latestReleaseUrl);

                setMessage(s.message, s.state === 'Failed');
                const progress = s.state === 'Downloading' && s.percent != null;
                show(el('update-progress'), progress);
                if (progress) el('update-progress-bar').style.width = s.percent + '%';

                el('update-install-version').textContent = s.latestVersion || '';
                const installBtn = el('update-install-btn');
                show(installBtn, s.updateAvailable && s.canInstall);
                installBtn.disabled = busy;
                el('update-check-btn').disabled = busy;

                const unavailable = el('update-unavailable');
                unavailable.textContent = s.installUnavailableReason || '';
                show(unavailable, s.updateAvailable && !s.canInstall);

                const last = el('update-last-result');
                if (s.lastResult) {
                    const when = new Date(s.lastResult.completedAtUtc).toLocaleString();
                    last.textContent = 'Last update (' + when + '): ' + s.lastResult.message;
                    last.className = 'text-xs mt-3 ' + (s.lastResult.success ? 'text-text-secondary' : 'text-red-700 dark:text-red-400');
                }
                show(last, !!s.lastResult);
            }

            // Follows a download, then waits out the restart: the router counts as back once it
            // answers with a new version or a newer update result (a failed update restarts the
            // old version).
            async function follow(before) {
                const previousResult = before.lastResult?.completedAtUtc;
                const deadline = Date.now() + 5 * 60 * 1000;
                let restarting = false;
                while (onPage() && Date.now() < deadline) {
                    await sleep(restarting ? 2000 : 1000);
                    let s;
                    try {
                        s = await getStatus();
                    } catch {
                        restarting = true; // router is down mid-restart
                        setMessage('Waiting for the router to come back…');
                        continue;
                    }
                    const finished = s.currentVersion !== before.currentVersion
                        || (s.lastResult && s.lastResult.completedAtUtc !== previousResult);
                    if (restarting && finished) {
                        render(s);
                        if (s.lastResult?.success) {
                            setMessage('Updated to ' + s.currentVersion + '. Reloading…');
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            setMessage(s.lastResult?.message || 'The update failed; the previous version was restarted.', true);
                        }
                        return;
                    }
                    if (s.state === 'Restarting') restarting = true;
                    if (s.state === 'Failed' && !restarting) { render(s); return; }
                    if (!restarting || s.state === 'Restarting') render(s);
                }
                if (onPage()) setMessage('The router has not come back after 5 minutes. Check data\\updates\\update.log in the install folder.', true);
            }

            el('update-check-btn').addEventListener('click', async () => {
                el('update-check-btn').disabled = true;
                try {
                    render((await post({ command: 'check', force: 'true' })).status);
                } catch (e) {
                    setMessage('Update check failed: ' + e.message, true);
                    el('update-check-btn').disabled = false;
                }
            });

            el('update-install-btn').addEventListener('click', async () => {
                const version = el('update-install-version').textContent;
                if (!confirm('Install ' + version + ' and restart the router? Requests in flight are cut off; running model servers keep running.')) return;
                el('update-install-btn').disabled = true;
                try {
                    const before = await getStatus();
                    const result = await post({ command: 'install' });
                    render(result.status);
                    if (!result.success) { setMessage(result.message, true); return; }
                    await follow(before);
                } catch (e) {
                    setMessage('Install failed: ' + e.message, true);
                    el('update-install-btn').disabled = false;
                }
            });

            post({ command: 'check', force: 'false' })
                .then((r) => render(r.status))
                .catch((e) => setMessage('Update check failed: ' + e.message, true));
        })();
    </script>
}
